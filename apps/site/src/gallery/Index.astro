---
// The sample comparison page served at the root of <client>-preview.syncology.tech.
// Injected as a route only in gallery-index builds (see astro.config.mjs), so its
// global styles never reach client pages. Each sample is its own build under /<sample-id>/.
import client from '@client/client.json';
import { homeOf } from '@engine/content';

const metas = import.meta.glob<{ meta: { name: string; label: { en: string; ar: string }; summary: { en: string; ar: string } } }>(
  '@systems/*/meta.ts', { eager: true });
const metaOf = (name: string) => Object.values(metas).find((m) => m.meta.name === name)?.meta;
const enHome = homeOf('en').slug;
const arHome = homeOf('ar').slug;
const href = (id: string, slug: string) => `/${id}/${slug ? slug + '/' : ''}`;

const samples = (client.samples as { id: string; palette: string; type: string; layout: string; motion: string }[]).map((s) => {
  const parts = [s.palette, s.type, s.layout, s.motion];
  const single = new Set(parts).size === 1;
  const m = metaOf(s.layout);
  return {
    ...s,
    labelEn: single ? m?.label.en ?? s.id : `Mix: ${s.id}`,
    labelAr: single ? m?.label.ar ?? s.id : `مزيج: ${s.id}`,
    summaryEn: m?.summary.en ?? '',
    summaryAr: m?.summary.ar ?? '',
    parts: single ? null : s,
  };
});
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{client.name.ar} · اختيار التصميم</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <p class="eyebrow">Syncology · <span lang="en" dir="ltr">Design samples</span></p>
        <h1>{client.name.ar}</h1>
        <p class="sub">اختر التصميم الذي يناسبكم. كل نموذج يعمل بالعربية والإنجليزية.</p>
        <p class="sub" lang="en" dir="ltr">Pick the design you like. Every sample works in Arabic and English.</p>
      </div>
    </header>
    <main class="wrap">
      <ul class="cards" role="list">
        {samples.map((s) => (
          <li class="card">
            <div class="frame" aria-hidden="true">
              <iframe src={href(s.id, arHome)} title="" loading="lazy" tabindex="-1" scrolling="no"></iframe>
            </div>
            <div class="body">
              <h2>{s.labelAr} <span lang="en" dir="ltr">· {s.labelEn}</span></h2>
              {s.summaryAr && <p>{s.summaryAr}</p>}
              {s.parts && (
                <p class="parts" lang="en" dir="ltr">palette {s.parts.palette} · type {s.parts.type} · layout {s.parts.layout} · motion {s.parts.motion}</p>
              )}
              <div class="row">
                <a class="btn" href={href(s.id, arHome)}>عرض بالعربية</a>
                <a class="btn" href={href(s.id, enHome)} lang="en" dir="ltr">View in English</a>
                <button class="btn primary" type="button" disabled title="Approval flow coming soon">اختر هذا التصميم</button>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </main>
    <style is:global>
      :root {
        --bg: #F4F5F3; --surface: #FFFFFF; --ink: #161D1B; --muted: #5E6966; --line: #DADFDC; --accent: #24433C; --accent-ink: #FFFFFF;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #0F1413; --surface: #161D1B; --ink: #E7ECEA; --muted: #9AA6A2; --line: #27312E; --accent: #A9D3C6; --accent-ink: #0F1413; color-scheme: dark; }
      }
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.6 "IBM Plex Sans Arabic", system-ui, sans-serif; }
      .wrap { max-width: 76rem; margin-inline: auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
      .top { padding-block: 48px 32px; }
      .top .wrap { display: flex; flex-direction: column; gap: 8px; }
      .eyebrow { margin: 0; color: var(--muted); font-size: 14px; }
      h1 { margin: 0; font-size: clamp(28px, 4vw, 40px); line-height: 1.2; text-wrap: balance; }
      .sub { margin: 0; color: var(--muted); max-width: 60ch; }
      main { padding-block-end: 64px; }
      .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 20px; }
      .card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
      .frame { position: relative; aspect-ratio: 16 / 10; max-width: 100%; overflow: hidden; border-block-end: 1px solid var(--line); background: var(--bg); }
      .frame iframe { position: absolute; inset-block-start: 0; inset-inline-start: 0; width: 400%; height: 400%; border: 0; transform: scale(0.25); transform-origin: top right; pointer-events: none; }
      .body { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
      h2 { margin: 0; font-size: 20px; }
      h2 span { color: var(--muted); font-weight: 500; }
      .body p { margin: 0; color: var(--muted); font-size: 14px; }
      .parts { font-family: ui-monospace, monospace; font-size: 12px !important; }
      .row { display: flex; flex-wrap: wrap; gap: 8px; padding-block-start: 6px; }
      .btn { display: inline-flex; align-items: center; min-height: 40px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--ink); text-decoration: none; font: inherit; font-size: 14px; font-weight: 500; }
      .btn:hover { border-color: var(--ink); }
      .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
      .btn[disabled] { opacity: 0.55; cursor: not-allowed; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    </style>
  </body>
</html>
