---
// One page of an election client, by its template. Sections come from the design
// system's `electionComponents` (layout/elections/index.ts); any the system does not provide
// fall back to baseline's, so every system renders a complete, working election site.
// Behaviour (countdown, videos, ballot card, supporters, complaints) is the engine's:
// see ./Runtime.astro and ./client.
import Base from '../layouts/Base.astro';
import * as layout from '@layout/index';
import { electionComponents as baselineElections } from '@systems/baseline/layout/elections/index';
import { electionComponents as layoutElections } from '@layout-elections';
import { byId, type Entry } from '@engine/content';
import { buildContext } from '@engine/context';
import Runtime from './Runtime.astro';
import SupportApp from './SupportApp.astro';
import ComplaintForm from './ComplaintForm.astro';
import {
  action, ballotGroups, candidate, candidateGroups, candidateRaw, candidates, clipsForCandidate, clipsForFile,
  backdrop, complaints, countdown, crest, fileRaw, filesPage, home, list, programFiles, shareImage, supporters, teamPage,
  timeLabel, ui, ventures, video, vote, election, shareKit, vision,
} from './data';
import { media } from '@engine/media';
import type { ImageMetadata } from 'astro';

interface Props { entry: Entry }
const { entry } = Astro.props;
const ctx = buildContext(entry);
const E = { ...baselineElections, ...(layoutElections as Partial<typeof baselineElections>) };
const { CTA } = layout.components;
const fm = entry.fm as Record<string, any>;
const Content = entry.Content;
const site = Astro.site ?? new URL('https://example.com');

const teamHref = byId('team', 'ar')?.href ?? '#';
const shareHref = `https://wa.me/?text=${encodeURIComponent(`${vote.shareText} ${new URL(`${teamHref}#vote`, site).href}`)}`;
const ballot = {
  id: 'vote',
  title: vote.title,
  text: vote.text,
  groups: ballotGroups,
  share: { label: vote.share?.label, href: shareHref },
  download: { label: vote.download?.label },
};
const strip = (except?: string) => [{ label: '', candidates: candidates.filter((c) => c.slug !== except) }];
const cardMore = ui.profile ?? '';

let image: ImageMetadata | string | undefined = shareImage() ?? undefined;
let imageAlt: string | undefined;
let fullTitle: string | undefined;
let c: ReturnType<typeof candidate> | null = null;
let cr: any = null;
if (entry.template === 'home') fullTitle = fm.titleTag;
if (entry.template === 'candidate') {
  c = candidate(fm.candidate);
  cr = candidateRaw(fm.candidate);
  if (cr.shareImage) image = media(cr.shareImage);
  imageAlt = `${c.name} — ${c.seat}`;
}
const file = entry.template === 'file' ? fileRaw(fm.file) : null;
const leader = list.leader ? candidate(list.leader) : null;

// ---- Search: breadcrumbs and schema.org data (the election, the list, each candidate) ----
const abs = (href: string) => new URL(href, site).href;
const homeEntry = byId('home', 'ar');
const homeUrl = abs(homeEntry?.href ?? '/');
const orgRef = { '@id': `${homeUrl}#organization` };
const crumb = (id: string) => { const e = byId(id, 'ar'); return e ? { name: e.navLabel ?? e.title, href: e.href } : null; };
const here = { name: entry.title, href: entry.href };
const homeCrumb = { name: list.name ?? ctx.site.name, href: homeEntry?.href ?? '/' };
const breadcrumbs = entry.template === 'home' ? [] : [
  homeCrumb,
  ...(entry.template === 'candidate' ? [crumb('team')] : entry.template === 'file' ? [crumb('files')] : []).filter(Boolean),
  entry.template === 'candidate' && c ? { name: c.name, href: entry.href } : here,
] as { name: string; href: string }[];

// "د. محمد…" → honorificPrefix "د." + name "محمد…", so search engines see the person's name.
const PREFIXES = ['أ.د.', 'أ.د', 'د.', 'م.', 'أ.', 'المستشار', 'المحاسب', 'الكابتن', 'اللواء', 'المهندس', 'الدكتور', 'الأستاذ'];
const person = (cand: ReturnType<typeof candidate>, description?: string) => {
  const prefix = PREFIXES.find((p) => cand.name.startsWith(p + ' '));
  const url = abs(cand.href);
  return {
    '@type': 'Person',
    '@id': `${url}#person`,
    name: prefix ? cand.name.slice(prefix.length + 1) : cand.name,
    ...(prefix ? { honorificPrefix: prefix } : {}),
    jobTitle: cand.seat.replace(/^لمقعد\s+/, ''),
    url,
    image: abs(cand.photo.src),
    ...(description ? { description } : {}),
    memberOf: orgRef,
  };
};
const loc = (election as { location?: { name: string; locality?: string; region?: string; country?: string; street?: string; postalCode?: string; geo?: { lat: number; lon: number } } }).location;
const jsonLd: Record<string, unknown>[] = [];
if (entry.template === 'home') {
  jsonLd.push({ ...orgRef, member: candidates.map((x) => ({ '@id': `${abs(x.href)}#person`, name: x.name })) });
  if (loc && election.at) {
    jsonLd.push({
      '@type': 'Event',
      name: election.title,
      // A date alone (election.date) when the voting hours aren't known; else the exact moment.
      startDate: election.date ?? election.at,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: loc.name,
        address: {
          '@type': 'PostalAddress',
          ...(loc.street ? { streetAddress: loc.street } : {}),
          ...(loc.locality ? { addressLocality: loc.locality } : {}),
          ...(loc.region ? { addressRegion: loc.region } : {}),
          ...(loc.postalCode ? { postalCode: loc.postalCode } : {}),
          ...(loc.country ? { addressCountry: loc.country } : {}),
        },
        ...(loc.geo ? { geo: { '@type': 'GeoCoordinates', latitude: loc.geo.lat, longitude: loc.geo.lon } } : {}),
      },
      organizer: { '@type': 'SportsOrganization', name: loc.name },
      ...(image ? { image: [abs(typeof image === 'string' ? image : image.src)] } : {}),
      description: entry.description,
      url: homeUrl,
    });
  }
}
if (entry.template === 'candidates') {
  jsonLd.push({
    '@type': 'ItemList',
    name: entry.title,
    itemListElement: candidates.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(x.href), name: x.name })),
  });
}
const vf = entry.template === 'candidate' && c ? ventures(c.slug) : null;
if (entry.template === 'candidate' && c) {
  jsonLd.push({ '@type': 'ProfilePage', url: abs(entry.href), name: entry.title, mainEntity: person(c, entry.description) });
  // The companies the candidate founded, each pointing back at them as its founder.
  for (const it of vf?.items ?? []) {
    jsonLd.push({
      '@type': 'Organization',
      name: it.name,
      ...(it.nameLatin ? { alternateName: it.nameLatin } : {}),
      ...(it.url ? { url: it.url } : {}),
      ...(it.text ? { description: it.text } : {}),
      ...(it.logo ? { logo: abs(it.logo.src) } : {}),
      founder: { '@id': `${abs(c.href)}#person` },
    });
  }
}
const ogType = entry.template === 'candidate' ? 'profile' : 'website';
// The support page as a WhatsApp share kit: the message links to the home page, whose own
// share data (title, description, image) is what the chat's preview card will show.
const kit = entry.template === 'support'
  ? shareKit(homeUrl, { image: shareImage(), title: (homeEntry?.fm as Record<string, any>)?.titleTag ?? homeEntry?.title ?? '', description: homeEntry?.description ?? '' })
  : null;
---
<Base ctx={ctx} title={entry.title} description={entry.description} fullTitle={fullTitle} image={image} imageAlt={imageAlt}
  type={ogType} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  {entry.template === 'home' && (
    <>
      <E.ElectionHero ctx={ctx} title={home.hero.title} titleAccent={home.hero.titleAccent} slogan={home.hero.slogan} sub={home.hero.sub}
        actions={home.hero.actions.map((a: { label: string; href: string; icon?: string }) => { const r = action(a); return r ? { ...r, icon: a.icon } : null; }).filter(Boolean)}
        image={home.hero.image ? media(home.hero.image) : null} imageAlt={home.hero.imageAlt} crest={crest} backdrop={backdrop} />
      <E.Countdown ctx={ctx} countdown={countdown} />
      <E.ProgramFiles ctx={ctx} title={home.filesTitle} files={programFiles} layout="strip" />
      {leader && (
        <E.LeaderSpotlight ctx={ctx} kicker={home.leader.kicker} name={leader.name} text={home.leader.text}
          more={{ label: home.leader.more, href: leader.href }} video={video(home.leader.video)} photo={leader.photo} />
      )}
      <E.CandidateGrid ctx={ctx} variant="strip" title={home.team.title} lead={home.team.lead} groups={strip()}
        more={{ label: home.team.all, href: teamHref }} cardMore={cardMore} numberLabel={ui.number} />
      {home.interviews.items.length > 0 && <E.InterviewStrip ctx={ctx} title={home.interviews.title} lead={home.interviews.lead}
        items={home.interviews.items.map((it: any) => {
          const who = candidate(it.candidate);
          return it.placeholder
            ? { name: who.name, seat: who.seat, href: who.href, poster: media(it.poster), cta: ui.profileShort ?? ui.watch, soon: typeof it.placeholder === 'string' ? it.placeholder : (ui.soon ?? 'قريبًا') }
            : { name: who.name, seat: who.seat, href: `${who.href}#interview`, poster: media(it.poster), cta: ui.watch };
        })} />}
      <E.BallotCard ctx={ctx} {...ballot} support={action(vote.support)} />
      <CTA ctx={ctx} title={home.cta.title} text={home.cta.text} action={action(home.cta.action)} />
    </>
  )}

  {entry.template === 'candidates' && (
    <>
      <E.PageBand ctx={ctx} title={teamPage.title} lead={teamPage.lead} crest={crest} backdrop={backdrop} />
      <E.CandidateGrid ctx={ctx} variant="groups" groups={candidateGroups()} cardMore={cardMore} numberLabel={ui.number} />
      <E.BallotCard ctx={ctx} {...ballot} support={null} />
    </>
  )}

  {entry.template === 'candidate' && c && cr && (
    <>
      <E.CandidateHero ctx={ctx} candidate={c} kicker={action(cr.kicker)} numberLabel={`${ui.number} ${c.number}`} backdrop={backdrop} />
      {cr.word && <E.MediaFrame ctx={ctx} video={video(cr.word)!} label={cr.word.title ?? cr.word.label} />}
      <E.Panel ctx={ctx}><Content /></E.Panel>
      {vf && <E.Ventures ctx={ctx} ventures={vf} />}
      {cr.interview && (
        <E.InterviewPlayer ctx={ctx} id="interview" title={cr.interview.title} video={video(cr.interview)!}
          summary={cr.interview.summary}
          chapters={cr.interview.chapters.map((ch: any) => ({ t: ch.t, time: timeLabel(ch.t), label: ch.label, aria: `شاهد: ${ch.label} (عند ${timeLabel(ch.t)})` }))} />
      )}
      {cr.gallery?.length > 0 && <E.PhotoRow ctx={ctx} photos={cr.gallery.map((g: string) => media(g))} alt={c.name} label={cr.galleryLabel} hint={ui.galleryHint} />}
      {clipsForCandidate(c.slug).length > 0 && <E.ClipGrid ctx={ctx} title={cr.filesTitle} groups={clipsForCandidate(c.slug)} />}
      <E.CandidateGrid ctx={ctx} variant="strip" title={cr.restTitle} groups={strip(c.slug)} cardMore={cardMore} numberLabel={ui.number} />
    </>
  )}

  {entry.template === 'files' && (
    <>
      <E.PageBand ctx={ctx} title={filesPage.title} lead={filesPage.lead} crest={crest} backdrop={backdrop} />
      <E.ProgramFiles ctx={ctx} hint={filesPage.hint} files={programFiles} />
    </>
  )}

  {entry.template === 'file' && file && (
    <>
      <E.PageBand ctx={ctx} kicker={action(file.kicker)} title={file.title} lead={file.tagline} action={action(file.action)} crest={crest} backdrop={backdrop} />
      {file.plan?.groups?.length
        ? <E.FilePlan ctx={ctx} plan={file.plan} words={filesPage.planWords} />
        : <E.Panel ctx={ctx}><Content /></E.Panel>}
      {clipsForFile(file.slug).length > 0 && <E.ClipGrid ctx={ctx} id="videos" title={file.clipsTitle} groups={[{ clips: clipsForFile(file.slug) }]} />}
      <E.ProgramFiles ctx={ctx} title={file.othersTitle} files={programFiles.filter((f) => f.slug !== file.slug)} layout="strip" />
    </>
  )}

  {entry.template === 'vision' && vision && (
    <>
      <E.PageBand ctx={ctx} title={vision.title ?? entry.title} lead={vision.lead} crest={crest} backdrop={backdrop} />
      <E.Vision ctx={ctx} vision={vision}
        share={vision.board?.share ? { label: vision.board.share.label, href: `https://wa.me/?text=${encodeURIComponent(String(vision.board.share.text).replaceAll('{url}', abs(entry.href)))}` } : null}
        more={action(vision.board?.more)}
        team={vision.board?.team ? { image: media(vision.board.team.image), alt: vision.board.team.alt ?? '' } : null} />
    </>
  )}

  {entry.template === 'support' && (
    <>
      <E.PageBand ctx={ctx} title={supporters.title ?? entry.title} lead={kit ? supporters.share.lead : undefined} crest={crest} backdrop={backdrop} />
      {kit ? <E.ShareKit ctx={ctx} kit={kit} /> : <E.Panel ctx={ctx}><SupportApp /></E.Panel>}
    </>
  )}

  {entry.template === 'complaints' && (
    <>
      <E.PageBand ctx={ctx} title={complaints.title ?? entry.title} lead={complaints.lead} crest={crest} backdrop={backdrop} />
      <E.Panel ctx={ctx}><ComplaintForm /></E.Panel>
    </>
  )}

  <Runtime />
</Base>
