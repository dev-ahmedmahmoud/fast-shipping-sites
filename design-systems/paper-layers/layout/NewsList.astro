---
// News as a row of cards, each with a folded corner and a coloured sheet peeking
// out underneath that slides further out when the card is hovered.
import type { PageContext } from '@engine/context';
interface NewsItem { title: string; href: string; date?: string; excerpt?: string }
interface Props { ctx: PageContext; title?: string; items: NewsItem[]; more?: { label: string; href: string } | null; headingLevel?: 1 | 2 }
const { ctx, title, items, more, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const CARDS = ['sun', 'mint', 'coral', 'blue'];
---
<section class="section">
  <div class="container stack">
    <div class="head">
      {title && <Heading class:list={['title', { big: headingLevel === 1 }]} data-split-words={headingLevel === 1 ? '' : undefined} data-reveal={headingLevel === 1 ? undefined : ''}>{title}</Heading>}
      {more && items.length > 0 && (
        <a class="btn btn--ghost more" href={more.href}>
          {more.label}
          <svg class="flip-rtl" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M12 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      )}
    </div>
    {items.length === 0 ? (
      <p class="empty">{ctx.ui.noNews}</p>
    ) : (
      <ul class="list" role="list">
        {items.map((n, i) => (
          <li data-reveal style={`--card: var(--pl-${CARDS[i % CARDS.length]})`}>
            <a class="note" href={n.href}>
              {n.date && <time class="date">{n.date}</time>}
              <h3>{n.title}</h3>
              {n.excerpt && <p>{n.excerpt}</p>}
              <span class="read" aria-hidden="true">
                <svg class="flip-rtl" viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h13M12 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: var(--space-6); }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .title { font-size: var(--step-3); }
  .title.big { font-size: var(--step-5); }
  .more { min-block-size: 44px; font-size: var(--step--1); }
  .empty { color: var(--c-muted); padding: var(--space-5); border-radius: var(--radius-m); background: var(--c-sunk); box-shadow: var(--pl-cut); }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--space-6) var(--space-5); padding-block: var(--space-2) var(--space-4); }
  .list > li { display: flex; }

  .note {
    --dog: 26px;
    position: relative; isolation: isolate; flex: 1; display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-5) var(--space-5) var(--space-7);
    color: var(--c-ink); text-decoration: none;
  }
  /* top face with a folded corner, cut with a clip-path so the fold shows through */
  .note::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: var(--radius-m);
    background: var(--c-surface);
    clip-path: polygon(0 0, calc(100% - var(--dog)) 0, 100% var(--dog), 100% 100%, 0 100%);
    filter: drop-shadow(0 2px 3px color-mix(in oklab, var(--c-ink) 14%, transparent));
  }
  /* the coloured sheet underneath */
  .note::after {
    content: ''; position: absolute; inset: 0; z-index: -2; border-radius: var(--radius-m);
    background: var(--card); box-shadow: var(--pl-s1);
    translate: 8px 9px; rotate: 1.4deg;
    transition: translate var(--dur-base) var(--ease-out), rotate var(--dur-base) var(--ease-out);
  }
  :global([dir="rtl"]) .note::before { clip-path: polygon(0 var(--dog), var(--dog) 0, 100% 0, 100% 100%, 0 100%); }
  :global([dir="rtl"]) .note::after { translate: -8px 9px; rotate: -1.4deg; }
  .note:hover::after { translate: 14px 16px; rotate: 3deg; }
  :global([dir="rtl"]) .note:hover::after { translate: -14px 16px; rotate: -3deg; }
  .note { transition: transform var(--dur-base) var(--ease-out); }
  .note:hover { transform: translateY(-4px); }

  .date {
    align-self: flex-start; font-size: var(--step--1); font-weight: var(--weight-strong); font-variant-numeric: tabular-nums;
    padding: 2px var(--space-3); border-radius: var(--radius-s);
    background: color-mix(in oklab, var(--card) 30%, var(--c-surface)); color: var(--c-ink);
  }
  h3 { font-size: var(--step-1); line-height: 1.35; }
  p { color: var(--c-muted); font-size: var(--step--1); }
  .read {
    position: absolute; inset-inline-end: var(--space-4); inset-block-end: var(--space-4);
    display: grid; place-items: center; inline-size: 34px; block-size: 34px; border-radius: 50%;
    color: var(--c-accent); background: var(--c-accent-soft);
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .note:hover .read { background: var(--c-accent); color: var(--c-accent-ink); }
  /* the folded corner itself, drawn on the list item so it rides along on hover */
  .list > li { position: relative; }
  .list > li::before {
    content: ''; position: absolute; z-index: 1; inset-block-start: 0; inset-inline-end: 0; inline-size: 26px; block-size: 26px;
    border-end-start-radius: 6px; pointer-events: none;
    background: linear-gradient(to bottom left, transparent 50%, color-mix(in oklab, var(--c-ink) 12%, var(--c-surface)) 50%);
    box-shadow: -2px 2px 3px color-mix(in oklab, var(--c-ink) 14%, transparent);
  }
  :global([dir="rtl"]) .list > li::before {
    background: linear-gradient(to bottom right, transparent 50%, color-mix(in oklab, var(--c-ink) 12%, var(--c-surface)) 50%);
    box-shadow: 2px 2px 3px color-mix(in oklab, var(--c-ink) 14%, transparent);
  }
  .list > li:hover::before { transform: translateY(-4px); }
  .list > li::before { transition: transform var(--dur-base) var(--ease-out); }
</style>
