---
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const links = [...ctx.nav.filter((n) => !n.external), ...ctx.footerNav];
const external = ctx.nav.filter((n) => n.external);
---
<footer class="footer">
  <div class="hills" aria-hidden="true">
    <svg class="h1" viewBox="0 0 1440 90" preserveAspectRatio="none" focusable="false"><path d="M0 90 V44 C 180 6 360 8 540 34 S 900 78 1080 40 S 1340 10 1440 30 V90 Z" /></svg>
    <svg class="h2" viewBox="0 0 1440 90" preserveAspectRatio="none" focusable="false"><path d="M0 90 V62 C 240 28 480 34 700 56 S 1160 86 1440 52 V90 Z" /></svg>
  </div>
  <div class="body">
    <div class="container grid">
      <div class="col brand">
        <span class="tab">
          {ctx.site.logo
            ? <Image src={ctx.site.logo} alt="" height={96} class="logo" />
            : <span aria-hidden="true">{ctx.site.shortName}</span>}
        </span>
        <p class="name">{ctx.site.name}</p>
        {ctx.site.motto && <p class="motto">{ctx.site.motto}</p>}
      </div>

      <nav class="col" aria-label={ctx.ui.links}>
        <h2 class="label">{ctx.ui.links}</h2>
        <ul role="list" class="links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {external.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> {ctx.ui.newTab}</span></a></li>)}
        </ul>
      </nav>

      <div class="col">
        <h2 class="label">{ctx.ui.contact}</h2>
        <ul role="list">
          {ctx.contact.address && <li>{ctx.contact.address}</li>}
          {ctx.contact.phones.map((p) => (
            <li>{p.label && <>{p.label}: </>}<a href={`tel:${p.number.replace(/\s+/g, '')}`} dir="ltr">{p.number}</a></li>
          ))}
          {ctx.contact.emails.map((e) => <li>{e.label}: <a href={`mailto:${e.address}`} dir="ltr">{e.address}</a></li>)}
          {ctx.contact.hours && <li>{ctx.contact.hours}</li>}
          {ctx.contact.mapUrl && <li><a href={ctx.contact.mapUrl} target="_blank" rel="noopener">{ctx.ui.map}</a></li>}
        </ul>
      </div>

      {ctx.social.length > 0 && (
        <div class="col">
          <h2 class="label">{ctx.ui.follow}</h2>
          <ul role="list" class="social">
            {ctx.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" lang="en">{s.label}</a></li>)}
          </ul>
        </div>
      )}
    </div>
    <div class="container legal">
      <p>{ctx.legal.copyright ?? `© ${ctx.year} ${ctx.site.name}. ${ctx.ui.rights}.`}</p>
      {ctx.legal.credit && (
        <p>{ctx.legal.credit.href ? <a href={ctx.legal.credit.href} target="_blank" rel="noopener">{ctx.legal.credit.text}</a> : ctx.legal.credit.text}</p>
      )}
    </div>
  </div>
</footer>

<style>
  .footer { --foot: color-mix(in oklab, var(--c-ink) 92%, var(--c-accent)); margin-block-start: var(--space-7); color: var(--c-bg); font-size: var(--step--1); }
  .hills { position: relative; block-size: 72px; margin-block-end: -1px; }
  .hills svg { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
  .h1 { fill: var(--c-accent); filter: drop-shadow(0 -3px 6px color-mix(in oklab, var(--c-ink) 16%, transparent)); }
  .h2 { fill: var(--foot); filter: drop-shadow(0 -4px 8px color-mix(in oklab, var(--c-ink) 22%, transparent)); }
  :global([dir="rtl"]) .hills svg { scale: -1 1; }
  .body { background: var(--foot); padding-block: var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px)); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--space-6); }
  @media (min-width: 1000px) { .grid { grid-template-columns: 1.1fr 1.5fr 1.4fr 1fr; } }
  .col { display: flex; flex-direction: column; gap: var(--space-3); min-inline-size: 0; }
  .col ul { display: flex; flex-direction: column; gap: var(--space-2); }
  .col li { overflow-wrap: anywhere; }
  .col a { color: var(--c-bg); text-decoration: none; }
  .col a:hover { color: var(--pl-sun); text-decoration: underline; }
  .label { color: var(--pl-sun); font-family: var(--font-display); font-size: var(--step--1); }
  .tab {
    align-self: flex-start; display: grid; place-items: center; padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-m); background: var(--c-surface); box-shadow: var(--pl-s2); rotate: -2deg;
    font-family: var(--font-display); font-weight: var(--weight-display); color: var(--c-ink);
  }
  .logo { block-size: 52px; inline-size: auto; max-inline-size: 180px; object-fit: contain; }
  .name { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); line-height: var(--lh-heading); }
  .motto { color: color-mix(in oklab, var(--c-bg) 78%, var(--foot)); }
  .col .links { display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: var(--space-2) var(--space-4); }
  .col .social { flex-direction: row; flex-wrap: wrap; }
  .social a {
    display: inline-flex; align-items: center; min-block-size: 40px; padding-inline: var(--space-4);
    border-radius: var(--radius-m); background: color-mix(in oklab, var(--c-bg) 10%, var(--foot));
    box-shadow: var(--pl-s1);
  }
  .social a:hover { background: var(--pl-sun); color: var(--c-ink); text-decoration: none; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3);
    margin-block-start: var(--space-6); padding-block-start: var(--space-4);
    border-block-start: 1px solid color-mix(in oklab, var(--c-bg) 22%, var(--foot));
    color: color-mix(in oklab, var(--c-bg) 78%, var(--foot));
  }
  .legal a { color: var(--pl-sun); }
  .footer :focus-visible { outline-color: var(--pl-sun); }
</style>
