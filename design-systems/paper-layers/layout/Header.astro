---
import { Image } from 'astro:assets';
import type { PageContext, NavItem } from '@engine/context';
interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const other = ctx.languages.find((l) => !l.current);
const linkAttrs = (item: NavItem) => ({
  href: item.href,
  'aria-current': item.current ? 'page' : undefined,
  target: item.external ? '_blank' : undefined,
  rel: item.external ? 'noopener' : undefined,
});
---
<header class="header">
  <div class="container bar">
    <a class="brand" href={ctx.site.homeHref} aria-label={ctx.site.name}>
      {ctx.site.logo
        ? <Image src={ctx.site.logo} alt="" height={96} class="logo" loading="eager" />
        : <span class="mark" aria-hidden="true">{ctx.site.shortName}</span>}
      <span class="name">{ctx.site.name}</span>
    </a>

    <div class="actions">
      {other && (
        <a class="lang" href={other.href} hreflang={other.locale} lang={other.locale}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
          {other.name}
        </a>
      )}
      {ctx.cta && (
        <a class="btn btn--primary cta" href={ctx.cta.href}
           target={ctx.cta.external ? '_blank' : undefined} rel={ctx.cta.external ? 'noopener' : undefined}>
          {ctx.cta.label}
        </a>
      )}
      <details class="nav-mobile">
        <summary class="btn btn--ghost">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
          {ctx.ui.menu}
        </summary>
        <nav aria-label={ctx.ui.menu}>
          <ul role="list">
            {ctx.nav.map((item) => (
              <li>
                <a {...linkAttrs(item)}>{item.label}</a>
                {item.children.length > 0 && (
                  <ul role="list" class="sub-mobile">
                    {item.children.map((c) => <li><a {...linkAttrs(c)}>{c.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <nav class="nav-desktop" aria-label={ctx.ui.menu}>
    <ul role="list" class="container">
      {ctx.nav.map((item) => (
        <li class:list={[{ 'has-sub': item.children.length > 0 }]}>
          <a {...linkAttrs(item)}>
            {item.label}
            {item.children.length > 0 && <svg class="caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>}
          </a>
          {item.children.length > 0 && (
            <ul role="list" class="sub">
              {item.children.map((c) => <li><a {...linkAttrs(c)}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <span class="edge" aria-hidden="true"></span>
</header>

<style>
  .header {
    position: sticky; inset-block-start: 0; z-index: 20;
    background: var(--c-surface);
    padding-block-start: env(safe-area-inset-top, 0px);
    box-shadow: var(--pl-s1);
  }
  /* A second sheet peeks out under the header strip. */
  .edge {
    position: absolute; inset-inline: 0; inset-block-start: 100%; block-size: 5px; z-index: -1;
    background: linear-gradient(90deg, var(--pl-blue) 0 40%, var(--pl-sun) 40% 62%, var(--pl-mint) 62% 82%, var(--pl-coral) 82%);
    box-shadow: var(--pl-s1);
  }

  .bar { display: flex; align-items: center; gap: var(--space-4); min-block-size: 76px; }
  .brand { display: flex; align-items: center; gap: var(--space-3); color: var(--c-ink); text-decoration: none; min-inline-size: 0; }
  .logo { block-size: 48px; inline-size: auto; max-inline-size: 190px; object-fit: contain; }
  .mark {
    display: grid; place-items: center; min-inline-size: 48px; block-size: 48px; padding-inline: var(--space-2);
    border-radius: var(--radius-m); background: var(--c-accent); color: var(--c-accent-ink);
    font-family: var(--font-display); font-weight: var(--weight-display);
  }
  .name { font-family: var(--font-display); font-weight: 600; font-size: var(--step-0); line-height: 1.2; max-inline-size: 24ch; }

  .actions { display: flex; align-items: center; gap: var(--space-3); margin-inline-start: auto; }
  .lang {
    display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 44px; padding-inline: var(--space-3);
    border-radius: var(--radius-m); color: var(--c-ink); text-decoration: none; font-weight: var(--weight-strong); font-size: var(--step--1);
    transition: background-color var(--dur-fast) ease;
  }
  .lang:hover { background: var(--c-sunk); }
  .cta { min-block-size: 44px; font-size: var(--step--1); }

  .nav-desktop { border-block-start: 1px solid var(--c-line); }
  .nav-desktop > ul { display: flex; flex-wrap: wrap; gap: 0 var(--space-1); padding-block: var(--space-1); }
  .nav-desktop a, .nav-mobile a {
    position: relative; display: flex; align-items: center; gap: 6px;
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-s);
    color: var(--c-ink); text-decoration: none; font-size: var(--step--1); font-weight: 500; white-space: nowrap;
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .nav-desktop a:hover, .nav-mobile a:hover { background: var(--c-sunk); }
  /* the current page gets a small card tab under its label */
  .nav-desktop > ul > li > a[aria-current="page"], .nav-desktop > ul > li > a:has(+ .sub a[aria-current="page"]) { color: var(--c-accent); font-weight: var(--weight-strong); }
  .nav-desktop > ul > li > a[aria-current="page"]::after {
    content: ''; position: absolute; inset-inline: var(--space-3); inset-block-end: 2px; block-size: 3px; border-radius: 3px;
    background: var(--c-accent);
  }
  .caret { flex: none; transition: transform var(--dur-fast) var(--ease-out); }
  .has-sub { position: relative; }
  .has-sub:hover .caret { transform: rotate(180deg); }
  .sub {
    display: none; position: absolute; inset-inline-start: 0; inset-block-start: 100%; z-index: 5;
    min-inline-size: 15rem; padding: var(--space-2);
    background: var(--c-surface); border-radius: var(--radius-m); box-shadow: var(--pl-s3);
    transform-origin: 50% 0;
  }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { display: grid; gap: 2px; animation: pl-popup var(--dur-base) var(--ease-out) both; }
  .sub a[aria-current="page"], .nav-mobile a[aria-current="page"] { background: var(--c-accent-soft); color: var(--c-ink); font-weight: var(--weight-strong); }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary { list-style: none; min-block-size: 44px; padding-inline: var(--space-4); font-size: var(--step--1); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile nav {
    position: absolute; inset-inline-end: 0; inset-block-start: calc(100% + var(--space-3));
    inline-size: min(20rem, calc(100vw - 2 * var(--gutter))); max-block-size: 75vh; overflow-y: auto; padding: var(--space-2);
    background: var(--c-surface); border-radius: var(--radius-l); box-shadow: var(--pl-s3);
    transform-origin: 100% 0;
  }
  .nav-mobile[open] nav { animation: pl-popup var(--dur-base) var(--ease-out) both; }
  .nav-mobile nav > ul { display: grid; gap: 2px; }
  .nav-mobile a { white-space: normal; }
  .sub-mobile { padding-inline-start: var(--space-4); border-inline-start: 2px solid var(--c-line); margin-inline-start: var(--space-3); }

  @media (max-width: 1080px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }
  @media (max-width: 640px) {
    .name { display: none; }
    .cta { display: none; }
    .bar { min-block-size: 66px; }
    .logo { block-size: 40px; max-inline-size: 150px; }
  }
</style>
