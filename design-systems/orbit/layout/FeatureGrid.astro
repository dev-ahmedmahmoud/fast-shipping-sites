---
// Feature links as a row of planets on one orbit line. When the row scrolls into
// view the planets swing in from a wide arc and settle in line (data-reveal="align",
// see Motion.astro); at rest, and without the motion part, they simply sit in line.
// Sizes, tones and rings take turns by position and carry no meaning.
import type { PageContext } from '@engine/context';
interface Item { title: string; text?: string; href?: string; external?: boolean }
interface Props { ctx: PageContext; title?: string; items: Item[] }
const { title, items } = Astro.props;
const tones = ['accent', 'star', 'soft', 'night'];
const sizes = [1, 0.82, 1.12, 0.9];
const mid = (items.length - 1) / 2;
---
<section class="section features">
  <div class="container stack">
    {title && <h2 class="orbit-title" data-reveal>{title}</h2>}
    <div class="belt">
      <span class="orbit-line" aria-hidden="true"></span>
      <ul class="row" role="list" data-reveal="align">
        {items.map((item, i) => {
          const Tag = item.href ? 'a' : 'div';
          return (
            <li style={`--k:${i};--off:${(i - mid).toFixed(2)};--s:${sizes[i % sizes.length]}`}>
              <Tag class="card" href={item.href}
                   target={item.href && item.external ? '_blank' : undefined} rel={item.href && item.external ? 'noopener' : undefined}>
                <span class:list={['planet', `planet--${tones[i % tones.length]}`, { ringed: i % 3 === 1 }]} aria-hidden="true">
                  <span class="bands"></span>
                  <span class="moonlet"></span>
                </span>
                <h3>{item.title}</h3>
                {item.text && <p>{item.text}</p>}
                {item.href && (
                  <span class="go" aria-hidden="true">
                    <svg class="flip-rtl" viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                )}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: var(--space-6); }
  .belt { position: relative; }
  /* The shared orbit the planets sit on: a long, flat ellipse behind them. */
  .orbit-line {
    position: absolute; inset-inline: -6%; inset-block-start: calc(var(--space-5) + 3.2rem); block-size: 7rem;
    border-radius: 50%; border-block-start: 1.5px dashed color-mix(in oklab, var(--c-accent) 40%, transparent);
    pointer-events: none;
  }
  .row {
    position: relative;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-6) var(--space-5); align-items: start;
  }
  .row > li { display: flex; justify-content: center; min-inline-size: 0; }
  .card {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-3);
    inline-size: 100%; max-inline-size: 16rem; padding: var(--space-3) var(--space-3) var(--space-5);
    text-align: center; color: var(--c-ink); text-decoration: none; border-radius: var(--radius-l);
    transition: background-color var(--dur-base) linear, transform var(--dur-base) var(--ease-out);
  }
  a.card:hover { background: color-mix(in oklab, var(--c-surface) 75%, transparent); transform: translateY(-4px); }

  /* ---- Planets ---- */
  .planet {
    --d: calc(6.4rem * var(--s));
    --tone: var(--c-accent); --tone-hi: color-mix(in oklab, var(--c-accent) 35%, var(--c-surface)); --tone-lo: color-mix(in oklab, var(--c-accent) 60%, var(--c-ink));
    position: relative; inline-size: var(--d); block-size: var(--d); margin-block: calc((7.2rem - var(--d)) / 2);
    border-radius: 50%; overflow: visible;
    background: radial-gradient(circle at 32% 28%, var(--tone-hi), var(--tone) 52%, var(--tone-lo));
    box-shadow: 0 22px 40px -22px color-mix(in oklab, var(--tone) 80%, transparent);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .planet--star { --tone: var(--c-highlight); --tone-hi: var(--c-surface); --tone-lo: color-mix(in oklab, var(--c-highlight) 60%, var(--c-ink)); }
  .planet--soft { --tone: var(--c-accent-soft); --tone-hi: var(--c-surface); --tone-lo: color-mix(in oklab, var(--c-accent) 45%, var(--c-accent-soft)); }
  .planet--night { --tone: var(--c-ink); --tone-hi: color-mix(in oklab, var(--c-accent) 55%, var(--c-ink)); --tone-lo: var(--c-ink); }
  /* Soft cloud bands that drift across the surface on hover. */
  .bands {
    position: absolute; inset: 0; border-radius: 50%; overflow: hidden; opacity: 0.55;
    background: repeating-linear-gradient(calc(var(--dir) * -14deg), transparent 0 14%, color-mix(in oklab, var(--c-surface) 32%, transparent) 14% 19%, transparent 19% 31%);
    background-size: 220% 100%; background-position: 0 0;
    transition: background-position 1.8s var(--ease-out);
    mix-blend-mode: soft-light;
  }
  .ringed::before {
    content: ""; position: absolute; inset: 36% -30%; border-radius: 50%; z-index: 1;
    border: 2.5px solid color-mix(in oklab, var(--c-accent) 50%, transparent);
    border-block-start-color: transparent;
    rotate: calc(var(--dir) * -16deg);
  }
  .moonlet {
    position: absolute; inset-block-start: 6%; inset-inline-end: -8%; inline-size: 16%; block-size: 16%;
    border-radius: 50%; background: var(--c-surface); box-shadow: 0 0 0 1px var(--c-line);
    transform-origin: calc(50% - var(--dir) * 300%) 300%;
    transition: rotate 1.4s var(--ease-out);
  }
  a.card:hover .planet { transform: translateY(-6px) scale(1.04); }
  a.card:hover .bands { background-position: 100% 0; }
  a.card:hover .moonlet { rotate: calc(var(--dir) * 140deg); }

  h3 { font-size: var(--step-1); }
  p { color: var(--c-muted); font-size: var(--step--1); max-inline-size: 26ch; }
  .go {
    display: grid; place-items: center; inline-size: 38px; block-size: 38px; border-radius: 50%;
    border: 1.5px solid var(--c-line); color: var(--c-accent);
    transition: background-color var(--dur-fast) linear, color var(--dur-fast) linear, border-color var(--dur-fast) linear;
  }
  .go svg { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  a.card:hover .go { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-accent-ink); }

  @media (max-width: 560px) {
    .row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-3); }
    .planet { --d: calc(5rem * var(--s)); margin-block: calc((5.6rem - var(--d)) / 2); }
    .orbit-line { display: none; }
  }
</style>
