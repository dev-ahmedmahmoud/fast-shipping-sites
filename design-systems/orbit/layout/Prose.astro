---
// Every inner page. The page title flies over a band of night sky with slowly
// turning orbits; the band ends in the curved horizon of a planet, and the page
// itself rises over it as a light card, as if zooming down from orbit. Blocks
// that share a page (the home intro, news items: headingLevel 2) are lighter:
// a title with its planet marker and the text in a card.
import type { PageContext } from '@engine/context';
interface Props {
  ctx: PageContext;
  title: string;
  lead?: string;
  todo?: string[];
  /** 1 for a page's own title (default); 2 when several Prose blocks share a page, e.g. news items. */
  headingLevel?: 1 | 2;
  /** Anchor id, so other pages can link to this block. */
  id?: string;
}
const { ctx, title, lead, todo = [], headingLevel = 1, id } = Astro.props;
---
{headingLevel === 1 ? (
  <article class="page" id={id}>
    <header class="band" data-loop>
      <span class="orbits" aria-hidden="true">
        <span class="o o1"><span class="moon"></span></span>
        <span class="o o2"><span class="moon moon--star"></span></span>
        <span class="world"></span>
      </span>
      <div class="container band-copy">
        {lead && <p class="label">{lead}</p>}
        <h1 data-split-words>{title}</h1>
      </div>
      <span class="horizon" aria-hidden="true"></span>
    </header>
    <div class="container body">
      {todo.length > 0 && (
        <aside class="todo-note">
          <strong>{ctx.ui.pending}</strong>
          <ul lang="en" dir="ltr">{todo.map((t) => <li>{t}</li>)}</ul>
        </aside>
      )}
      <div class="sheet" data-reveal>
        <div class="prose"><slot /></div>
      </div>
    </div>
  </article>
) : (
  <article class="section item" id={id}>
    <div class="container body body--item">
      <header class="item-head" data-reveal>
        {lead && <p class="label">{lead}</p>}
        <h2 class="orbit-title">{title}</h2>
      </header>
      {todo.length > 0 && (
        <aside class="todo-note">
          <strong>{ctx.ui.pending}</strong>
          <ul lang="en" dir="ltr">{todo.map((t) => <li>{t}</li>)}</ul>
        </aside>
      )}
      <div class="sheet" data-reveal>
        <div class="prose"><slot /></div>
      </div>
    </div>
  </article>
)}

<style>
  /* ---- Page band: night sky, orbits, planet horizon ---- */
  .band {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: var(--space-8) calc(var(--space-9) + var(--space-6));
    background-color: var(--night-bg); background-image: var(--stars); background-size: var(--stars-size);
    color: var(--night-ink);
  }
  .band-copy { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .band-copy .label { color: var(--c-highlight); }
  h1 { font-size: var(--step-5); max-inline-size: 20ch; }
  .orbits { position: absolute; z-index: -1; inset-block-start: 50%; inset-inline-end: 12%; inline-size: 0; block-size: 0; }
  .o, .world { position: absolute; inset-block-start: 0; inset-inline-start: 0; border-radius: 50%; translate: calc(var(--dir) * -50%) -50%; }
  .o { border: 1px solid color-mix(in oklab, var(--night-ink) 16%, transparent); }
  .o1 { inline-size: 18rem; block-size: 18rem; }
  .o2 { inline-size: 30rem; block-size: 30rem; border-style: dashed; }
  .world {
    inline-size: 7rem; block-size: 7rem;
    background: radial-gradient(circle at 34% 30%, color-mix(in oklab, var(--c-accent) 30%, var(--c-surface)), var(--c-accent) 58%, color-mix(in oklab, var(--c-accent) 45%, var(--night-bg)));
    box-shadow: 0 0 60px color-mix(in oklab, var(--c-accent) 60%, transparent);
  }
  .moon {
    position: absolute; inset-block-start: 14.6%; inset-inline-start: 14.6%; inline-size: 14px; block-size: 14px; margin: -7px;
    border-radius: 50%; background: var(--night-ink);
  }
  .moon--star { inline-size: 10px; block-size: 10px; margin: -5px; background: var(--c-highlight); box-shadow: 0 0 14px var(--c-highlight); }
  /* The curved edge of the planet the page lands on. */
  .horizon {
    position: absolute; inset-inline: -25%; inset-block-end: -1px; block-size: calc(var(--space-9) + var(--space-4));
    background: var(--c-bg); border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    box-shadow: 0 -10px 40px color-mix(in oklab, var(--c-accent) 40%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .o1 { animation: turn 22s linear infinite; }
    .o2 { animation: turn 40s linear infinite reverse; }
    [data-paused] .o1, [data-paused] .o2 { animation-play-state: paused; }
  }
  @keyframes turn { to { rotate: 360deg; } }

  /* ---- Body ---- */
  .body { position: relative; display: flex; flex-direction: column; gap: var(--space-5); max-inline-size: calc(54rem + 2 * var(--gutter)); }
  .page .body { margin-block-start: calc(-1 * (var(--space-9) + var(--space-4))); padding-block-end: var(--space-8); }
  .body--item { gap: var(--space-4); }
  .item { scroll-margin-block-start: 150px; }
  .item-head { display: flex; flex-direction: column; gap: var(--space-2); }
  .item-head .label { color: var(--c-muted); font-variant-numeric: tabular-nums; }
  .item h2 { font-size: var(--step-3); }

  .sheet {
    position: relative; min-inline-size: 0;
    padding: clamp(var(--space-5), 5vw, var(--space-7));
    background: var(--c-surface); border-radius: var(--radius-l);
    border: 1px solid color-mix(in oklab, var(--c-line) 70%, transparent);
    box-shadow: 0 40px 80px -48px color-mix(in oklab, var(--c-ink) 50%, transparent);
  }
  .sheet:has(.prose:empty) { display: none; }
  .prose { max-inline-size: 70ch; min-inline-size: 0; }
  .prose :global(> * + *) { margin-block-start: var(--space-4); }
  .prose :global(> :first-child) { margin-block-start: 0; }

  /* Headings: each section of the text starts with a small planet on its orbit. */
  .prose :global(h2) {
    display: flex; align-items: center; gap: var(--space-3);
    margin-block-start: var(--space-7); font-size: var(--step-2); color: var(--c-ink);
  }
  .prose :global(h2::before) {
    content: ""; flex: none; inline-size: 0.55em; block-size: 0.55em; border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, color-mix(in oklab, var(--c-accent) 35%, var(--c-surface)), var(--c-accent) 62%);
    box-shadow: 0 0 0 0.14em var(--c-surface), 0 0 0 0.22em color-mix(in oklab, var(--c-accent) 35%, transparent);
  }
  .prose :global(> h2:first-child) { margin-block-start: 0; }
  .prose :global(h3) { font-size: var(--step-1); margin-block-start: var(--space-6); color: var(--c-accent); }
  .prose :global(h4) { font-size: var(--step-0); margin-block-start: var(--space-5); }
  .prose :global(ul), .prose :global(ol) { padding-inline-start: var(--space-5); }
  .prose :global(li + li) { margin-block-start: var(--space-2); }
  .prose :global(li::marker) { color: var(--c-accent); }
  .prose :global(hr) { border: 0; border-block-start: 1px dashed var(--c-line); }
  .prose :global(img) { border-radius: var(--radius-m); background: var(--c-sunk); }
  .prose :global(video) { inline-size: 100%; border-radius: var(--radius-m); background: var(--c-ink); }
  .prose :global(.embed) { inline-size: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--radius-m); background: var(--c-sunk); }
  .prose :global(.embed--map) { aspect-ratio: 4 / 3; }
  .prose :global(blockquote) {
    margin-inline: 0; padding: var(--space-4) var(--space-5);
    background: var(--c-accent-soft); border-radius: var(--radius-m); color: var(--c-ink);
  }

  /* Tables scroll inside themselves when wider than the card. */
  .prose :global(table) {
    display: block; inline-size: max-content; max-inline-size: 100%; overflow-x: auto;
    border-collapse: separate; border-spacing: 0; border: 1px solid var(--c-line); border-radius: var(--radius-m);
  }
  .prose :global(th), .prose :global(td) { padding: var(--space-2) var(--space-4); text-align: start; border-block-end: 1px solid var(--c-line); }
  .prose :global(th) { background: var(--c-ink); color: var(--c-bg); font-family: var(--font-display); font-weight: 600; }
  .prose :global(tr:last-child td) { border-block-end: 0; }
  .prose :global(tr:nth-child(even) td) { background: var(--c-bg); }

  .prose :global(.actions) { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* Downloads: a list of transmissions, each with a document glyph. */
  .prose :global(.downloads) { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .prose :global(.downloads li) {
    position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4); padding-inline-start: calc(var(--space-4) + 1.9rem);
    background: var(--c-bg); border: 1px solid var(--c-line); border-radius: var(--radius-m);
    transition: border-color var(--dur-fast) linear, transform var(--dur-base) var(--ease-out);
  }
  .prose :global(.downloads li + li) { margin-block-start: 0; }
  .prose :global(.downloads li::before) {
    content: ""; position: absolute; inset-inline-start: var(--space-4); inset-block-start: 50%; inline-size: 1.15rem; block-size: 1.4rem; margin-block-start: -0.7rem;
    border-radius: 3px 8px 3px 3px; border: 1.5px solid var(--c-accent);
    background: linear-gradient(var(--c-accent), var(--c-accent)) 50% 42% / 55% 1.5px no-repeat, linear-gradient(var(--c-accent), var(--c-accent)) 50% 64% / 55% 1.5px no-repeat;
  }
  .prose :global(.downloads li:hover) { border-color: var(--c-accent); transform: translateX(calc(var(--dir) * 3px)); }
  .prose :global(.downloads a) { font-weight: var(--weight-strong); overflow-wrap: anywhere; }

  /* Galleries: rounded frames that lift on hover. */
  .prose :global(.gallery) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr)); gap: var(--space-3); }
  .prose :global(.gallery > *) { margin: 0; }
  .prose :global(.gallery img) {
    inline-size: 100%; block-size: auto; aspect-ratio: 4 / 3; object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .prose :global(.gallery img:hover) { transform: translateY(-4px) scale(1.02); box-shadow: 0 20px 36px -22px color-mix(in oklab, var(--c-ink) 60%, transparent); }

  /* Student photos: crew badges, round photo inside an orbit ring. */
  .prose :global(.students) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr)); gap: var(--space-5) var(--space-4); }
  .prose :global(.students figure) { margin: 0; display: flex; flex-direction: column; align-items: center; gap: var(--space-2); text-align: center; }
  .prose :global(.students img) {
    inline-size: 100%; max-inline-size: 7.5rem; aspect-ratio: 1; object-fit: cover; border-radius: 50%;
    box-shadow: 0 0 0 4px var(--c-surface), 0 0 0 5px color-mix(in oklab, var(--c-accent) 40%, transparent);
  }
  .prose :global(.students figcaption) { font-size: var(--step--1); font-weight: var(--weight-strong); line-height: 1.35; }
  .prose :global(.students + h2), .prose :global(h2 + .students) { margin-block-start: var(--space-5); }

  .prose :global(.note) {
    position: relative; padding: var(--space-4) var(--space-5); padding-inline-start: calc(var(--space-5) + 1.6rem);
    background: var(--c-accent-soft); border-radius: var(--radius-m);
  }
  .prose :global(.note::before) {
    content: ""; position: absolute; inset-inline-start: var(--space-4); inset-block-start: calc(var(--space-4) + 0.3em);
    inline-size: 0.9rem; block-size: 0.9rem; border-radius: 50%;
    background: var(--c-highlight); box-shadow: 0 0 0 0.25rem color-mix(in oklab, var(--c-highlight) 30%, transparent);
  }

  /* Old-site forms, shown as they were; sending is not wired up yet. */
  .prose :global(.form) {
    display: grid; gap: var(--space-3); padding: var(--space-5);
    background: var(--c-bg); border: 1px solid var(--c-line); border-radius: var(--radius-l);
  }
  .prose :global(.form label) { font-weight: var(--weight-strong); }
  .prose :global(.form input), .prose :global(.form select), .prose :global(.form textarea) {
    inline-size: 100%; min-block-size: 46px; padding: var(--space-2) var(--space-3);
    border: 1px solid var(--c-line); border-radius: var(--radius-s); background: var(--c-surface);
  }
  .prose :global(.form input:focus-visible), .prose :global(.form select:focus-visible), .prose :global(.form textarea:focus-visible) { border-color: var(--c-accent); }
  .prose :global(.form textarea) { min-block-size: 6rem; resize: vertical; }
  .prose :global(.form button[disabled]) { opacity: 0.6; cursor: not-allowed; justify-self: start; }

  @media (max-width: 720px) {
    .orbits { inset-inline-end: -4rem; inset-block-start: 30%; }
    .band { padding-block: var(--space-7) calc(var(--space-9) + var(--space-5)); }
    .prose :global(.students) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
