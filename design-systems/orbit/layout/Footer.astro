---
// Deep space. The footer continues the night sky; when the page above it ends on
// a day section, it opens with its own horizon. A wide, faint orbit arcs across it.
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext }
const { ctx } = Astro.props;
// A page can be both in the menu and in the footer list; show it once.
const links = [...ctx.nav.filter((n) => !n.external), ...ctx.footerNav]
  .filter((l, i, all) => all.findIndex((o) => o.href === l.href) === i);
// Portals may sit inside a menu group; list the portals themselves, not the group.
const external = ctx.nav.flatMap((n) => (n.children.length ? n.children : [n])).filter((n) => n.external);
---
<footer class="footer">
  <span class="arc" aria-hidden="true"><span class="sat"></span></span>
  <div class="container grid">
    <div class="col brand">
      <p class="name">{ctx.site.name}</p>
      {ctx.site.motto && <p class="motto">{ctx.site.motto}</p>}
    </div>

    <nav class="col" aria-label={ctx.ui.links}>
      <h2 class="label">{ctx.ui.links}</h2>
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        {external.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> {ctx.ui.newTab}</span></a></li>)}
      </ul>
    </nav>

    <div class="col">
      <h2 class="label">{ctx.ui.contact}</h2>
      <ul role="list">
        {ctx.contact.address && <li>{ctx.contact.address}</li>}
        {ctx.contact.phones.map((p) => (
          <li>{p.label && <>{p.label}: </>}<a href={`tel:${p.number.replace(/\s+/g, '')}`} dir="ltr">{p.number}</a></li>
        ))}
        {ctx.contact.emails.map((e) => <li>{e.label}: <a href={`mailto:${e.address}`} dir="ltr">{e.address}</a></li>)}
        {ctx.contact.hours && <li>{ctx.contact.hours}</li>}
        {ctx.contact.mapUrl && <li><a href={ctx.contact.mapUrl} target="_blank" rel="noopener">{ctx.ui.map}</a></li>}
      </ul>
    </div>

    {ctx.social.length > 0 && (
      <div class="col">
        <h2 class="label">{ctx.ui.follow}</h2>
        <ul role="list" class="social">
          {ctx.social.map((s) => <li><a class="chip" href={s.href} target="_blank" rel="noopener" lang="en">{s.label}</a></li>)}
        </ul>
      </div>
    )}
  </div>
  <div class="container legal">
    <p>{ctx.legal.copyright ?? `© ${ctx.year} ${ctx.site.name}. ${ctx.ui.rights}.`}</p>
    {ctx.legal.credit && (
      <p>{ctx.legal.credit.href ? <a href={ctx.legal.credit.href} target="_blank" rel="noopener">{ctx.legal.credit.text}</a> : ctx.legal.credit.text}</p>
    )}
  </div>
</footer>

<style>
  .footer {
    position: relative; overflow: hidden; isolation: isolate;
    background-color: var(--night-bg); background-image: var(--stars); background-size: var(--stars-size);
    color: var(--night-ink);
    padding-block: var(--space-8) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    font-size: var(--step--1);
  }
  /* After a day section the footer brings its own horizon. */
  :global(main:not(:has(> .night:last-child))) + .footer {
    padding-block-start: calc(var(--horizon) + var(--space-5));
    background-image: var(--stars), linear-gradient(to bottom, var(--c-bg), var(--night-bg) var(--horizon));
    background-size: var(--stars-size), 100% 100%;
  }
  .arc {
    position: absolute; z-index: -1; inset-block-start: 18%; inset-inline-end: -30%;
    inline-size: 90%; aspect-ratio: 1; border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--night-ink) 12%, transparent);
  }
  .arc .sat {
    position: absolute; inset-block-start: 14.6%; inset-inline-start: 14.6%; inline-size: 10px; block-size: 10px; margin: -5px;
    border-radius: 50%; background: var(--c-highlight); box-shadow: 0 0 14px var(--c-highlight);
  }
  .footer :focus-visible { outline-color: var(--c-highlight); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--space-6); }
  .col { display: flex; flex-direction: column; gap: var(--space-3); min-inline-size: 0; }
  .col ul { display: flex; flex-direction: column; gap: var(--space-2); }
  .col li { overflow-wrap: anywhere; color: var(--night-muted); }
  .col a { color: var(--night-ink); text-decoration: none; }
  .col a:hover { color: var(--c-highlight); text-decoration: underline; }
  /* Links that sit inside a line of text need more than color to stand out. */
  .col li > a[dir="ltr"] { text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--night-ink) 40%, transparent); }
  .label { color: var(--c-highlight); }
  .name { font-family: var(--font-display); font-weight: 700; font-size: var(--step-2); line-height: 1.25; }
  .motto { color: var(--night-muted); font-size: var(--step-0); }
  .social { flex-direction: row !important; flex-wrap: wrap; }
  .chip {
    display: inline-flex; align-items: center; min-block-size: 40px; padding-inline: var(--space-4);
    border: 1px solid var(--night-line); border-radius: var(--radius-pill);
    transition: background-color var(--dur-fast) linear, border-color var(--dur-fast) linear, color var(--dur-fast) linear;
  }
  .col .chip:hover { background: var(--c-highlight); color: var(--c-ink); border-color: var(--c-highlight); text-decoration: none; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3);
    margin-block-start: var(--space-7); padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--night-line); color: var(--night-muted);
  }
  .legal a { color: inherit; }
  @media (max-width: 720px) { .arc { inline-size: 160%; inset-inline-end: -90%; inset-block-start: 40%; } }
</style>
