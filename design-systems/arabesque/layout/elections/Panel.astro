---
// A reading column for page bodies (a bio, a program file's text) and for the engine's
// widgets (supporters' app, complaints form; their look is in ./elections.css).
// Body HTML arrives in the slot.
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext; id?: string; label?: string }
const { id, label } = Astro.props;
---
<section class="section" id={id} aria-label={label}>
  <div class="container narrow">
    <div class="prose"><slot /></div>
  </div>
</section>

<style>
  .narrow { max-inline-size: calc(46rem + 2 * var(--gutter)); }
  .prose { min-inline-size: 0; font-size: var(--step-0); }
  .prose :global(> * + *) { margin-block-start: var(--space-4); }
  .prose :global(> p:first-child) { font-size: var(--step-1); line-height: 1.8; }
  .prose :global(h2) {
    font-size: var(--step-3); color: var(--c-accent); margin-block-start: var(--space-7);
    padding-block-end: var(--space-2); border-block-end: 1px solid color-mix(in oklab, var(--ar-gold) 60%, transparent);
  }
  .prose :global(h2:first-child) { margin-block-start: 0; }
  .prose :global(h3) { font-size: var(--step-2); color: var(--c-accent); margin-block-start: var(--space-6); }
  .prose :global(ul), .prose :global(ol) { padding-inline-start: var(--space-6); }
  .prose :global(ul) { list-style: none; }
  .prose :global(ul > li) { position: relative; }
  .prose :global(ul > li)::before {
    content: ''; position: absolute; inset-inline-start: calc(-1 * var(--space-5)); inset-block-start: 0.72em;
    inline-size: 0.55em; block-size: 0.55em; background: var(--ar-gold); rotate: 45deg;
  }
  .prose :global(ol) { list-style: arabic-indic; }
  .prose :global(:lang(en) ol), .prose :global(ol:lang(en)) { list-style: decimal; }
  .prose :global(ol > li::marker) { color: var(--c-accent); font-weight: 700; }
  .prose :global(li + li) { margin-block-start: var(--space-3); }
  .prose :global(li > ul) { margin-block-start: var(--space-3); }
  .prose :global(strong) { color: var(--c-accent); }
  .prose :global(blockquote) {
    margin-inline: 0; padding: var(--space-5) var(--space-5); border-inline-start: 3px solid var(--ar-gold);
    background: var(--c-surface); font-family: var(--font-display); font-size: var(--step-2); line-height: 1.7; color: var(--c-ink);
  }
  .prose :global(img) { border-radius: var(--radius-s); }
</style>
