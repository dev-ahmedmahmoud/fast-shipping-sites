---
// The list's home hero on a deep emerald band: crest, the list's name, its slogan in Ruqaa,
// the election, three actions, and the team standing in a wide gold gateway. Two carved
// mashrabiya screens cover the gateway and part as the page opens (motion only); behind the
// team, warm light falls through a lattice.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
import Doors from '../Doors.astro';
import Rule from '../Rule.astro';
interface Props {
  ctx: PageContext;
  title: string;
  slogan: string;
  sub: string;
  actions: Action[];
  image: ImageMetadata | null;
  imageAlt: string;
  crest: ImageMetadata | null;
}
const { title, slogan, sub, actions, image, imageAlt, crest } = Astro.props;
---
<section class="hero ar-band ar-girih">
  <div class="glow" aria-hidden="true" data-ar-loop></div>
  <div class="container copy">
    {crest && <Image class="crest" src={crest} alt="" height={112} loading="eager" />}
    <p class="sub">{sub}</p>
    <h1 data-split-words>{title}</h1>
    <p class="slogan" data-reveal>{slogan}</p>
    <Rule class="rule" />
    <div class="actions" data-reveal>
      {actions.map((a, i) => (
        <a class:list={['btn', i === 0 ? 'btn--gold' : 'btn--line']} href={a.href}>{a.label}</a>
      ))}
    </div>
  </div>

  {image && (
    <div class="container stage">
      <div class="gate" data-ar-screen>
        <div class="gate__in">
          <div class="screen" aria-hidden="true"></div>
          <div class="sun" aria-hidden="true" data-ar-loop></div>
          <Image class="team" src={image} alt={imageAlt} widths={[640, 960, 1397]} sizes="(max-width: 900px) calc(100vw - 3rem), 64rem" loading="eager" />
          <Doors />
        </div>
      </div>
    </div>
  )}
  <div class="ar-lattice-strip edge" aria-hidden="true"></div>
</section>

<style>
  .hero { position: relative; overflow: clip; padding-block-start: var(--space-7); }
  /* Sized in rem, not in percent of the hero, so it stays put when the hero's height settles. */
  .glow {
    position: absolute; inset-inline: 10%; inset-block-start: -14rem; block-size: 44rem; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--ar-gold) 28%, transparent), transparent);
  }
  :global(.ar-rich) .glow { animation: ar-breathe 9s ease-in-out infinite alternate; }
  @keyframes ar-breathe { from { opacity: 0.55; transform: scale(0.96); } to { opacity: 1; transform: scale(1.04); } }

  .copy { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center; }
  .copy :global(.crest) { block-size: clamp(84px, 11vw, 112px); inline-size: auto; filter: drop-shadow(0 8px 18px rgb(0 0 0 / 0.35)); }
  .sub {
    display: inline-flex; padding: var(--space-1) var(--space-4); border-block: 1px solid color-mix(in oklab, var(--ar-gold) 70%, transparent);
    color: var(--ar-gold); font-weight: 600; font-size: var(--step-0);
  }
  h1 { font-size: var(--step-5); line-height: 1.35; }
  .slogan { font-family: var(--font-callig); font-size: var(--step-3); line-height: 1.6; color: var(--ar-gold); }
  .copy :global(.rule) { inline-size: min(100%, 20rem); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-block-start: var(--space-3); }

  .stage { margin-block-start: var(--space-7); }
  /* The gateway: a wide pointed arch with a gold rim, the team standing in it. */
  .gate {
    position: relative; margin-inline: auto; inline-size: min(100%, 64rem); aspect-ratio: 16 / 9;
    padding: 10px 10px 0;
    background: linear-gradient(170deg, var(--ar-gold), color-mix(in oklab, var(--ar-gold) 50%, var(--c-ink)));
    -webkit-mask: var(--ar-arch) no-repeat center / 100% 100%; mask: var(--ar-arch) no-repeat center / 100% 100%;
  }
  .gate__in {
    position: relative; block-size: 100%; overflow: hidden;
    -webkit-mask: var(--ar-arch) no-repeat center / 100% 100%; mask: var(--ar-arch) no-repeat center / 100% 100%;
    background: radial-gradient(70% 70% at 50% 62%, color-mix(in oklab, var(--ar-gold) 38%, var(--ar-deep)), var(--ar-deeper) 75%);
  }
  /* Light through a lattice behind the team. */
  .screen {
    position: absolute; inset: 0; background: color-mix(in oklab, var(--ar-gold) 45%, transparent); opacity: 0.32;
    -webkit-mask: var(--ar-lattice) repeat center / 46px 46px; mask: var(--ar-lattice) repeat center / 46px 46px;
  }
  .sun {
    position: absolute; inset-inline: 20%; inset-block: 18% 10%; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--ar-gold) 55%, transparent), transparent);
  }
  :global(.ar-rich) .sun { animation: ar-breathe 7s ease-in-out infinite alternate; }
  .gate__in :global(.team) {
    position: absolute; inset-inline: 0; inset-block-end: 0; margin-inline: auto;
    inline-size: 94%; block-size: auto; max-block-size: 92%; object-fit: contain; object-position: bottom;
    filter: drop-shadow(0 12px 22px rgb(0 0 0 / 0.35));
  }
  .edge { margin-block-start: 0; }

  @media (max-width: 700px) {
    .gate { aspect-ratio: 4 / 3; }
    .gate__in :global(.team) { inline-size: 100%; }
  }
</style>
