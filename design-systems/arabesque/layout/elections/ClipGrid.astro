---
// Short clips in gold frames: on a program file's page every speaker on that file (with a
// profile link); on a candidate's page the candidate's clips grouped by program file (the
// group title links to the file).
import type { PageContext } from '@engine/context';
import type { Clip } from '@elections/data';
import Video from '@elections/Video.astro';
import SectionTitle from '../SectionTitle.astro';
interface Props {
  ctx: PageContext;
  id?: string;
  title?: string;
  groups: { title?: string; href?: string; clips: Clip[] }[];
}
const { id, title, groups } = Astro.props;
---
<section class="section clips" id={id}>
  <div class="container wrap">
    {title && <SectionTitle title={title} />}
    {groups.map((g) => (
      <div class="group">
        {g.title && (
          <h3 class="file">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><polygon fill="currentColor" points="12 1 13.9 7.4 19.8 4.2 16.6 10.1 23 12 16.6 13.9 19.8 19.8 13.9 16.6 12 23 10.1 16.6 4.2 19.8 7.4 13.9 1 12 7.4 10.1 4.2 4.2 10.1 7.4" /></svg>
            {g.href ? <a href={g.href}>{g.title}</a> : g.title}
          </h3>
        )}
        <div class="grid">
          {g.clips.map((clip) => (
            <figure data-reveal>
              <Video video={clip.video} sizes="(max-width: 700px) 100vw, 33vw" widths={[384, 768, 1024]} />
              <figcaption>
                {clip.name && <strong>{clip.name}</strong>}
                <span>{clip.title}</span>
                {clip.profile && <a href={clip.profile.href} aria-label={`${clip.profile.label}: ${clip.name}`}>{clip.profile.label}</a>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .clips { scroll-margin-block-start: 100px; }
  .wrap { display: flex; flex-direction: column; gap: var(--space-6); }
  .group { display: flex; flex-direction: column; gap: var(--space-4); }
  .file { display: flex; align-items: center; gap: var(--space-2); font-size: var(--step-2); color: var(--c-accent); }
  .file svg { color: var(--ar-gold); flex: none; }
  .file a { color: inherit; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: var(--space-6) var(--space-5); }
  figure { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); padding: 7px; }
  figcaption { display: flex; flex-direction: column; gap: var(--space-1); padding-inline: var(--space-1); }
  strong { font-family: var(--font-display); font-size: var(--step-1); color: var(--c-accent); }
  figcaption a { color: var(--c-accent); font-weight: 600; font-size: var(--step--1); display: inline-flex; min-block-size: 40px; align-items: center; }
</style>
