---
// A reading page: Amiri title over a gold rule, a comfortable column (about 62 characters),
// and quiet styles for everything imported pages carry.
import type { PageContext } from '@engine/context';
import Rule from './Rule.astro';
interface Props {
  ctx: PageContext;
  title: string;
  lead?: string;
  todo?: string[];
  headingLevel?: 1 | 2;
  id?: string;
}
const { ctx, title, lead, todo = [], headingLevel = 1, id } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---
<article class:list={['section', { item: headingLevel === 2 }]} id={id}>
  <div class="container narrow">
    <header class="head">
      <Heading data-split-words>{title}</Heading>
      <Rule class="rule" />
      {lead && <p class="lead">{lead}</p>}
    </header>
    {todo.length > 0 && (
      <aside class="todo-note">
        <strong>{ctx.ui.pending}</strong>
        <ul lang="en" dir="ltr">{todo.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}
    <div class="prose">
      <slot />
    </div>
  </div>
</article>

<style>
  .narrow { max-inline-size: calc(48rem + 2 * var(--gutter)); display: flex; flex-direction: column; gap: var(--space-5); }
  .head { display: flex; flex-direction: column; gap: var(--space-3); padding-block-start: var(--space-4); }
  h1 { font-size: var(--step-4); color: var(--c-accent); }
  .item h2 { font-size: var(--step-2); color: var(--c-accent); }
  .head :global(.rule) { justify-content: flex-start; inline-size: 12rem; }
  .item { scroll-margin-block-start: 140px; border-block-start: 1px solid var(--c-line); }
  .lead { font-size: var(--step-1); color: var(--c-muted); }
  .item .lead { font-size: var(--step--1); }
  .prose { max-inline-size: 62ch; min-inline-size: 0; }
  .prose :global(> * + *) { margin-block-start: var(--space-4); }
  .prose :global(h2) { font-size: var(--step-2); color: var(--c-accent); margin-block-start: var(--space-7); }
  .prose :global(h3) { font-size: var(--step-1); margin-block-start: var(--space-6); }
  .prose :global(h4) { font-size: var(--step-0); margin-block-start: var(--space-5); }
  .prose :global(ul), .prose :global(ol) { padding-inline-start: var(--space-5); }
  .prose :global(ul) { list-style: none; }
  .prose :global(ul > li) { position: relative; }
  .prose :global(ul > li)::before {
    content: ''; position: absolute; inset-inline-start: calc(-1 * var(--space-4)); inset-block-start: 0.75em;
    inline-size: 0.5em; block-size: 0.5em; background: var(--ar-gold); rotate: 45deg;
  }
  .prose :global(.downloads > li)::before, .prose :global(.students li)::before, .prose :global(.gallery li)::before { display: none; }
  .prose :global(li + li) { margin-block-start: var(--space-2); }
  .prose :global(img) { border-radius: var(--radius-s); }
  .prose :global(video) { inline-size: 100%; border-radius: var(--radius-s); background: var(--c-sunk); }
  .prose :global(.embed) { inline-size: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--radius-s); background: var(--c-sunk); }
  .prose :global(.embed--map) { aspect-ratio: 4 / 3; }
  .prose :global(blockquote) {
    margin-inline: 0; padding: var(--space-4) var(--space-5); border-inline-start: 3px solid var(--ar-gold);
    background: var(--c-surface); font-family: var(--font-display); font-size: var(--step-1); color: var(--c-ink);
  }
  .prose :global(table) { border-collapse: collapse; inline-size: 100%; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--c-line); padding: var(--space-2) var(--space-3); text-align: start; }
  .prose :global(th) { background: var(--c-sunk); }
  .prose :global(.actions) { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .prose :global(.downloads) { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .prose :global(.downloads li) {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4); border: 1px solid var(--c-line); border-inline-start: 3px solid var(--ar-gold);
    border-radius: var(--radius-s); background: var(--c-surface);
  }
  .prose :global(.downloads li + li) { margin-block-start: 0; }
  .prose :global(.gallery) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr)); gap: var(--space-3); padding: 0; }
  .prose :global(.gallery img) { inline-size: 100%; block-size: auto; }
  .prose :global(.students) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr)); gap: var(--space-4); padding: 0; }
  .prose :global(.students figure) { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); text-align: center; }
  .prose :global(.students img) { inline-size: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 3px solid var(--c-surface); outline: 1px solid var(--ar-gold); }
  .prose :global(.students figcaption) { font-size: var(--step--1); }
  .prose :global(.note) { padding: var(--space-3) var(--space-4); border-radius: var(--radius-s); background: var(--c-accent-soft); border-inline-start: 3px solid var(--c-accent); }

  .prose :global(.form) { display: grid; gap: var(--space-3); padding: var(--space-5); border: 1px solid var(--c-line); border-block-start: 3px solid var(--ar-gold); border-radius: var(--radius-s); background: var(--c-surface); }
  .prose :global(.form input), .prose :global(.form select), .prose :global(.form textarea) {
    inline-size: 100%; min-block-size: 52px; padding: var(--space-2) var(--space-3); font: inherit;
    border: 1.5px solid var(--c-line); border-radius: var(--radius-s); background: var(--c-bg);
  }
  .prose :global(.form textarea) { min-block-size: 7rem; resize: vertical; }
  .prose :global(.form button[disabled]) { opacity: 0.6; cursor: not-allowed; justify-self: start; }
</style>
