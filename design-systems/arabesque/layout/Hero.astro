---
// The home hero on an emerald band: title and lead beside a pointed arch window. The first
// photo (or silent clip, through HeroMedia) sits in the arch behind carved screens that
// part as the page opens; two more photos sit in smaller arches.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action, HeroVideo } from '@engine/content';
import HeroMedia from '@engine/HeroMedia.astro';
import Doors from './Doors.astro';
import Rule from './Rule.astro';
interface Props { ctx: PageContext; eyebrow?: string; title: string; lead?: string; actions: Action[]; images?: ImageMetadata[]; video?: HeroVideo | null }
const { eyebrow, title, lead, actions, images = [], video } = Astro.props;
const [first, ...rest] = images;
const side = rest.slice(0, 2);
---
<section class:list={['hero ar-band ar-girih', { 'no-media': !first }]}>
  <div class="light" aria-hidden="true" data-ar-loop></div>
  <div class="container grid">
    <div class="copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 data-split-words>{title}</h1>
      <Rule class="rule" />
      {lead && <p class="lead" data-reveal>{lead}</p>}
      {actions.length > 0 && (
        <div class="actions" data-reveal>
          {actions.map((a, i) => (
            <a class:list={['btn', i === 0 ? 'btn--gold' : 'btn--line']} href={a.href}
               target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener' : undefined}>{a.label}</a>
          ))}
        </div>
      )}
    </div>

    {first && (
      <div class="media">
        <div class="arch-frame" data-ar-screen>
          <div class="arch ar-arch">
            <HeroMedia image={first} video={video} widths={[480, 760, 1100]} sizes="(max-width: 900px) 86vw, 34vw" fetchpriority="high" />
            <Doors />
          </div>
        </div>
        {side.length > 0 && (
          <div class="side">
            {side.map((img) => (
              <div class="mini ar-arch" data-reveal>
                <Image src={img} alt="" widths={[240, 400]} sizes="(max-width: 900px) 30vw, 12vw" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
  <div class="ar-lattice-strip edge" aria-hidden="true"></div>
</section>

<style>
  .hero { position: relative; overflow: clip; padding-block: var(--space-8) 0; }
  /* Light falling through a screen: a slow drifting lattice shadow (motion runs it). Sized in
     rem so it stays put while the hero's height settles. */
  .light {
    position: absolute; inset-inline: -10%; inset-block-start: -10rem; block-size: 60rem; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--ar-gold) 30%, transparent), transparent);
    opacity: 0.35;
  }
  :global(.ar-rich) .light { animation: ar-drift 26s ease-in-out infinite alternate; }
  @keyframes ar-drift { from { transform: translate3d(-6%, -2%, 0); } to { transform: translate3d(8%, 4%, 0); } }
  .grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-7); align-items: center; padding-block-end: var(--space-8); }
  .no-media .grid { grid-template-columns: minmax(0, 1fr); }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); min-inline-size: 0; }
  .eyebrow { color: var(--ar-gold); font-weight: 600; font-size: var(--step-0); }
  h1 { font-size: var(--step-5); line-height: 1.35; max-inline-size: 16ch; }
  .copy :global(.rule) { inline-size: min(100%, 14rem); justify-content: flex-start; }
  .lead { font-size: var(--step-1); line-height: 1.75; max-inline-size: 40ch; color: color-mix(in oklab, var(--ar-on-deep) 92%, transparent); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); padding-block-start: var(--space-2); }

  .media { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-4); align-items: end; min-inline-size: 0; }
  .arch-frame {
    position: relative; padding: 10px; background: linear-gradient(160deg, var(--ar-gold), color-mix(in oklab, var(--ar-gold) 55%, var(--c-ink)));
    -webkit-mask: var(--ar-arch) no-repeat center / 100% 100%; mask: var(--ar-arch) no-repeat center / 100% 100%;
    aspect-ratio: 4 / 5; inline-size: 100%;
  }
  .arch { position: relative; block-size: 100%; background: var(--ar-deeper); overflow: hidden; }
  .arch :global(.fss-hero-media), .arch :global(img), .arch :global(video) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .side { display: flex; flex-direction: column; gap: var(--space-4); inline-size: clamp(5.5rem, 11vw, 9rem); }
  .mini { aspect-ratio: 3 / 4; padding: 4px; background: var(--ar-gold); }
  .mini :global(img) {
    inline-size: 100%; block-size: 100%; object-fit: cover; display: block;
    -webkit-mask: var(--ar-arch) no-repeat center / 100% 100%; mask: var(--ar-arch) no-repeat center / 100% 100%;
  }
  .edge { transform: scaleY(-1); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .media { max-inline-size: 30rem; inline-size: 100%; justify-self: center; }
    h1 { max-inline-size: none; }
  }
</style>
