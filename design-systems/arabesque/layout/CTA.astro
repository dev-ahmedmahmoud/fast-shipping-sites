---
// An invitation set in an emerald panel with a pointed-arch window of gold tracery.
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
import Rule from './Rule.astro';
interface Props { ctx: PageContext; title: string; text?: string; action: Action | null }
const { title, text, action } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="panel ar-band ar-girih" data-reveal>
      <div class="window ar-arch" aria-hidden="true"></div>
      <div class="copy">
        <h2>{title}</h2>
        <Rule class="rule" />
        {text && <p>{text}</p>}
      </div>
      {action && (
        <a class="btn btn--gold" href={action.href} target={action.external ? '_blank' : undefined} rel={action.external ? 'noopener' : undefined}>{action.label}</a>
      )}
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative; overflow: hidden;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-5);
    padding: var(--space-7) var(--space-6); border-radius: var(--radius-m);
    border: 1px solid color-mix(in oklab, var(--ar-gold) 55%, transparent);
    box-shadow: inset 0 0 0 6px var(--ar-deeper), inset 0 0 0 7px color-mix(in oklab, var(--ar-gold) 55%, transparent);
  }
  .window {
    position: absolute; inset-block: -10% auto; inset-inline-end: 4%; inline-size: 9rem; block-size: 120%;
    background: var(--ar-gold); opacity: 0.12;
  }
  .copy { position: relative; display: flex; flex-direction: column; gap: var(--space-3); min-inline-size: 0; flex: 1 1 22rem; }
  h2 { font-size: var(--step-3); }
  .copy :global(.rule) { justify-content: flex-start; inline-size: 12rem; }
  p { max-inline-size: 52ch; color: color-mix(in oklab, var(--ar-on-deep) 92%, transparent); }
  .btn { position: relative; }
</style>
