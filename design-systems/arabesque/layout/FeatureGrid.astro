---
// Inlaid panels: ivory cards with a gold-capped edge and a small star; gold light runs
// along the edge on hover.
import type { PageContext } from '@engine/context';
import SectionTitle from './SectionTitle.astro';
interface Item { title: string; text?: string; href?: string; external?: boolean }
interface Props { ctx: PageContext; title?: string; items: Item[] }
const { title, items } = Astro.props;
const star = 'M12 1l1.9 6.4 5.9-3.2-3.2 5.9L23 12l-6.4 1.9 3.2 5.9-5.9-3.2L12 23l-1.9-6.4-5.9 3.2 3.2-5.9L1 12l6.4-1.9-3.2-5.9 5.9 3.2z';
---
<section class="section">
  <div class="container stack">
    {title && <SectionTitle title={title} />}
    <ul class="grid" role="list">
      {items.map((item) => (
        <li data-reveal>
          {item.href ? (
            <a class="card" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
              <svg class="star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={star} /></svg>
              <h3>{item.title}</h3>
              {item.text && <p>{item.text}</p>}
              <svg class="arrow flip-rtl" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          ) : (
            <div class="card">
              <svg class="star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={star} /></svg>
              <h3>{item.title}</h3>
              {item.text && <p>{item.text}</p>}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: var(--space-6); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-5); }
  .grid > li { display: flex; }
  .card {
    position: relative; flex: 1; display: flex; flex-direction: column; gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5); border-radius: var(--radius-s);
    background: var(--c-surface); border: 1px solid var(--c-line); border-block-start: 3px solid var(--ar-gold);
    color: var(--c-ink); text-decoration: none; box-shadow: 0 1px 0 var(--c-line);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  a.card:hover { transform: translateY(-3px); box-shadow: var(--ar-shadow); }
  .star { inline-size: 26px; block-size: 26px; fill: var(--ar-gold); }
  h3 { font-size: var(--step-2); color: var(--c-accent); }
  p { color: var(--c-muted); }
  .arrow { margin-block-start: auto; color: var(--c-accent); }
  @media (prefers-reduced-motion: reduce) { a.card:hover { transform: none; } }
</style>
