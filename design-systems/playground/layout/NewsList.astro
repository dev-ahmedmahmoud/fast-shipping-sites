---
import type { PageContext } from '@engine/context';
interface NewsItem { title: string; href: string; date?: string; excerpt?: string }
interface Props { ctx: PageContext; title?: string; items: NewsItem[]; more?: { label: string; href: string } | null; headingLevel?: 1 | 2 }
const { ctx, title, items, more, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const TOYS = ['sun', 'green', 'red', 'blue', 'purple', 'orange'];
const TILTS = [-2, 1.5, -1, 2, -1.5, 1];
---
<section class="section">
  <div class="container stack">
    <div class="head">
      {title && <Heading class:list={['title', { big: headingLevel === 1 }]} data-split-words={headingLevel === 1 ? '' : undefined} data-reveal={headingLevel === 1 ? undefined : ''}>{title}</Heading>}
      {more && items.length > 0 && (
        <a class="btn btn--ghost more" href={more.href}>
          {more.label}
          <svg class="flip-rtl" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M12 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      )}
    </div>
    {items.length === 0 ? (
      <p class="empty">{ctx.ui.noNews}</p>
    ) : (
      <ul class="list" role="list">
        {items.map((n, i) => (
          <li data-reveal style={`--toy: var(--pg-${TOYS[i % TOYS.length]}); --tilt: ${TILTS[i % TILTS.length]}deg`}>
            <a class="note" href={n.href}>
              <span class="tape" aria-hidden="true"></span>
              {n.date && <time class="date">{n.date}</time>}
              <h3>{n.title}</h3>
              {n.excerpt && <p>{n.excerpt}</p>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: var(--space-6); }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .title { font-size: var(--step-3); }
  .title.big { font-size: var(--step-5); }
  .more { min-block-size: 44px; font-size: var(--step--1); }
  .empty { color: var(--c-muted); padding: var(--space-5); border: 2px dashed var(--c-line); border-radius: var(--radius-m); }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: var(--space-6) var(--space-5); padding-block-start: var(--space-3); }
  .list > li { display: flex; }
  .note {
    position: relative; flex: 1; display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border-radius: var(--radius-s) var(--radius-s) var(--radius-m) var(--radius-s);
    background: color-mix(in oklab, var(--toy) 20%, var(--c-surface));
    border: 2px solid color-mix(in oklab, var(--toy) 60%, var(--c-ink));
    box-shadow: 0 6px 0 color-mix(in oklab, var(--toy) 45%, var(--c-ink));
    color: var(--c-ink); text-decoration: none;
    transform: rotate(var(--tilt));
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .note:hover { transform: rotate(0deg) translateY(-6px) scale(1.02); box-shadow: 0 12px 0 color-mix(in oklab, var(--toy) 45%, var(--c-ink)); }
  .tape {
    position: absolute; inset-block-start: -12px; inset-inline-start: 50%; translate: -50% 0; rotate: -3deg;
    inline-size: 84px; block-size: 24px; border-radius: 3px;
    background: color-mix(in oklab, var(--c-surface) 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--c-ink) 15%, transparent);
  }
  .date {
    align-self: flex-start; font-size: var(--step--1); font-weight: var(--weight-strong); font-variant-numeric: tabular-nums;
    padding: 2px var(--space-3); border-radius: var(--radius-pill); background: var(--c-surface); border: 2px solid var(--c-ink);
  }
  h3 { font-size: var(--step-1); }
  p { color: var(--c-muted); }
</style>
