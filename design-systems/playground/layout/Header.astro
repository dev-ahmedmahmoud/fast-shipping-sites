---
import { Image } from 'astro:assets';
import type { PageContext, NavItem } from '@engine/context';
interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const other = ctx.languages.find((l) => !l.current);
const TOYS = ['blue', 'red', 'green', 'purple', 'orange', 'sun'];
const toy = (i: number) => `--toy: var(--pg-${TOYS[i % TOYS.length]})`;
const linkAttrs = (item: NavItem) => ({
  href: item.href,
  'aria-current': item.current ? 'page' : undefined,
  target: item.external ? '_blank' : undefined,
  rel: item.external ? 'noopener' : undefined,
});
---
<header class="header">
  <div class="stripes" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
  <div class="container bar">
    <a class="brand" href={ctx.site.homeHref} aria-label={ctx.site.name}>
      <span class="badge">
        {ctx.site.logo
          ? <Image src={ctx.site.logo} alt="" height={88} class="logo" loading="eager" />
          : <span class="mark" aria-hidden="true">{ctx.site.shortName}</span>}
      </span>
      <span class="name">{ctx.site.name}</span>
    </a>

    <div class="actions">
      {other && (
        <a class="lang" href={other.href} hreflang={other.locale} lang={other.locale}>{other.name}</a>
      )}
      {ctx.cta && (
        <a class="btn btn--sun cta" href={ctx.cta.href}
           target={ctx.cta.external ? '_blank' : undefined} rel={ctx.cta.external ? 'noopener' : undefined}>
          {ctx.cta.label}
        </a>
      )}
      <details class="nav-mobile">
        <summary class="btn btn--ghost">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
          {ctx.ui.menu}
        </summary>
        <nav aria-label={ctx.ui.menu}>
          <ul role="list">
            {ctx.nav.map((item, i) => (
              <li style={toy(i)}>
                <a {...linkAttrs(item)}>{item.label}</a>
                {item.children.length > 0 && (
                  <ul role="list" class="sub-mobile">
                    {item.children.map((c) => <li><a {...linkAttrs(c)}>{c.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <nav class="nav-desktop" aria-label={ctx.ui.menu}>
    <ul role="list" class="container">
      {ctx.nav.map((item, i) => (
        <li class:list={[{ 'has-sub': item.children.length > 0 }]} style={toy(i)}>
          <a {...linkAttrs(item)}>
            {item.label}
            {item.children.length > 0 && <svg class="caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
          </a>
          {item.children.length > 0 && (
            <ul role="list" class="sub">
              {item.children.map((c) => <li><a {...linkAttrs(c)}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky; inset-block-start: 0; z-index: 20;
    background: var(--c-surface);
    border-block-end: var(--pg-border) solid var(--c-ink);
    padding-block-start: env(safe-area-inset-top, 0px);
  }
  .stripes { display: flex; block-size: 6px; }
  .stripes span { flex: 1; }
  .stripes span:nth-child(1) { background: var(--pg-red); }
  .stripes span:nth-child(2) { background: var(--pg-orange); }
  .stripes span:nth-child(3) { background: var(--pg-sun); }
  .stripes span:nth-child(4) { background: var(--pg-green); }
  .stripes span:nth-child(5) { background: var(--pg-blue); }
  .stripes span:nth-child(6) { background: var(--pg-purple); }

  .bar { display: flex; align-items: center; gap: var(--space-4); min-block-size: 74px; }
  .brand { display: flex; align-items: center; gap: var(--space-3); color: var(--c-ink); text-decoration: none; min-inline-size: 0; }
  .badge {
    flex: none; display: grid; place-items: center;
    inline-size: 56px; block-size: 56px; border-radius: 50%;
    background: var(--c-surface); border: var(--pg-border) solid var(--c-ink);
    box-shadow: 0 4px 0 var(--pg-sun);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .brand:hover .badge { transform: rotate(-10deg) scale(1.06); }
  .logo { block-size: 40px; inline-size: auto; }
  .mark { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--step--1); }
  .name { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--step-0); line-height: 1.15; max-inline-size: 22ch; }

  .actions { display: flex; align-items: center; gap: var(--space-3); margin-inline-start: auto; }
  .lang {
    display: inline-flex; align-items: center; min-block-size: 44px; padding-inline: var(--space-4);
    border-radius: var(--radius-pill); border: 2px dashed var(--c-line);
    color: var(--c-ink); text-decoration: none; font-weight: var(--weight-strong); font-size: var(--step--1);
  }
  .lang:hover { border-style: solid; border-color: var(--c-ink); }
  .cta { min-block-size: 44px; }

  .nav-desktop { border-block-start: 2px dashed var(--c-line); }
  .nav-desktop > ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); padding-block: var(--space-2); }
  .nav-desktop a, .nav-mobile a {
    display: flex; align-items: center; gap: 6px;
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-pill);
    color: var(--c-ink); text-decoration: none; font-size: var(--step--1); font-weight: 500; white-space: nowrap;
    transition: background-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }
  .nav-desktop a:hover, .nav-mobile a:hover {
    background: color-mix(in oklab, var(--toy) 22%, var(--c-surface));
    transform: translateY(-2px);
  }
  a[aria-current="page"] {
    background: var(--c-highlight); color: var(--c-ink); font-weight: var(--weight-strong);
    box-shadow: inset 0 0 0 2px var(--c-ink);
  }
  .caret { flex: none; }
  .has-sub { position: relative; }
  .sub {
    display: none; position: absolute; inset-inline-start: 0; inset-block-start: 100%; z-index: 5;
    min-inline-size: 15rem; padding: var(--space-2);
    background: var(--c-surface); border: var(--pg-border) solid var(--c-ink); border-radius: var(--radius-m);
    box-shadow: 0 6px 0 var(--c-ink);
  }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { display: grid; gap: 2px; }
  .sub a { border-radius: var(--radius-s); }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary { list-style: none; min-block-size: 44px; padding-inline: var(--space-4); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile nav {
    position: absolute; inset-inline-end: 0; inset-block-start: calc(100% + var(--space-3));
    inline-size: min(20rem, calc(100vw - 2 * var(--gutter))); max-block-size: 75vh; overflow-y: auto; padding: var(--space-2);
    background: var(--c-surface); border: var(--pg-border) solid var(--c-ink); border-radius: var(--radius-m);
    box-shadow: 0 6px 0 var(--c-ink);
  }
  .nav-mobile nav > ul { display: grid; gap: 2px; }
  .sub-mobile { padding-inline-start: var(--space-4); }

  @media (max-width: 1080px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }
  @media (max-width: 640px) {
    .name { display: none; }
    .cta { display: none; }
    .bar { min-block-size: 66px; }
    .badge { inline-size: 50px; block-size: 50px; }
    .logo { block-size: 36px; }
  }
</style>
