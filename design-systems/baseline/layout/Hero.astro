---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
interface Props { ctx: PageContext; eyebrow?: string; title: string; lead?: string; actions: Action[]; images?: ImageMetadata[] }
const { eyebrow, title, lead, actions, images = [] } = Astro.props;
---
<section class="hero">
  <div class="container inner">
    {eyebrow && <p class="label" data-reveal>{eyebrow}</p>}
    <h1 data-split-words>{title}</h1>
    {lead && <p class="lead" data-reveal>{lead}</p>}
    {actions.length > 0 && (
      <div class="actions" data-reveal>
        {actions.map((a, i) => (
          <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--ghost']} href={a.href}
             target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener' : undefined}>{a.label}</a>
        ))}
      </div>
    )}
  </div>
  {images.length > 0 && (
    <div class="container strip" data-reveal>
      {images.map((img, i) => (
        <Image src={img} alt="" widths={[480, 960, 1440]} sizes="(max-width: 720px) 100vw, 50vw" loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
    </div>
  )}
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
    background: linear-gradient(to bottom, var(--c-accent-soft), var(--c-bg));
  }
  .inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); }
  h1 { font-size: var(--step-5); max-inline-size: 18ch; }
  .lead { font-size: var(--step-2); color: var(--c-muted); max-inline-size: 40ch; line-height: 1.5; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); padding-block-start: var(--space-2); }
  .strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: var(--space-3); margin-block-start: var(--space-7); }
  .strip :global(img) { inline-size: 100%; block-size: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-m); }
</style>
