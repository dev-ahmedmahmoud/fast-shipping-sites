---
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext; title?: string; items: { value: string; label: string }[] }
const { title, items } = Astro.props;
---
<section class="section">
  <div class="container">
    {title && <h2 data-reveal>{title}</h2>}
    <dl class="stats">
      {items.map((s) => (
        <div class="stat" data-reveal>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  h2 { font-size: var(--step-3); margin-block-end: var(--space-5); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--space-4); }
  .stat {
    display: flex; flex-direction: column-reverse; gap: var(--space-1);
    padding-block: var(--space-4); border-block-start: 2px solid var(--c-accent);
  }
  dd { margin: 0; font-family: var(--font-display); font-size: var(--step-4); font-weight: var(--weight-display); font-variant-numeric: tabular-nums; line-height: 1.1; }
  dt { color: var(--c-muted); }
</style>
