---
// A row of portrait photos that scrolls sideways.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext; photos: ImageMetadata[]; alt: string; label: string; hint?: string }
const { photos, alt, label, hint } = Astro.props;
---
<section class="section" aria-label={label}>
  <div class="container">
    <div class="row" tabindex="0" role="group" aria-label={hint ?? label}>
      {photos.map((p) => (
        <figure><Image src={p} alt={alt} widths={[320, 640]} sizes="(max-width: 600px) 70vw, 320px" /></figure>
      ))}
    </div>
  </div>
</section>

<style>
  .row { display: flex; gap: var(--space-3); overflow-x: auto; scroll-snap-type: x mandatory; padding-block-end: var(--space-3); }
  figure { margin: 0; flex: 0 0 auto; scroll-snap-align: start; }
  figure :global(img) { block-size: min(26rem, 60vh); inline-size: auto; border-radius: var(--radius-m); }
</style>
