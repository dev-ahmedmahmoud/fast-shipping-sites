---
// The list's home hero: name, slogan, election name, actions and the team photo.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
interface Props {
  ctx: PageContext;
  title: string;
  slogan: string;
  sub: string;
  actions: Action[];
  image: ImageMetadata | null;
  imageAlt: string;
  crest: ImageMetadata | null;
}
const { title, slogan, sub, actions, image, imageAlt } = Astro.props;
---
<section class="hero">
  <div class="container grid">
    <div class="copy">
      <h1 data-split-words>{title}</h1>
      <p class="slogan">{slogan}</p>
      <p class="sub">{sub}</p>
      <div class="actions">
        {actions.map((a, i) => (
          <a class:list={['btn', i === 0 ? 'btn--primary' : 'btn--ghost']} href={a.href}>{a.label}</a>
        ))}
      </div>
    </div>
    {image && (
      <figure class="photo">
        <Image src={image} alt={imageAlt} widths={[640, 960, 1397]} sizes="(max-width: 900px) 100vw, 50vw" loading="eager" fetchpriority="high" />
      </figure>
    )}
  </div>
</section>

<style>
  .hero { padding-block: var(--space-7); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-6); align-items: center; }
  .copy { display: flex; flex-direction: column; gap: var(--space-3); min-inline-size: 0; }
  h1 { font-size: var(--step-5); }
  .slogan { font-size: var(--step-2); color: var(--c-accent); font-weight: var(--weight-strong); }
  .sub { color: var(--c-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block-start: var(--space-3); }
  .photo { margin: 0; }
  .photo :global(img) { inline-size: 100%; block-size: auto; border-radius: var(--radius-l); }
  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
