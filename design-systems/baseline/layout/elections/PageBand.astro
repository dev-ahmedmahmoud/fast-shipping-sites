---
// An inner page's title band (h1): optional kicker link, title, lead and one action.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
interface Props {
  ctx: PageContext;
  title: string;
  lead?: string;
  kicker?: Action | null;
  action?: Action | null;
  crest: ImageMetadata | null;
}
const { title, lead, kicker, action, crest } = Astro.props;
---
<section class="band">
  <div class="container inner">
    {crest && <Image class="crest" src={crest} alt="" height={96} loading="eager" />}
    {kicker && <p class="kicker"><a href={kicker.href}>{kicker.label}</a></p>}
    <h1 data-split-words>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {action && <p><a class="btn btn--primary" href={action.href}>{action.label}</a></p>}
  </div>
</section>

<style>
  .band { padding-block: var(--space-7); background: var(--c-sunk); }
  .inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center; }
  .inner :global(.crest) { block-size: 72px; inline-size: auto; }
  .kicker a { color: var(--c-accent); font-weight: var(--weight-strong); text-decoration: none; }
  h1 { font-size: var(--step-4); }
  .lead { color: var(--c-muted); font-size: var(--step-1); max-inline-size: 50ch; }
</style>
