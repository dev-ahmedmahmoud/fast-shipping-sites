---
// The hero is a comic page. The first panel holds the title in a speech bubble
// over speed lines; up to three photo panels follow in reading order (grid lines
// run with the writing direction, so the page reads right-to-left in Arabic).
// Entrance is pure CSS: panels "turn in" like comic pages from a visible state.
// Pointer tilt, scroll tilt and in-panel photo parallax switch on only when the
// motion part marks the device as capable (`.cc-rich`).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
interface Props { ctx: PageContext; eyebrow?: string; title: string; lead?: string; actions: Action[]; images?: ImageMetadata[] }
const { ctx, eyebrow, title, lead, actions, images = [] } = Astro.props;
const shots = images.slice(0, 3);
const rot = ['-1.2deg', '1.4deg', '-0.6deg', '0.8deg'];

// An 18-point starburst for the sticker, drawn once at build time.
const burst = Array.from({ length: 36 }, (_, k) => {
  const a = (Math.PI * 2 * k) / 36 - Math.PI / 2;
  const r = k % 2 ? 37 : 49;
  return `${(50 + r * Math.cos(a)).toFixed(2)},${(50 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
---
<section class="hero">
  <div class="container">
    <div class:list={['page', `shots-${shots.length}`]} data-loop>
      <div class="panel lead-panel" style={`--i:0;--rot:${rot[0]}`}>
        <div class="ink" data-tilt>
          <span class="lines" aria-hidden="true"></span>
          <span class="dots" aria-hidden="true"></span>
          <div class="story">
            {eyebrow && <p class="caption">{eyebrow}</p>}
            <div class="bubble">
              <h1 class:list={[{ long: title.length > 34 }]} data-split-words>{title}</h1>
            </div>
            {lead && <p class="thought">{lead}</p>}
            {actions.length > 0 && (
              <div class="actions">
                {actions.map((a, i) => (
                  <a class:list={['btn', i === 0 ? 'btn--pop' : 'btn--ghost']} href={a.href}
                     target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener' : undefined}>{a.label}</a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      {shots.map((img, i) => (
        <figure class:list={['panel', 'shot', `shot-${i + 1}`]} style={`--i:${i + 1};--rot:${rot[i + 1]}`}>
          <div class="ink" data-tilt>
            <Image src={img} alt="" widths={i === 2 ? [480, 960, 1440] : [360, 560, 800]}
              sizes={i === 2 ? '(max-width: 880px) 100vw, 76rem' : '(max-width: 880px) 50vw, 32rem'}
              loading="eager" />
          </div>
        </figure>
      ))}

      <span class="burst" aria-hidden="true">
        <svg viewBox="0 0 100 100"><polygon points={burst} /></svg>
        <span class="burst-text" dir="ltr">{ctx.site.shortName}!</span>
      </span>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-6) var(--space-7); }
  .page {
    position: relative;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-4);
    perspective: 1400px;
  }

  /* ---- Panels ---- */
  .panel {
    position: relative; margin: 0; min-inline-size: 0;
    animation: turn-in var(--dur-slow) var(--ease-out) both;
    animation-delay: calc(var(--i) * 120ms);
    transform-origin: calc(50% - 50% * var(--dir)) 50%;
  }
  .ink {
    position: relative; block-size: 100%; overflow: hidden;
    border: var(--ink-w) solid var(--c-ink); border-radius: var(--radius-s);
    box-shadow: var(--ink-shadow-big);
    transform: rotate(var(--rot, 0deg)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform var(--dur-base) var(--ease-out);
  }
  @keyframes turn-in {
    from { rotate: y calc(var(--dir) * -32deg); translate: calc(var(--dir) * -24px) 12px; scale: 0.94; }
    to { rotate: y 0deg; translate: 0 0; scale: 1; }
  }

  /* ---- Title panel: speed lines, halftone, bubble ---- */
  .lead-panel { grid-column: 1 / span 7; grid-row: 1 / span 2; }
  .lead-panel .ink { background: var(--c-accent); color: var(--c-accent-ink); }
  .lines {
    position: absolute; inset: -60%; pointer-events: none;
    background: repeating-conic-gradient(from 0deg at 50% 50%,
      color-mix(in srgb, var(--c-accent-ink) 16%, transparent) 0deg 4deg, transparent 4deg 11deg);
  }
  .dots {
    position: absolute; inset: 0; pointer-events: none;
    background-image: var(--halftone-light); background-size: 11px 11px;
    mask-image: linear-gradient(to bottom, transparent 30%, #000);
  }
  .story {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5);
    padding: var(--space-6) clamp(var(--space-4), 4vw, var(--space-7)) var(--space-7);
  }
  .caption {
    padding: var(--space-1) var(--space-4);
    background: var(--c-highlight); color: var(--c-ink);
    border: var(--ink-w) solid var(--c-ink);
    font-family: var(--font-display); font-size: var(--step-1); letter-spacing: 0.06em;
    rotate: calc(var(--dir) * -2deg);
    box-shadow: var(--ink-shadow);
  }
  .bubble {
    position: relative; max-inline-size: 100%;
    padding: var(--space-5) var(--space-6);
    background: var(--c-surface); color: var(--c-ink);
    border: var(--ink-w) solid var(--c-ink);
    border-radius: var(--radius-l) calc(var(--radius-l) * 1.6) var(--radius-l) calc(var(--radius-l) * 1.3);
    box-shadow: var(--ink-shadow);
  }
  /* The tail: an ink triangle with a white one laid over it. */
  .bubble::before, .bubble::after {
    content: ""; position: absolute; inset-block-start: 100%; inset-inline-start: 18%;
    inline-size: 46px; block-size: 34px;
    clip-path: polygon(0 0, 100% 0, calc(50% - 50% * var(--dir)) 100%);
  }
  .bubble::before { background: var(--c-ink); margin-block-start: 0; }
  .bubble::after {
    background: var(--c-surface);
    inline-size: calc(46px - 2.5 * var(--ink-w)); block-size: calc(34px - 2 * var(--ink-w));
    margin-block-start: calc(-1 * var(--ink-w));
    margin-inline-start: var(--ink-w);
  }
  h1 { font-size: var(--step-5); max-inline-size: 16ch; }
  /* Long welcome lines (Bangers runs wide in English) drop one step. */
  h1.long { font-size: var(--step-4); max-inline-size: 20ch; }
  .thought {
    position: relative; margin-inline-start: auto;
    padding: var(--space-2) var(--space-5);
    background: var(--c-surface); color: var(--c-ink);
    border: var(--ink-w) solid var(--c-ink); border-radius: var(--radius-pill);
    font-size: var(--step-1); font-weight: var(--weight-strong);
    rotate: calc(var(--dir) * 1.5deg);
  }
  /* Thought bubbles trail off in little puffs. */
  .thought::before, .thought::after {
    content: ""; position: absolute; border: var(--ink-w) solid var(--c-ink); border-radius: 50%; background: var(--c-surface);
  }
  .thought::before { inline-size: 18px; block-size: 18px; inset-block-start: -22px; inset-inline-start: 14%; }
  .thought::after { inline-size: 10px; block-size: 10px; inset-block-start: -38px; inset-inline-start: 9%; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-4); padding-block-start: var(--space-2); }

  /* ---- Photo panels ---- */
  .shot .ink { background: var(--c-sunk); min-block-size: 12rem; }
  .shot :global(img) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .shot .ink::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: var(--halftone); background-size: 7px 7px;
    mix-blend-mode: multiply; opacity: 0.55;
    mask-image: linear-gradient(calc(var(--dir) * 135deg), #000, transparent 55%);
  }
  /* Banners usually keep their subject at one end and baked-in text at the other;
     aim the first panel's crop at the subject. */
  .shot-1 :global(img) { object-position: 100% 35%; }
  .shot-1 { grid-column: 8 / span 5; grid-row: 1; }
  .shot-2 { grid-column: 8 / span 5; grid-row: 2; }
  .shot-3 { grid-column: 1 / -1; grid-row: 3; }
  .shot-3 .ink { block-size: auto; min-block-size: 0; aspect-ratio: 16 / 5; }
  /* With fewer photos, the title panel takes the room. */
  .shots-0 .lead-panel { grid-column: 1 / -1; }
  .shots-1 .shot-1 { grid-row: 1 / span 2; }

  /* ---- Starburst sticker ---- */
  .burst {
    position: absolute; z-index: 3; inset-block-start: -1.4rem; inset-inline-start: calc(58.33% - 3.2rem);
    inline-size: 6.4rem; block-size: 6.4rem; display: grid; place-items: center;
    rotate: calc(var(--dir) * -12deg);
    animation: stamp 700ms var(--ease-out) 600ms both;
  }
  .burst svg { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible; }
  .burst polygon { fill: var(--c-highlight); stroke: var(--c-ink); stroke-width: 3; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .burst-text { position: relative; font-family: var(--font-display); font-size: var(--step-1); color: var(--c-ink); line-height: 1; }
  @keyframes stamp {
    0% { scale: 2.4; opacity: 0; }
    60% { scale: 0.9; opacity: 1; }
    100% { scale: 1; opacity: 1; }
  }

  /* ---- Phones and small tablets: one column of story, photos side by side ---- */
  @media (max-width: 880px) {
    .page { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-3); }
    .lead-panel { grid-column: 1 / -1; grid-row: 1; }
    .shot-1 { grid-column: 1 / span 3; grid-row: 2; }
    .shot-2 { grid-column: 4 / span 3; grid-row: 2; }
    .shot-3 { grid-column: 1 / -1; grid-row: 3; }
    .shot .ink { block-size: auto; min-block-size: 0; aspect-ratio: 4 / 3; }
    .shots-1 .shot-1 { grid-column: 1 / -1; grid-row: 2; }
    .shots-1 .shot-1 .ink { aspect-ratio: 16 / 9; }
    .shot-3 .ink { aspect-ratio: 16 / 7; }
    .burst { inset-block-start: -1rem; inset-inline-start: auto; inset-inline-end: -0.4rem; inline-size: 5rem; block-size: 5rem; }
    .story { gap: var(--space-4); padding-block-end: var(--space-6); }
    .bubble { padding: var(--space-4) var(--space-5); }
    .thought { font-size: var(--step-0); }
  }

  /* The engine shortens animations for reduced motion but keeps their delays;
     drop the entrances outright so nothing sits tilted while it waits. */
  @media (prefers-reduced-motion: reduce) {
    .panel, .burst { animation: none; }
  }

  /* ---- Rich motion, capable devices only ---- */
  /* Speed lines burst out once and then hold still: a spinning layer this large
     costs a phone hundreds of milliseconds of main-thread time. */
  :global(.cc-rich) .lines { animation: zoom-lines 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  :global(.cc-rich) .burst-text { animation: wobble 1.6s ease-in-out 1.4s 3; }
  @keyframes zoom-lines { from { scale: 1.6; opacity: 0; } }
  @keyframes wobble { 0%, 100% { rotate: 0deg; scale: 1; } 50% { rotate: 8deg; scale: 1.1; } }
  @supports (animation-timeline: view()) {
    /* As the page scrolls away, panels tip back like a page being turned... */
    :global(.cc-rich) .ink {
      animation: page-tip linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }
    /* ...and photos drift inside their frames. */
    :global(.cc-rich) .shot :global(img) {
      scale: 1.14;
      animation: drift linear both;
      animation-timeline: view();
    }
    @keyframes page-tip { to { rotate: x 14deg; } }
    @keyframes drift { from { translate: 0 -5%; } to { translate: 0 5%; } }
  }
</style>
