---
// The station's name board: the crest and the list's name on an enamel plate, the menu as
// platform direction signs, and the main call to action (the brass rail on top was removed
// on 20 Nov: the hero's gold ribbon now edges the header).
import { Image } from 'astro:assets';
import type { PageContext, NavItem } from '@engine/context';
interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const other = ctx.languages.find((l) => !l.current);
// The call-to-action button (Tanta: complaints) shows on every page except its own, at every
// width. Wherever it shows, the desktop menu leaves out the item for the same page, so the link
// isn't there twice; on that page itself the button hides and the menu item shows (current).
const trim = (h: string) => h.replace(/[?#].*$/, '').replace(/\/+$/, '');
const ctaHere = !!ctx.cta && !ctx.cta.external && trim(ctx.cta.href) === trim(Astro.url.pathname);
const cta = ctaHere ? null : ctx.cta;
const deskNav = cta && !cta.external ? ctx.nav.filter((n) => trim(n.href) !== trim(cta.href)) : ctx.nav;
const linkAttrs = (item: NavItem) => ({
  href: item.href,
  'aria-current': item.current ? 'page' : undefined,
  target: item.external ? '_blank' : undefined,
  rel: item.external ? 'noopener' : undefined,
});
---
<header class="header">
  <div class="container bar">
    <a class="brand" href={ctx.site.homeHref} aria-label={ctx.site.name}>
      {ctx.site.logo
        ? <Image src={ctx.site.logo} alt="" height={56} densities={[1, 2]} class="logo" loading="eager" />
        : <span class="mark" aria-hidden="true">{ctx.site.shortName}</span>}
      <span class="name">{ctx.site.name}</span>
    </a>

    <div class="actions">
      {other && (
        <a class="lang" href={other.href} hreflang={other.locale} lang={other.locale}>{other.name}</a>
      )}
      {cta && (
        <a class="btn btn--primary cta" href={cta.href}
           target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener' : undefined}>
          {cta.href.startsWith('https://wa.me/') && (
            <svg class="wa" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="M9 8.5c0 3.5 2.5 6.5 6.5 6.5l1-1.6-2-1-1 1c-1.2-.4-2.6-1.8-3-3l1-1-1-2Z" fill="currentColor" /></svg>
          )}
          {cta.label}{cta.external && <span class="sr-only"> {ctx.ui.newTab}</span>}
        </a>
      )}
      <details class="nav-mobile">
        <summary class="btn btn--ghost">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span class="menu-label">{ctx.ui.menu}</span>
        </summary>
        <nav aria-label={ctx.ui.menu}>
          <ul role="list">
            {ctx.nav.map((item) => (
              <li>
                <a {...linkAttrs(item)}>{item.label}</a>
                {item.children.length > 0 && (
                  <ul role="list" class="sub-mobile">
                    {item.children.map((c) => <li><a {...linkAttrs(c)}>{c.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>

  <nav class="nav-desktop" aria-label={ctx.ui.menu}>
    <ul role="list" class="container">
      {deskNav.map((item) => (
        <li class:list={[{ 'has-sub': item.children.length > 0 }]}>
          <a {...linkAttrs(item)}>{item.label}</a>
          {item.children.length > 0 && (
            <ul role="list" class="sub">
              {item.children.map((c) => <li><a {...linkAttrs(c)}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky; inset-block-start: 0; z-index: 20;
    background: color-mix(in srgb, var(--c-surface) 96%, transparent);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--c-line);
    padding-block-start: env(safe-area-inset-top, 0px);
  }
  .bar { display: flex; align-items: center; gap: var(--space-4); min-block-size: 78px; }
  .brand { display: flex; align-items: center; gap: var(--space-3); color: var(--c-ink); text-decoration: none; min-inline-size: 0; }
  .logo { block-size: 56px; inline-size: auto; }
  .mark {
    font-family: var(--font-display); font-weight: 700; padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-s); background: var(--st-enamel); color: var(--st-enamel-ink);
  }
  .name {
    font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); line-height: 1.3;
    color: var(--st-enamel);
  }
  .actions { display: flex; align-items: center; gap: var(--space-3); margin-inline-start: auto; }
  .lang { color: var(--c-ink); text-decoration: none; font-weight: 700; padding: var(--space-2); min-block-size: 48px; display: inline-flex; align-items: center; }
  .lang:hover { text-decoration: underline; }

  .nav-desktop { border-block-start: 1px solid var(--c-line); background: var(--c-bg); }
  .nav-desktop > ul { display: flex; flex-wrap: wrap; gap: var(--space-1); padding-block: var(--space-1); }
  .nav-desktop a, .nav-mobile a {
    display: flex; align-items: center; min-block-size: 48px; padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-s); color: var(--c-ink); text-decoration: none;
    font-family: var(--font-body); font-size: var(--step-0); font-weight: 700; white-space: nowrap;
  }
  .nav-desktop a { position: relative; }
  .nav-desktop a::after {
    content: ''; position: absolute; inset-inline: var(--space-4); inset-block-end: 6px; block-size: 3px; border-radius: 2px;
    background: var(--st-brass); transform: scaleX(0); transform-origin: var(--origin, right);
    transition: transform var(--dur-base) var(--ease-out);
  }
  :global([dir='ltr']) .nav-desktop a::after { --origin: left; }
  .nav-desktop a:hover::after, .nav-desktop a[aria-current='page']::after { transform: scaleX(1); }
  .nav-desktop a[aria-current='page'] { color: var(--st-enamel); }
  .has-sub { position: relative; }
  .sub {
    display: none; position: absolute; inset-inline-start: 0; inset-block-start: 100%; z-index: 5;
    min-inline-size: 16rem; padding: var(--space-2);
    background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-m); box-shadow: var(--st-shadow);
  }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { display: block; }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary { list-style: none; color: var(--c-ink); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile nav {
    position: absolute; inset-inline-end: 0; inset-block-start: calc(100% + var(--space-2));
    inline-size: min(22rem, calc(100vw - 2 * var(--gutter))); max-block-size: 75vh; overflow-y: auto; padding: var(--space-2);
    background: var(--c-surface); border: 2px solid var(--c-line); border-radius: var(--radius-m); box-shadow: var(--st-shadow);
  }
  .nav-mobile li + li { border-block-start: 1px solid var(--c-line); }
  .nav-mobile a { white-space: normal; }
  .nav-mobile a[aria-current='page'] { color: var(--st-enamel); background: var(--c-accent-soft); }
  .sub-mobile { padding-inline-start: var(--space-4); }

  @media (max-width: 1080px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }
  /* Phones: the button stays in the bar beside the menu, made compact; the menu button keeps
     its word where there is room and becomes the icon alone on narrow screens. */
  @media (max-width: 720px) {
    .name { font-size: var(--step-0); }
    .logo { block-size: 48px; }
    .actions { gap: var(--space-2); }
    .cta { padding-inline: var(--space-3); font-size: var(--step--1); white-space: nowrap; }
    .nav-mobile summary { padding-inline: var(--space-3); }
  }
  /* Phones: crest, the button in the exact centre, menu button. The side columns are equal,
     so the button sits in the middle of the screen whatever is beside it. */
  @media (max-width: 560px) {
    .name { display: none; }
    .bar { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-2); }
    .actions { display: contents; }
    .brand { grid-column: 1; justify-self: start; }
    .cta { grid-column: 2; }
    .lang { grid-column: 3; grid-row: 1; justify-self: end; margin-inline-end: calc(var(--st-tap) + var(--space-2)); }
    .nav-mobile { grid-column: 3; grid-row: 1; justify-self: end; }
  }
  @media (max-width: 380px) {
    .logo { block-size: 44px; }
    .cta { padding-inline: var(--space-2); font-size: 0.9rem; gap: var(--space-1); }
    .cta .wa { inline-size: 18px; block-size: 18px; }
  }
  @media (max-width: 440px) {
    .menu-label { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .nav-mobile summary { inline-size: var(--st-tap); padding-inline: 0; }
  }
</style>
