---
// A closing invitation printed as a railway ticket: perforated stub, punched hole, brass button.
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
interface Props { ctx: PageContext; title: string; text?: string; action: Action | null }
const { title, text, action } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="ticket" data-st-reveal>
      <div class="copy">
        <h2>{title}</h2>
        {text && <p>{text}</p>}
      </div>
      {action && (
        <div class="stub">
          <a class="btn btn--brass" href={action.href} target={action.external ? '_blank' : undefined} rel={action.external ? 'noopener' : undefined}>{action.label}</a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .ticket {
    --hole: 14px;
    position: relative; display: flex; flex-wrap: wrap; align-items: stretch;
    border-radius: var(--radius-l); background: var(--st-enamel); color: var(--st-enamel-ink);
    box-shadow: inset 0 0 0 4px var(--st-enamel), inset 0 0 0 6px color-mix(in oklab, var(--st-enamel-ink) 70%, transparent), var(--st-shadow);
    /* Two half-circle notches where the stub tears off. */
    -webkit-mask: radial-gradient(circle var(--hole) at var(--stub-x, 30%) 0, transparent 98%, #000) top / 100% 51% no-repeat,
                  radial-gradient(circle var(--hole) at var(--stub-x, 30%) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
            mask: radial-gradient(circle var(--hole) at var(--stub-x, 30%) 0, transparent 98%, #000) top / 100% 51% no-repeat,
                  radial-gradient(circle var(--hole) at var(--stub-x, 30%) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
  }
  :global([dir='ltr']) .ticket { --stub-x: 70%; }
  .copy { flex: 1 1 22rem; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-7) var(--space-6); min-inline-size: 0; }
  h2 { font-size: var(--step-3); }
  p { font-size: var(--step-1); color: color-mix(in oklab, var(--st-enamel-ink) 90%, var(--st-enamel)); max-inline-size: 46ch; }
  .stub {
    /* As wide as its button needs (never narrower), so the button can't spill out of the ticket. */
    flex: 0 0 auto; min-inline-size: 15rem; display: grid; place-items: center; padding: var(--space-6);
    border-inline-start: 3px dashed color-mix(in oklab, var(--st-enamel-ink) 55%, transparent);
  }
  @media (max-width: 700px) {
    .ticket { -webkit-mask: none; mask: none; }
    .stub { flex-basis: 100%; border-inline-start: 0; border-block-start: 3px dashed color-mix(in oklab, var(--st-enamel-ink) 55%, transparent); }
  }
</style>
