---
// Links as platform direction signs: an enamel header plate, the description on card stock.
import type { PageContext } from '@engine/context';
interface Item { title: string; text?: string; href?: string; external?: boolean }
interface Props { ctx: PageContext; title?: string; items: Item[] }
const { ctx, title, items } = Astro.props;
---
<section class="section">
  <div class="container stack">
    {title && <div class="st-title"><h2 data-st-reveal>{title}</h2></div>}
    <ul class="grid" role="list">
      {items.map((item, i) => (
        <li data-st-reveal style={`--i:${i}`}>
          {item.href ? (
            <a class="card" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
              <span class="plate"><span class="st-plate no" aria-hidden="true">{ctx.fmt.number(i + 1)}</span><h3>{item.title}</h3></span>
              {item.text && <p>{item.text}</p>}
              <svg class="arrow flip-rtl" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          ) : (
            <div class="card">
              <span class="plate"><span class="st-plate no" aria-hidden="true">{ctx.fmt.number(i + 1)}</span><h3>{item.title}</h3></span>
              {item.text && <p>{item.text}</p>}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: var(--space-6); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: var(--space-5); }
  .grid > li { display: flex; }
  .card {
    flex: 1; display: flex; flex-direction: column; gap: var(--space-3); overflow: hidden;
    border-radius: var(--radius-m); background: var(--c-surface); border: 2px solid var(--c-line);
    color: var(--c-ink); text-decoration: none; box-shadow: var(--st-shadow);
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  a.card:hover { transform: translateY(-4px); border-color: var(--st-brass); }
  .plate {
    display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4);
    background: var(--st-enamel); color: var(--st-enamel-ink);
    box-shadow: inset 0 -3px 0 var(--st-brass);
  }
  .no { font-size: var(--step-0); flex: 0 0 auto; }
  h3 { font-size: var(--step-1); }
  p { color: var(--c-muted); padding-inline: var(--space-4); }
  .arrow { margin-block-start: auto; margin-inline: var(--space-4); margin-block-end: var(--space-4); color: var(--st-enamel); }
</style>
