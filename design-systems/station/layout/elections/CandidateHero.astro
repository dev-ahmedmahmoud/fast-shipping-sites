---
// A candidate's profile header (h1): the candidate standing under a brass arch, the name in
// the light, the seat on the gold pill, and the ballot number on the split-flap board; in the
// home hero's style (gold ribbons, navy gradient, the club's building pale on the left).
// With an interview (video), the photo is also the player: a gold play button at the top of the
// arch, above the head; pressed, the photo becomes the video, playing inside the same arch
// (trimmed to it, so nothing on the page moves). Tapping the video pauses it and brings the
// button back; a thin gold bar above the bottom ribbon shows the progress (and seeks); at the
// end the photo returns. The file is requested only when play is pressed.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
import type { CandidateCard, VideoData } from '@elections/data';
import { ui } from '@elections/data';
import GoldWave from './GoldWave.astro';
interface Props { ctx: PageContext; candidate: CandidateCard; kicker: Action | null; numberLabel: string; backdrop?: ImageMetadata | null; video?: VideoData | null }
const { candidate: c, kicker, numberLabel, backdrop, video } = Astro.props;
const playable = video && video.src && !video.soon ? video : null;
const playLabel = playable ? `${ui.play ?? 'تشغيل الفيديو'}: ${playable.label}` : '';
---
<section class="person st-glass" data-st-ambient>
  {backdrop && <Image class="st-backdrop st-backdrop--whole" src={backdrop} alt="" widths={[640, 1000, 1600]} sizes="(max-width: 900px) 90vw, 44vw" loading="eager" />}
  <GoldWave edge="top" />
  <div class="container grid">
    <div class="copy">
      {kicker && (
        <p class="kicker">
          <a href={kicker.href}><svg class="flip-rtl" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>{kicker.label}</a>
        </p>
      )}
      <h1 data-split-words>{c.name}</h1>
      <p class="st-pill seat">{c.seat}</p>
      <p class="num" data-st-flaps><span class="st-flap" data-st-flap>{numberLabel}</span></p>
    </div>
    <figure class="stand">
      <span class="beam" aria-hidden="true"></span>
      <span class="arch" data-hero-video={playable ? playable.src : undefined} data-play-label={playLabel || undefined}>
        <Image class="photo" src={c.photo} alt={c.photoAlt} widths={[360, 540, 800]} sizes="(max-width: 900px) 92vw, 26rem" loading="eager" fetchpriority="high" />
        {playable && <button class="play" type="button" aria-label={playLabel} style={playable.playAt ? `--play-at: ${(playable.playAt * 100).toFixed(1)}%` : undefined}><span aria-hidden="true"></span></button>}
        {playable && <span class="bar" aria-hidden="true"><span class="bar__fill"></span></span>}
      </span>
    </figure>
  </div>
  <GoldWave edge="bottom" />
</section>

<style>
  .person {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: calc(var(--st-wave-h) + var(--space-5)) 0;
    background-color: var(--st-night); color: var(--st-enamel-ink);
    background-image:
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--st-enamel-ink) 4%, transparent) 0 1px, transparent 1px 96px),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--st-enamel-ink) 3.5%, transparent) 0 1px, transparent 1px 64px),
      var(--st-night-grad);
  }
  /* The whole gate in the top corner under the ribbon: on phones across the top; on computers
     in the top right, behind the name (the photo's arch stands on the left), fading toward it. */
  .person :global(.st-backdrop) { --bd-left: -12%; --bd-top: calc(var(--st-wave-h) * 0.85); --bd-w: 88%; --bd-o: 0.34; }
  @media (min-width: 901px) {
    .person :global(.st-backdrop) {
      --bd-left: auto; --bd-top: calc(var(--st-wave-h) * 0.85); --bd-w: auto; --bd-o: 0.38; --bd-fade: left;
      right: -2%; block-size: min(calc(100% - var(--st-wave-h) * 1.6), 26vw);
    }
  }
  /* A shaft of light falling from above the hall straight down the middle of the arch: it
     belongs to the stand, so it stays centred on the arch at every screen width. */
  .beam {
    position: absolute; z-index: 0; inset-block: -40rem 0; left: 50%; translate: -50% 0;
    inline-size: min(100%, 26rem);
    background: linear-gradient(to bottom, color-mix(in oklab, var(--st-brass-hi) 22%, transparent), transparent 85%);
    clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%); opacity: 0.6; pointer-events: none;
  }
  .stand > .arch { position: relative; z-index: 1; }
  /* The photo runs under the bottom ribbon, which cuts it like the team on the home page. */
  .stand { padding-block-end: calc(var(--st-wave-h) * 0.35); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: var(--space-6); align-items: end; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); min-inline-size: 0; padding-block-end: var(--space-8); align-self: center; }
  .kicker a { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 48px; color: var(--st-brass-hi); font-family: var(--font-body); font-weight: 700; text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  h1 { font-size: var(--step-5); }
  .seat { font-family: var(--font-body); font-weight: 700; font-size: var(--step-1); padding-inline: var(--space-7); white-space: normal; }
  .num .st-flap { font-size: var(--step-3); padding: 0.1em 0.6em; }
  .stand { position: relative; margin: 0; display: grid; justify-items: center; align-items: end; min-inline-size: 0; }
  /* The arch is a window: the photo fills its width exactly and is trimmed to its shape, so a
     shoulder or an arm never crosses the brass, and where a photo was cropped at its side the
     crop lies on the frame's edge. */
  .arch {
    position: relative; display: block; overflow: hidden; inline-size: min(100%, 26rem);
    padding-block-start: 6%;
    border: 3px solid var(--st-brass); border-block-end: 0; border-radius: 50% 50% 0 0 / 34% 34% 0 0;
    background: radial-gradient(ellipse 60% 55% at 50% 55%, color-mix(in oklab, var(--st-brass-hi) 24%, transparent), transparent 70%);
  }
  .arch :global(.photo) { display: block; inline-size: 100%; block-size: auto; }
  /* ---- the photo as the player ---- */
  /* Playing, the video fills the whole window up to the brass curve (the photo's top margin
     goes to the video, so the arch keeps its height). */
  .arch.has-video { padding-block-start: 0; }
  .arch :global(video.clip) { display: block; inline-size: 100%; object-fit: cover; object-position: 50% 32%; background: var(--st-night); cursor: pointer; }
  /* The play button: gold, two thirds of the way down the arch (on the chest, clear of the face);
     a close-up photo moves it lower (the video's playAt). */
  .play {
    position: absolute; z-index: 3; inset-block-start: var(--play-at, 66.7%); inset-inline-start: 50%; translate: 50% -50%;
    display: grid; place-items: center; inline-size: clamp(54px, 15%, 66px); aspect-ratio: 1; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
    background: linear-gradient(145deg, var(--st-brass-hi), var(--st-brass) 55%, var(--st-brass-lo));
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--st-night) 55%, transparent), 0 12px 26px -8px color-mix(in oklab, var(--c-ink) 85%, transparent);
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
    animation: play-pulse 1.6s ease-in-out infinite;
  }
  /* Pulsing to catch the eye: a little bigger, brighter gold and a gold glow, then back. */
  @keyframes play-pulse {
    0%, 100% { scale: 1; filter: brightness(1); }
    50% {
      scale: 1.14; filter: brightness(1.28) saturate(1.15);
      box-shadow: 0 0 0 5px color-mix(in oklab, var(--st-night) 55%, transparent), 0 0 30px 8px color-mix(in oklab, var(--st-brass-hi) 75%, transparent), 0 12px 26px -8px color-mix(in oklab, var(--c-ink) 85%, transparent);
    }
  }
  .is-playing .play, .is-loading .play { animation: none; }
  :global([dir='ltr']) .play { translate: -50% -50%; }
  .play:hover { transform: scale(1.07); }
  .play:focus-visible { outline: 3px solid var(--st-brass-hi); outline-offset: 4px; }
  /* A play mark points right in every language, so it uses a physical side. */
  .play span { inline-size: 0; block-size: 0; border-block: 0.6rem solid transparent; border-left: 1rem solid var(--st-night); translate: 0.15rem 0; }
  .is-playing .play { opacity: 0; pointer-events: none; }
  .is-loading .play span { border: 3px solid var(--st-night); border-block-start-color: transparent; inline-size: 1.4rem; block-size: 1.4rem; border-radius: 50%; translate: none; animation: hero-spin 0.8s linear infinite; }
  @keyframes hero-spin { to { rotate: 360deg; } }
  /* Progress, just above the bottom ribbon; tap or drag-free click to jump. */
  .bar {
    position: absolute; z-index: 3; inset-inline: 9%; inset-block-end: calc(var(--st-wave-h) * 0.3 + 10px);
    block-size: 6px; border-radius: 6px; background: color-mix(in oklab, var(--st-enamel-ink) 35%, transparent);
    opacity: 0; transition: opacity var(--dur-base) var(--ease-out); cursor: pointer;
  }
  .bar::before { content: ''; position: absolute; inset: -12px 0; }
  .has-video .bar { opacity: 1; }
  .bar__fill { position: absolute; inset-block: 0; inset-inline-start: 0; inline-size: 0; border-radius: inherit; background: var(--st-brass-hi); }
  :global([dir='rtl']) .bar__fill { inset-inline-start: auto; inset-inline-end: 0; }
  @media (prefers-reduced-motion: reduce) { .play, .bar { transition: none; } .play, .is-loading .play span { animation: none; } }
  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .copy { padding-block-end: var(--space-4); align-items: center; text-align: center; }
    .stand { order: 2; }
  }
  /* Phones: compact words above the photo, and the arch sized to the screen's height, so the
     whole photo (and its play button) is on the first screen. */
  @media (max-width: 900px) {
    .person { padding-block-start: calc(var(--st-wave-h) * 0.72 + var(--space-2)); }
    .copy { gap: var(--space-2); padding-block-end: var(--space-3); }
    .kicker a { min-block-size: 40px; font-size: 0.9rem; }
    h1 { font-size: clamp(1.5rem, 7vw, 2rem); line-height: 1.25; }
    .seat { font-size: 0.95rem; padding: 0.35em 1.3em; }
    .num .st-flap { font-size: 1.3rem; }
    .arch { inline-size: min(100%, 26rem, calc((100svh - 300px) * 0.78)); }
  }
</style>

<script>
  // The photo as the player (see the top of this file). One video per page.
  document.querySelectorAll<HTMLElement>('[data-hero-video]').forEach((arch) => {
    const src = arch.dataset.heroVideo!;
    const photo = arch.querySelector<HTMLImageElement>('img.photo');
    const btn = arch.querySelector<HTMLButtonElement>('.play');
    const bar = arch.querySelector<HTMLElement>('.bar');
    const fill = arch.querySelector<HTMLElement>('.bar__fill');
    if (!photo || !btn || !bar || !fill) return;
    let v: HTMLVideoElement | null = null;
    // The window's inner height: the photo's height plus the arch's top margin (read before
    // the video takes the photo's place; the margin is a share of the width).
    const height = () => {
      const top = parseFloat(getComputedStyle(arch).paddingBlockStart) || 0.06 * arch.clientWidth;
      const h = photo.isConnected ? photo.getBoundingClientRect().height : (arch.clientWidth * photo.naturalHeight) / photo.naturalWidth;
      return h + (arch.classList.contains('has-video') ? 0.06 * arch.clientWidth : top);
    };
    const back = () => { if (!v) return; v.pause(); v.replaceWith(photo); v = null; arch.classList.remove('has-video', 'is-playing', 'is-loading'); fill.style.inlineSize = '0'; btn.focus({ preventScroll: true }); };
    const make = () => {
      const el = document.createElement('video');
      el.className = 'clip'; el.src = src; el.preload = 'auto'; el.playsInline = true;
      el.setAttribute('playsinline', ''); el.setAttribute('aria-label', arch.dataset.playLabel ?? '');
      el.style.blockSize = `${height()}px`;
      el.addEventListener('playing', () => arch.classList.remove('is-loading'));
      el.addEventListener('waiting', () => arch.classList.add('is-loading'));
      el.addEventListener('play', () => arch.classList.add('is-playing'));
      el.addEventListener('pause', () => arch.classList.remove('is-playing'));
      el.addEventListener('timeupdate', () => { fill.style.inlineSize = `${el.duration ? (el.currentTime / el.duration) * 100 : 0}%`; });
      el.addEventListener('ended', back);
      el.addEventListener('click', () => el.pause());
      return el;
    };
    btn.addEventListener('click', () => {
      if (!v) { v = make(); photo.replaceWith(v); arch.classList.add('has-video', 'is-loading'); }
      void v.play().catch(() => arch.classList.remove('is-loading'));
    });
    bar.addEventListener('click', (e) => {
      if (!v || !v.duration) return;
      const r = bar.getBoundingClientRect();
      const rtl = getComputedStyle(arch).direction === 'rtl';
      const x = rtl ? r.right - e.clientX : e.clientX - r.left;
      v.currentTime = Math.max(0, Math.min(1, x / r.width)) * v.duration;
    });
    // Keep the video the photo's height if the screen turns.
    addEventListener('resize', () => { if (v) v.style.blockSize = `${height()}px`; });
  });
</script>
