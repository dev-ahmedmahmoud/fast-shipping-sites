---
// A candidate's profile header (h1): the candidate standing under a brass arch, the name in
// the light, the seat on the gold pill, and the ballot number on the split-flap board; in the
// home hero's style (gold ribbons, navy gradient, the club's building pale on the left).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
import type { CandidateCard } from '@elections/data';
import GoldWave from './GoldWave.astro';
interface Props { ctx: PageContext; candidate: CandidateCard; kicker: Action | null; numberLabel: string; backdrop?: ImageMetadata | null }
const { candidate: c, kicker, numberLabel, backdrop } = Astro.props;
---
<section class="person st-glass" data-st-ambient>
  {backdrop && <Image class="st-backdrop st-backdrop--whole" src={backdrop} alt="" widths={[640, 1000, 1600]} sizes="(max-width: 900px) 90vw, 44vw" loading="eager" />}
  <GoldWave edge="top" />
  <div class="container grid">
    <div class="copy">
      {kicker && (
        <p class="kicker">
          <a href={kicker.href}><svg class="flip-rtl" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>{kicker.label}</a>
        </p>
      )}
      <h1 data-split-words>{c.name}</h1>
      <p class="st-pill seat">{c.seat}</p>
      <p class="num" data-st-flaps><span class="st-flap" data-st-flap>{numberLabel}</span></p>
    </div>
    <figure class="stand">
      <span class="beam" aria-hidden="true"></span>
      <span class="arch">
        <Image class="photo" src={c.photo} alt={c.photoAlt} widths={[360, 540, 800]} sizes="(max-width: 900px) 92vw, 26rem" loading="eager" fetchpriority="high" />
      </span>
    </figure>
  </div>
  <GoldWave edge="bottom" />
</section>

<style>
  .person {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: calc(var(--st-wave-h) + var(--space-5)) 0;
    background-color: var(--st-night); color: var(--st-enamel-ink);
    background-image:
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--st-enamel-ink) 4%, transparent) 0 1px, transparent 1px 96px),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--st-enamel-ink) 3.5%, transparent) 0 1px, transparent 1px 64px),
      var(--st-night-grad);
  }
  /* The whole gate in the top corner under the ribbon: on phones across the top; on computers
     in the top right, behind the name (the photo's arch stands on the left), fading toward it. */
  .person :global(.st-backdrop) { --bd-left: -12%; --bd-top: calc(var(--st-wave-h) * 0.85); --bd-w: 88%; --bd-o: 0.34; }
  @media (min-width: 901px) {
    .person :global(.st-backdrop) {
      --bd-left: auto; --bd-top: calc(var(--st-wave-h) * 0.85); --bd-w: auto; --bd-o: 0.38; --bd-fade: left;
      right: -2%; block-size: min(calc(100% - var(--st-wave-h) * 1.6), 26vw);
    }
  }
  /* A shaft of light falling from above the hall straight down the middle of the arch: it
     belongs to the stand, so it stays centred on the arch at every screen width. */
  .beam {
    position: absolute; z-index: 0; inset-block: -40rem 0; left: 50%; translate: -50% 0;
    inline-size: min(100%, 26rem);
    background: linear-gradient(to bottom, color-mix(in oklab, var(--st-brass-hi) 22%, transparent), transparent 85%);
    clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%); opacity: 0.6; pointer-events: none;
  }
  .stand > .arch { position: relative; z-index: 1; }
  /* The photo runs under the bottom ribbon, which cuts it like the team on the home page. */
  .stand { padding-block-end: calc(var(--st-wave-h) * 0.35); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: var(--space-6); align-items: end; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); min-inline-size: 0; padding-block-end: var(--space-8); align-self: center; }
  .kicker a { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 48px; color: var(--st-brass-hi); font-family: var(--font-body); font-weight: 700; text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  h1 { font-size: var(--step-5); }
  .seat { font-family: var(--font-body); font-weight: 700; font-size: var(--step-1); padding-inline: var(--space-7); white-space: normal; }
  .num .st-flap { font-size: var(--step-3); padding: 0.1em 0.6em; }
  .stand { position: relative; margin: 0; display: grid; justify-items: center; align-items: end; min-inline-size: 0; }
  /* The arch is a window: the photo fills its width exactly and is trimmed to its shape, so a
     shoulder or an arm never crosses the brass, and where a photo was cropped at its side the
     crop lies on the frame's edge. */
  .arch {
    position: relative; display: block; overflow: hidden; inline-size: min(100%, 26rem);
    padding-block-start: 6%;
    border: 3px solid var(--st-brass); border-block-end: 0; border-radius: 50% 50% 0 0 / 34% 34% 0 0;
    background: radial-gradient(ellipse 60% 55% at 50% 55%, color-mix(in oklab, var(--st-brass-hi) 24%, transparent), transparent 70%);
  }
  .arch :global(.photo) { display: block; inline-size: 100%; block-size: auto; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .copy { padding-block-end: var(--space-4); align-items: center; text-align: center; }
    .stand { order: 2; }
  }
</style>
