---
// "The list's videos" on the night platform: each poster in a lit carriage window with a brass
// frame, the candidate's name and seat on the plate below, the whole row sliding like a passing
// train. With a video the picture plays it right there; the plate is the link (on the home page:
// the candidate's program file, named on the plate). soon: no video yet, a "قريبًا" badge.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { VideoData } from '@elections/data';
import Video from '@elections/Video.astro';
interface Props {
  ctx: PageContext;
  title: string;
  lead?: string;
  items: { name: string; seat: string; href: string; poster: ImageMetadata; cta: string; video?: VideoData; soon?: string }[];
}
const { title, lead, items } = Astro.props;
---
<section class="night st-glass">
  <div class="container wrap">
    <header class="head">
      <span class="st-sign st-rivets plate"><h2>{title}</h2></span>
      {lead && <p class="lead">{lead}</p>}
    </header>
    <ul class="row" role="list" tabindex="0" aria-label={title} data-st-train>
      {items.map((it, i) => (
        <li style={`--i:${i}`} class="item">
          {it.video ? (
            <div class="media"><Video video={it.video} widths={[384, 768]} sizes="(max-width: 600px) 80vw, 340px" /></div>
          ) : it.soon ? (
            <div class="media is-soon" role="img" aria-label={`${it.name} — ${it.soon}`}>
              <Image src={it.poster} alt="" widths={[384, 768]} sizes="(max-width: 600px) 80vw, 340px" />
              <span class="el-video__soon" aria-hidden="true">{it.soon}</span>
            </div>
          ) : (
            <a class="media" href={it.href} tabindex="-1" aria-hidden="true">
              <Image src={it.poster} alt="" widths={[384, 768]} sizes="(max-width: 600px) 80vw, 340px" />
              <span class="play"></span>
            </a>
          )}
          <a class="cap" href={it.href}>
            <h3>{it.name}</h3>
            <span class="seat">{it.seat}</span>
            <span class="more">{it.cta}<svg class="flip-rtl" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .night {
    margin-block: var(--space-8); padding-block: var(--space-8);
    background-color: var(--st-night); color: var(--st-enamel-ink);
    box-shadow: inset 0 5px 0 var(--st-brass), inset 0 -5px 0 var(--st-brass);
  }
  .wrap { display: flex; flex-direction: column; gap: var(--space-6); }
  .head { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center; }
  .plate { padding-inline: var(--space-8); }
  .plate h2 { font-size: var(--step-2); }
  .lead { font-size: var(--step-1); color: color-mix(in oklab, var(--st-enamel-ink) 88%, var(--st-night)); }
  .row {
    display: flex; gap: var(--space-5); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    padding-block: var(--space-2) var(--space-4); padding-inline: var(--space-1);
    scrollbar-color: var(--st-brass) var(--st-night-2);
  }
  .row:focus-visible { outline-offset: 6px; }
  .row > li { flex: 0 0 min(21rem, 84%); scroll-snap-align: start; }
  .item { display: flex; flex-direction: column; color: var(--st-enamel-ink); }
  .media {
    position: relative; display: block; padding: 8px; border-radius: calc(var(--radius-m) + 4px);
    background: linear-gradient(150deg, var(--st-brass-hi), var(--st-brass) 45%, var(--st-brass-lo));
    box-shadow: 0 24px 40px -24px color-mix(in oklab, var(--c-ink) 90%, transparent);
  }
  .media :global(img) { display: block; inline-size: 100%; aspect-ratio: 16 / 9; block-size: auto; object-fit: cover; border-radius: var(--radius-m); transition: filter var(--dur-base) var(--ease-out); }
  .media:hover :global(img) { filter: brightness(1.08); }
  .media :global(.el-video) { border-radius: var(--radius-m); overflow: hidden; }
  .media :global(.el-video__icon) { inline-size: 64px; block-size: 64px; }
  .play {
    position: absolute; inset: 0; margin: auto; inline-size: 64px; block-size: 64px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--st-brass-hi), var(--st-brass) 62%, var(--st-brass-lo));
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--c-ink) 35%, transparent);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .media:hover .play { transform: scale(1.1); }
  /* A play mark points right in every language, so this one icon uses a physical side. */
  .play::after { content: ''; position: absolute; inset: 0; margin: auto; inline-size: 0; block-size: 0; border-block: 11px solid transparent; border-left: 18px solid var(--c-ink); translate: 3px 0; }
  .cap {
    display: flex; flex-direction: column; gap: var(--space-1); flex: 1; color: inherit; text-decoration: none;
    margin-inline: 12px; padding: var(--space-4); border-radius: 0 0 var(--radius-m) var(--radius-m);
    background: var(--st-enamel); box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--st-brass) 60%, transparent);
  }
  h3 { font-size: var(--step-1); }
  .seat { font-size: var(--step-0); color: color-mix(in oklab, var(--st-enamel-ink) 86%, var(--st-enamel)); }
  .more { display: inline-flex; align-items: center; gap: var(--space-2); margin-block-start: auto; padding-block-start: var(--space-2); color: var(--st-brass-hi); font-family: var(--font-body); font-weight: 700; }
  .more svg { flex: none; transition: translate var(--dur-base) var(--ease-out); }
  .cap:hover .more { text-decoration: underline; text-underline-offset: 4px; }
  .cap:hover .more svg { translate: calc(var(--dir-x, -1) * 4px) 0; }
  :global([dir='ltr']) .cap { --dir-x: 1; }
  .media.is-soon :global(img) { filter: brightness(0.6) saturate(0.9); }
  .media :global(.el-video__soon) { position: absolute; inset-block: 0; inset-inline-end: 7%; margin-block: auto; inline-size: max-content; block-size: max-content; font-size: var(--step--1); padding-inline: var(--space-4); }
</style>
