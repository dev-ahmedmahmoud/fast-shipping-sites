---
// The list's program files as enamel platform signs hanging from brass chains: a platform
// number, the file's icon in a brass ring, its title and line. On arrival they swing gently
// to rest; on hover a sign lifts on its chains.
// layout "strip": on phones the signs become one sideways row (swipe, the next sign peeking in);
// "grid" (default) stacks them. Wider screens always show the grid.
import type { PageContext } from '@engine/context';
import type { FileCard } from '@elections/data';
interface Props { ctx: PageContext; title?: string; lead?: string; hint?: string; files: FileCard[]; layout?: 'grid' | 'strip' }
const { ctx, title, lead, hint, files, layout = 'grid' } = Astro.props;
---
<section class="section files">
  <div class="container wrap">
    {(title || lead || hint) && (
      <header class="st-title">
        {title && <span class="st-sign st-rivets plate"><h2>{title}</h2></span>}
        {lead && <p>{lead}</p>}
        {hint && <p class="hint">{hint}</p>}
      </header>
    )}
    <ul class:list={['grid', layout === 'strip' && 'strip']} role="list" tabindex={layout === 'strip' ? 0 : undefined} aria-label={layout === 'strip' ? title : undefined}>
      {files.map((f, i) => (
        <li data-st-swing style={`--i:${i}`}>
          <a class="sign" href={f.href}>
            <span class="no st-plate" aria-hidden="true">{ctx.fmt.number(i + 1)}</span>
            <span class="icon" aria-hidden="true" set:html={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.tagline}</p>
            <svg class="arrow flip-rtl" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* A sign at the edge of a phone screen swings a hair past it as it settles: clip that
     sideways (never down, so the shadows stay) rather than let the page scroll for a moment. */
  .files { overflow-x: clip; }
  .wrap { display: flex; flex-direction: column; gap: var(--space-7); }
  .plate { padding-inline: var(--space-8); }
  .plate h2 { font-size: var(--step-2); }
  .hint { font-size: var(--step-0); }
  /* Rows of up to four signs; a last row that isn't full is centred under the others. */
  .grid { --cols: 4; --gx: var(--space-5); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-7) var(--gx); padding-block-start: var(--space-5); }
  .grid > li { position: relative; display: flex; flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gx)) / var(--cols)); transform-origin: 50% calc(-1 * var(--space-5)); }
  @media (max-width: 1100px) { .grid { --cols: 3; } }
  @media (max-width: 820px) { .grid { --cols: 2; } }
  @media (max-width: 540px) { .grid { --cols: 1; } }
  /* The two chains the sign hangs from. */
  .grid > li::before, .grid > li::after {
    content: ''; position: absolute; inset-block-start: calc(-1 * var(--space-5)); block-size: var(--space-5); inline-size: 4px;
    background: repeating-linear-gradient(to bottom, var(--st-brass) 0 5px, transparent 5px 7px, var(--st-brass-lo) 7px 9px, transparent 9px 11px);
  }
  .grid > li::before { inset-inline-start: 22%; }
  .grid > li::after { inset-inline-end: 22%; }
  .sign {
    flex: 1; position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border-radius: var(--radius-m);
    background: linear-gradient(to bottom, color-mix(in oklab, var(--st-enamel) 88%, var(--st-enamel-ink)), var(--st-enamel) 30%, color-mix(in oklab, var(--st-enamel) 86%, var(--c-ink)));
    color: var(--st-enamel-ink); text-decoration: none;
    box-shadow: inset 0 0 0 5px var(--st-enamel), inset 0 0 0 7px color-mix(in oklab, var(--st-enamel-ink) 80%, transparent), 0 0 0 2px var(--st-brass), var(--st-shadow);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .sign:hover { transform: translateY(-6px); box-shadow: inset 0 0 0 5px var(--st-enamel), inset 0 0 0 7px var(--st-brass-hi), 0 0 0 2px var(--st-brass), 0 24px 40px -18px color-mix(in oklab, var(--c-ink) 60%, transparent); }
  .sign:focus-visible { outline-offset: 6px; }
  .no { position: absolute; inset-block-start: var(--space-4); inset-inline-end: var(--space-4); font-size: var(--step-0); }
  .icon {
    display: grid; place-items: center; inline-size: 64px; block-size: 64px; padding: 14px; border-radius: 50%;
    border: 2px solid var(--st-brass); color: var(--st-brass-hi);
    background: color-mix(in oklab, var(--st-enamel) 80%, var(--c-ink));
  }
  .icon :global(svg) { inline-size: 100%; block-size: 100%; }
  /* Large enough for the sign lettering. */
  h3 { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--step-2); line-height: var(--lh-heading); }
  .sign p { font-size: var(--step-0); color: color-mix(in oklab, var(--st-enamel-ink) 90%, var(--st-enamel)); }
  .arrow { margin-block-start: auto; color: var(--st-brass-hi); transition: translate var(--dur-base) var(--ease-out); }
  .sign:hover .arrow { translate: calc(var(--dir-x, -1) * 6px) 0; }
  :global([dir='ltr']) .sign { --dir-x: 1; }

  /* Phones, strip layout: one row that scrolls sideways, edge to edge, each sign snapping to the
     start with the next one peeking in. Room above for the chains and below for the shadows. */
  @media (max-width: 700px) {
    .strip {
      display: flex; flex-wrap: nowrap; justify-content: flex-start; gap: var(--space-4);
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--gutter)); padding: var(--space-6) var(--gutter) var(--space-5);
      scroll-padding-inline: var(--gutter); scrollbar-width: none;
    }
    .strip::-webkit-scrollbar { display: none; }
    .strip > li { flex: 0 0 min(78vw, 19rem); scroll-snap-align: start; }
    .strip:focus-visible { outline-offset: -4px; }
  }
</style>
