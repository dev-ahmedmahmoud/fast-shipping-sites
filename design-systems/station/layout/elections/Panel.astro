---
// A reading column for page bodies (a bio, a program file's text) and for the engine's widgets
// (supporters' app, complaints form): large Naskh on card stock, headings as small enamel
// plates, list markers in brass. Body HTML arrives in the slot.
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext; id?: string; label?: string }
const { id, label } = Astro.props;
---
<section class="section" id={id} aria-label={label}>
  <div class="container narrow">
    <div class="prose"><slot /></div>
  </div>
</section>

<style>
  .narrow { max-inline-size: calc(48rem + 2 * var(--gutter)); }
  .prose { min-inline-size: 0; font-size: var(--step-0); line-height: 1.95; }
  .prose :global(> * + *) { margin-block-start: var(--space-4); }
  .prose :global(h2) {
    display: table; font-size: var(--step-2); margin-block-start: var(--space-7);
    padding: var(--space-1) var(--space-5); border-radius: var(--radius-s);
    background: var(--st-enamel); color: var(--st-enamel-ink);
    box-shadow: inset 0 0 0 3px var(--st-enamel), inset 0 0 0 4px color-mix(in oklab, var(--st-enamel-ink) 70%, transparent), 0 3px 0 var(--st-brass);
  }
  .prose :global(h2:first-child) { margin-block-start: 0; }
  .prose :global(h3) { font-size: var(--step-1); margin-block-start: var(--space-6); color: var(--st-enamel); }
  .prose :global(ul), .prose :global(ol) { padding-inline-start: var(--space-6); }
  .prose :global(li + li) { margin-block-start: var(--space-3); }
  .prose :global(li > ul) { margin-block-start: var(--space-2); }
  .prose :global(ul > li::marker) { content: '◆  '; color: var(--st-brass); font-size: 0.8em; }
  .prose :global(ol > li::marker) { color: var(--st-brass-lo); font-family: var(--font-display); font-weight: 700; }
  .prose :global(blockquote) { margin-inline: 0; padding: var(--space-3) var(--space-5); border-inline-start: 5px solid var(--st-brass); background: var(--c-surface); border-radius: var(--radius-s); color: var(--c-ink); }
  .prose :global(strong) { color: var(--st-enamel); }
  .prose :global(img) { border-radius: var(--radius-m); }
  .prose :global(table) { border-collapse: collapse; inline-size: 100%; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--c-line); padding: var(--space-2) var(--space-3); text-align: start; }
</style>
