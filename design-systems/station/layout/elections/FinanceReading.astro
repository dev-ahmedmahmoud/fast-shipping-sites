<script>
  // The chapters as tabs: one open at a time, arrow keys move between tabs (mirrored in RTL),
  // Home/End jump to the ends; a chapter's bars grow as it opens.
  document.querySelectorAll<HTMLElement>('[data-fin]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`));
    if (!tabs.length) return;
    const show = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const p = panels[k];
        if (!p) return;
        p.hidden = !on;
        p.classList.toggle('is-in', on);
        p.classList.remove('is-shown');
      });
      const p = panels[i];
      if (p) requestAnimationFrame(() => requestAnimationFrame(() => p.classList.add('is-shown')));
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        const rtl = getComputedStyle(root).direction === 'rtl';
        const next = rtl ? 'ArrowLeft' : 'ArrowRight';
        const prev = rtl ? 'ArrowRight' : 'ArrowLeft';
        let k = -1;
        if (e.key === next) k = (i + 1) % tabs.length;
        else if (e.key === prev) k = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') k = 0;
        else if (e.key === 'End') k = tabs.length - 1;
        if (k < 0) return;
        e.preventDefault();
        show(k, true);
      });
    });
    root.classList.add('is-ready');
    // The first chapter's bars grow when the section comes into view.
    const first = panels[0];
    if (first && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((x) => x.isIntersecting)) { first.classList.add('is-shown'); io.disconnect(); }
      }, { threshold: 0.2 });
      io.observe(first);
    } else first?.classList.add('is-shown');
  });
</script>
