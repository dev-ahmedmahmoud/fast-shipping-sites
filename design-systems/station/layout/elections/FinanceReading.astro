  .phase h4 { font-size: var(--step-1); color: var(--c-accent); }
  .phase ul { display: grid; gap: var(--space-1); margin: 0; padding: 0; list-style: none; }
  .phase ul li { position: relative; padding-inline-start: 1.1em; line-height: 1.7; }
