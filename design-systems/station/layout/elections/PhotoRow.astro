---
// A row of portraits hung like framed photographs in the waiting room: brass frame, an ivory
// mat, scrolling sideways.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext; photos: ImageMetadata[]; alt: string; label: string; hint?: string }
const { photos, alt, label, hint } = Astro.props;
---
<section class="section" aria-label={label}>
  <div class="container">
    <div class="row" tabindex="0" role="group" aria-label={hint ?? label}>
      {photos.map((p) => (
        <figure><Image src={p} alt={alt} widths={[320, 640]} sizes="(max-width: 600px) 70vw, 320px" /></figure>
      ))}
    </div>
  </div>
</section>

<style>
  .row { display: flex; gap: var(--space-5); overflow-x: auto; scroll-snap-type: x mandatory; padding-block: var(--space-2) var(--space-4); padding-inline: var(--space-1); scrollbar-color: var(--st-brass) var(--c-sunk); }
  .row:focus-visible { outline-offset: 6px; }
  figure {
    margin: 0; flex: 0 0 auto; scroll-snap-align: start; padding: 10px;
    border-radius: var(--radius-s);
    background: linear-gradient(150deg, var(--st-brass-hi), var(--st-brass) 45%, var(--st-brass-lo));
    box-shadow: var(--st-shadow);
  }
  figure :global(img) {
    display: block; block-size: min(26rem, 60vh); inline-size: auto;
    border: 10px solid var(--c-surface); background: var(--c-sunk);
  }
</style>
