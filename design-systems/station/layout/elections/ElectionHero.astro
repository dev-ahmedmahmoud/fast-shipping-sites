---
// The list's home hero: the great hall of the station at night. Iron roof arches and glass
// overhead, two shafts of light, slow steam; the election's name on an enamel sign, the list's
// name in the light, and the team standing on the platform under a brass arch with the
// club's crest as its keystone. Steam and light only move on capable devices while in view.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
interface Props {
  ctx: PageContext;
  title: string;
  slogan: string;
  sub: string;
  actions: Action[];
  image: ImageMetadata | null;
  imageAlt: string;
  crest: ImageMetadata | null;
}
const { title, slogan, sub, actions, image, imageAlt, crest } = Astro.props;
// Roof ribs radiating from the arch's spring points.
const ribs = Array.from({ length: 9 }, (_, i) => i);
---
<section class="hall st-glass" data-st-ambient>
  <svg class="roof" viewBox="0 0 1200 360" preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false">
    <path d="M-40 360 A640 330 0 0 1 1240 360" />
    <path d="M40 360 A560 280 0 0 1 1160 360" />
    {ribs.map((i) => {
      const a = Math.PI * (0.1 + (i * 0.8) / 8);
      return <path d={`M600 360 L${(600 - Math.cos(a) * 640).toFixed(1)} ${(360 - Math.sin(a) * 330).toFixed(1)}`} />;
    })}
  </svg>
  <span class="beam b1" aria-hidden="true"></span>
  <span class="beam b2" aria-hidden="true"></span>
  <span class="steam s1" aria-hidden="true"></span>
  <span class="steam s2" aria-hidden="true"></span>
  <span class="steam s3" aria-hidden="true"></span>

  <div class="container grid">
    <div class="copy">
      <p class="st-sign st-rivets sign" data-st-swing>{sub}</p>
      <h1 data-split-words>{title}</h1>
      <p class="slogan"><span>{slogan}</span></p>
      <div class="actions">
        {actions.map((a, i) => (
          <a class:list={['btn', i === 0 ? 'btn--brass' : 'btn--ghost']} href={a.href}>{a.label}</a>
        ))}
      </div>
    </div>

    {image && (
      <figure class="platform">
        <span class="arch" aria-hidden="true">
          {crest && <Image class="keystone" src={crest} alt="" height={96} loading="eager" />}
        </span>
        <Image class="team" src={image} alt={imageAlt} widths={[640, 960, 1397]} sizes="(max-width: 900px) 100vw, 52vw" loading="eager" fetchpriority="high" />
        <span class="edge" aria-hidden="true"></span>
      </figure>
    )}
  </div>
</section>

<style>
  .hall {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: var(--space-8) 0;
    background-color: var(--st-night); color: var(--st-enamel-ink);
    background-image:
      radial-gradient(ellipse 70% 60% at 50% 0%, color-mix(in oklab, var(--st-brass-hi) 16%, transparent), transparent 70%),
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--st-enamel-ink) 6%, transparent) 0 1px, transparent 1px 96px),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--st-enamel-ink) 5%, transparent) 0 1px, transparent 1px 64px);
  }
  .roof { position: absolute; z-index: -1; inset-inline: 0; inset-block-start: 0; inline-size: 100%; block-size: min(70%, 420px); fill: none; stroke: color-mix(in oklab, var(--st-brass) 32%, transparent); stroke-width: 1.5; }
  .beam {
    position: absolute; z-index: -1; inset-block-start: -60px; block-size: calc(100% + 120px); inline-size: 22%;
    background: linear-gradient(to bottom, color-mix(in oklab, var(--st-brass-hi) 20%, transparent), transparent 75%);
    clip-path: polygon(38% 0, 62% 0, 100% 100%, 0 100%);
    opacity: 0.6; pointer-events: none; transform-origin: 50% 0;
  }
  .b1 { inset-inline-start: 18%; rotate: 8deg; }
  .b2 { inset-inline-start: 46%; rotate: -6deg; inline-size: 16%; opacity: 0.45; }
  .steam {
    position: absolute; z-index: -1; inset-block-end: 10%; inline-size: 34vmax; block-size: 22vmax; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--st-enamel-ink) 14%, transparent), transparent);
    filter: blur(8px); opacity: 0; pointer-events: none;
  }
  .s1 { inset-inline-end: -8%; }
  .s2 { inset-inline-end: 22%; inset-block-end: 2%; }
  .s3 { inset-inline-start: -10%; inset-block-end: 26%; }
  :global(.st-rich) .hall.st-live .beam { animation: st-sway 14s var(--ease-in-out) infinite alternate; }
  :global(.st-rich) .hall.st-live .steam { animation: st-steam 16s linear infinite; }
  :global(.st-rich) .hall.st-live .s2 { animation-delay: -6s; }
  :global(.st-rich) .hall.st-live .s3 { animation-delay: -11s; }
  @keyframes st-sway { to { rotate: var(--to, 2deg); } }
  .b1 { --to: 3deg; }
  .b2 { --to: -2deg; }
  @keyframes st-steam {
    0% { opacity: 0; transform: translate3d(0, 20%, 0) scale(0.8); }
    25% { opacity: 0.9; }
    100% { opacity: 0; transform: translate3d(0, -60%, 0) scale(1.35); }
  }

  .grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: var(--space-6); align-items: end; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); min-inline-size: 0; padding-block-end: var(--space-8); align-self: center; }
  .sign { font-family: var(--font-body); font-size: var(--step-0); font-weight: 700; padding-inline: var(--space-7); max-inline-size: 100%; white-space: normal; text-align: center; }
  h1 { font-size: var(--step-5); line-height: 1.3; }
  .slogan { font-family: var(--font-display); font-size: var(--step-2); color: var(--st-brass-hi); }
  .slogan span { background: linear-gradient(var(--st-brass) 0 0) bottom / 100% 2px no-repeat; padding-block-end: 0.2em; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block-start: var(--space-2); }
  .actions .btn--ghost { color: var(--st-enamel-ink); }

  .platform { position: relative; margin: 0; display: grid; align-items: end; justify-items: center; min-inline-size: 0; }
  .arch {
    position: absolute; inset-inline: 6%; inset-block: 2% 6%;
    border: 3px solid var(--st-brass); border-block-end: 0;
    border-radius: 50% 50% 0 0 / 34% 34% 0 0;
    background: radial-gradient(ellipse 60% 55% at 50% 60%, color-mix(in oklab, var(--st-brass-hi) 26%, transparent), transparent 70%);
    box-shadow: inset 0 0 0 10px color-mix(in oklab, var(--st-night) 70%, transparent), inset 0 0 0 12px color-mix(in oklab, var(--st-brass) 45%, transparent);
  }
  .arch :global(.keystone) {
    position: absolute; inset-block-start: -2px; inset-inline-start: 50%; translate: 50% -50%; block-size: 76px; inline-size: auto;
    filter: drop-shadow(0 6px 10px color-mix(in oklab, var(--c-ink) 60%, transparent));
  }
  :global([dir='ltr']) .arch :global(.keystone) { translate: -50% -50%; }
  .platform :global(.team) { position: relative; inline-size: 100%; block-size: auto; padding-block-start: 12%; }
  .edge {
    position: relative; inline-size: 112%; block-size: 26px; margin-block-start: -4px;
    background:
      linear-gradient(var(--st-brass) 0 0) top / 100% 4px no-repeat,
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--st-enamel-ink) 22%, var(--st-night)) 0 46px, color-mix(in oklab, var(--st-enamel-ink) 12%, var(--st-night)) 46px 48px);
    box-shadow: 0 -18px 30px -12px color-mix(in oklab, var(--c-ink) 60%, transparent);
  }

  /* Desktop: centre stage. The sign, name, slogan and buttons sit centred on top; the team
     stands large across the middle under the arch, and the countdown board below rises in
     front of them (it covers the waist line, so the half-body photo reads as standing behind
     the board). */
  @media (min-width: 901px) {
    .hall { padding-block: var(--space-7) 0; }
    .grid { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; gap: var(--space-4); }
    .copy { align-items: center; padding-block-end: 0; }
    h1 { font-size: clamp(2.6rem, 1.8rem + 2.6vw, 4.2rem); }
    .actions { justify-content: center; }
    .platform { inline-size: min(100%, 980px); margin-block-start: var(--space-3); }
    .arch { inset: 14% 10% 0 10%; }
    .platform :global(.team) { padding-block-start: 6%; }
    .edge { display: none; }
    .hall + :global(.count-wrap) :global(.board) { margin-block-start: -120px; }
  }

  /* Phones and tablets: the team must be on screen at first load. The copy's parts become grid
     items so the photo can sit between the slogan and the buttons (sign, name, slogan, team,
     buttons), with tighter spacing and the photo running edge to edge. */
  @media (max-width: 900px) {
    .hall { padding-block-start: var(--space-5); }
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); justify-items: center; text-align: center; }
    .copy { display: contents; }
    .sign { order: 1; font-size: var(--step--1); padding: var(--space-2) var(--space-6); }
    h1 { order: 2; font-size: var(--step-4); line-height: 1.25; }
    .slogan { order: 3; font-size: var(--step-1); }
    .platform { order: 4; inline-size: calc(100% + 2 * var(--gutter)); margin-inline: calc(-1 * var(--gutter)); margin-block-start: var(--space-2); }
    .platform :global(.team) { padding-block-start: 9%; }
    .arch :global(.keystone) { block-size: 56px; }
    /* The countdown below rises into the hall by --space-6, so leave that plus a real gap. */
    .actions { order: 5; inline-size: 100%; justify-content: center; margin: 0; padding-block: var(--space-4) calc(var(--space-6) * 2); }
    .actions .btn { flex: 1 1 15rem; }
  }
</style>
