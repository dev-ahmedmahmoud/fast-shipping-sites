---
// The list's leader, like the portrait of a station master in the booking hall: his seat on
// an enamel tag, his portrait in a brass medallion, his line, and his word (a video) framed
// as a carriage window.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { VideoData } from '@elections/data';
import Video from '@elections/Video.astro';
interface Props {
  ctx: PageContext;
  kicker: string;
  name: string;
  text: string;
  more: { label: string; href: string };
  video: VideoData | null;
  photo: ImageMetadata;
}
const { kicker, name, text, more, video, photo } = Astro.props;
---
<section class="section leader" id="leader" aria-labelledby="el-leader-title">
  <div class="container grid">
    <div class="copy" data-st-reveal>
      <div class="who">
        <span class="medal" aria-hidden="true"><Image src={photo} alt="" widths={[160, 320]} sizes="128px" /></span>
        <div class="names">
          <p class="st-sign kicker">{kicker}</p>
          <h2 id="el-leader-title">{name}</h2>
        </div>
      </div>
      <p class="text">{text}</p>
      <a class="btn btn--primary" href={more.href}>{more.label}</a>
    </div>
    {video && (
      <div class="window" data-st-reveal>
        <Video video={video} showCaption sizes="(max-width: 900px) 100vw, 55vw" />
      </div>
    )}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-7); align-items: center; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); min-inline-size: 0; }
  .who { display: flex; align-items: center; gap: var(--space-4); }
  .medal {
    flex: 0 0 auto; display: block; inline-size: 128px; block-size: 128px; border-radius: 50%; overflow: hidden;
    background: radial-gradient(circle at 50% 35%, var(--c-accent-soft), var(--c-sunk));
    box-shadow: 0 0 0 4px var(--st-brass), 0 0 0 8px var(--c-bg), 0 0 0 10px color-mix(in oklab, var(--st-brass) 55%, transparent), var(--st-shadow);
  }
  .medal :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 8%; }
  .names { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); min-inline-size: 0; }
  .kicker { font-family: var(--font-body); font-weight: 700; font-size: var(--step--1); padding: var(--space-1) var(--space-4); }
  h2 { font-size: var(--step-4); color: var(--st-enamel); }
  .text { font-size: var(--step-1); line-height: 1.85; max-inline-size: 40ch; }
  /* A brass carriage-window frame with a rivet in each corner (the corners are symmetric,
     so their physical positions read the same in both directions). */
  .window {
    --rivet: radial-gradient(circle, var(--st-brass-lo) 0 3px, color-mix(in oklab, var(--st-brass-hi) 60%, transparent) 3.5px, transparent 4.5px);
    position: relative; min-inline-size: 0; padding: 14px;
    border-radius: calc(var(--radius-l) + 6px);
    background:
      var(--rivet) left 2px top 2px / 12px 12px no-repeat,
      var(--rivet) right 2px top 2px / 12px 12px no-repeat,
      var(--rivet) left 2px bottom 2px / 12px 12px no-repeat,
      var(--rivet) right 2px bottom 2px / 12px 12px no-repeat,
      linear-gradient(150deg, var(--st-brass-hi), var(--st-brass) 40%, var(--st-brass-lo));
    box-shadow: var(--st-shadow), 0 40px 60px -40px color-mix(in oklab, var(--c-ink) 70%, transparent);
  }
  .window :global(.el-video) { border-radius: var(--radius-l); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .medal { inline-size: 96px; block-size: 96px; }
  }
</style>
