---
// A program file's plan (elections.json files[].plan), built to be grasped at a glance rather
// than read as a wall of text: a "file at a glance" box (how many initiatives, a jump chip per
// part, "show all details"), each part's vision as a navy quote card, then the initiatives as
// numbered stops on a gold line (zig-zag on computers, one column on phones). A stop shows its
// title and two or three key phrases taken from its own text; the full text (word for word, as
// the candidates wrote it) opens on a tap.
// An initiative may carry labelled sections (a project's scope, components, location, funding,
// revenue), each with an icon; funding sections are tinted gold, notes are gold-edged callouts,
// short lists become chips and numbered lists gold numbers. plan.restart numbers each part from
// one (the strategy page) instead of continuing across parts.
import type { PageContext } from '@engine/context';
import { formatNumber } from '@engine/i18n';
interface Section { label?: string; text?: string; points?: string[]; ordered?: boolean; note?: boolean }
interface Item { title: string; tags?: string[]; lead?: string; text?: string; points?: string[]; tail?: string; sections?: Section[]; link?: { label: string; href: string } | null }
interface Group { title?: string; intro?: string[]; vision?: string[]; items: Item[]; closing?: string }
interface Words { glance: string; count: Record<string, string>; vision: string; more: string; all: string; none: string; parts: string }
interface Props { ctx: PageContext; plan: { groups: Group[]; restart?: boolean }; words: Words }
const { ctx, plan, words } = Astro.props;
const loc = ctx.locale;
const fmt = (n: number) => formatNumber(n, loc);
const groups = plan.groups.filter((g) => g.items?.length);
const total = groups.reduce((n, g) => n + g.items.length, 0);
const countWord = words.count[new Intl.PluralRules(loc).select(total)] ?? words.count.other;
// Continuous numbering across the parts, like stops along one line (or from one in each part).
const starts = groups.map((_, i) => (plan.restart ? 0 : groups.slice(0, i).reduce((n, g) => n + g.items.length, 0)));
// A section's icon, by what its label is about.
const ICON: Record<string, string> = {
  fund: '<circle cx="9" cy="9" r="6"/><path d="M15.5 9.5a6 6 0 1 1-6 6"/><path d="M9 6.5v5M7 8h3a1 1 0 0 1 0 2H8a1 1 0 0 0 0 2h3"/>',
  place: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  gain: '<path d="M3 17l6-6 4 4 7-8"/><path d="M14 7h6v6"/>',
  deal: '<path d="M8 3h7l4 4v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5M10 13h6M10 17h4"/>',
  list: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
};
const iconOf = (label = '') => (label.includes('التعاقد') ? ICON.deal : label.includes('التمويل') ? ICON.fund : label.includes('الموقع') ? ICON.place : label.includes('العائد') ? ICON.gain : ICON.list);
const isFund = (label = '') => label.includes('التمويل');
// Short items read best as chips (without their closing full stop).
const short = (pts: string[]) => pts.length > 1 && pts.every((p) => p.length <= 42);
const chip = (p: string) => p.replace(/[.،]\s*$/, '');
const many = groups.length > 1;
---
<section class="section plan" data-plan>
  <div class="container">
    <div class="glance">
      <p class="glance__count"><b>{fmt(total)}</b><span>{countWord}</span></p>
      <div class="glance__mid">
        <p class="glance__label">{words.glance}</p>
        {many ? (
          <nav class="glance__parts" aria-label={words.parts}>
            {groups.map((g, i) => (
              <a href={`#part-${i + 1}`}><span class="glance__no">{fmt(i + 1)}</span>{g.title}<small>{fmt(g.items.length)}</small></a>
            ))}
          </nav>
        ) : (
          <ul class="glance__titles" role="list">
            {groups[0].items.map((it) => <li>{it.title}</li>)}
          </ul>
        )}
      </div>
      <button type="button" class="btn btn--brass glance__all" data-plan-all data-all={words.all} data-none={words.none} aria-pressed="false">{words.all}</button>
    </div>

    {groups.map((g, i) => (
      <section class="part" id={`part-${i + 1}`} aria-labelledby={g.title ? `part-${i + 1}-title` : undefined}>
        {(g.title || g.intro || g.vision) && (
          <header class="part__head">
            {g.title && (
              <h2 class="part__title" id={`part-${i + 1}-title`}>
                {many && <span class="part__no" aria-hidden="true">{fmt(i + 1)}</span>}
                <span>{g.title}</span>
              </h2>
            )}
            {g.intro?.map((p) => <p class="part__intro">{p}</p>)}
            {g.vision?.length && (
              <figure class="vision">
                <figcaption>{words.vision}</figcaption>
                <blockquote>{g.vision.map((p) => <p>{p}</p>)}</blockquote>
              </figure>
            )}
          </header>
        )}
        <ol class="line" role="list">
          {g.items.map((it, k) => (
            <li class="stop">
              <span class="num" aria-hidden="true">{fmt(starts[i] + k + 1)}</span>
              <details class="card">
                <summary>
                  <span class="card__head">
                    <h3 class="card__title">{it.title}</h3>
                    {it.tags?.length ? <span class="tags">{it.tags.map((t) => <span class="tag">{t}</span>)}</span> : null}
                  </span>
                  <span class="card__more" aria-hidden="true">{words.more}<svg viewBox="0 0 24 24" width="18" height="18"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                </summary>
                <div class="card__body">
                  {it.lead && <p class="card__lead">{it.lead}</p>}
                  {it.text && <p>{it.text}</p>}
                  {it.points?.length ? <ul class="checks" role="list">{it.points.map((p) => <li>{p}</li>)}</ul> : null}
                  {it.sections?.map((sec) => (
                    <div class:list={['sec', sec.note && 'sec--note', isFund(sec.label) && 'sec--fund']}>
                      {sec.label && <h4 class="sec__label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconOf(sec.label)} />{sec.label}</h4>}
                      {sec.text && <p>{sec.text}</p>}
                      {sec.points?.length ? (
                        sec.ordered
                          ? <ol class:list={['nums', short(sec.points) && 'nums--grid']} role="list">{sec.points.map((p, n) => <li><span class="nums__n" aria-hidden="true">{fmt(n + 1)}</span><span>{p}</span></li>)}</ol>
                          : short(sec.points)
                            ? <ul class="chips" role="list">{sec.points.map((p) => <li>{chip(p)}</li>)}</ul>
                            : <ul class="checks" role="list">{sec.points.map((p) => <li>{p}</li>)}</ul>
                      ) : null}
                    </div>
                  ))}
                  {it.tail && <p class="card__tail">{it.tail}</p>}
                  {it.link && <a class="card__link" href={it.link.href}>{it.link.label}<svg class="flip-rtl" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>}
                </div>
              </details>
            </li>
          ))}
        </ol>
        {g.closing && <p class="closing">{g.closing}</p>}
      </section>
    ))}
  </div>
</section>

<script>
  // "Show all details" opens or closes every initiative of the plan; it follows hand toggles too.
  document.querySelectorAll<HTMLElement>('[data-plan]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-plan-all]');
    const cards = [...root.querySelectorAll<HTMLDetailsElement>('details.card')];
    if (!btn || !cards.length) return;
    const sync = () => {
      const all = cards.every((c) => c.open);
      btn.setAttribute('aria-pressed', String(all));
      btn.textContent = (all ? btn.dataset.none : btn.dataset.all) ?? '';
    };
    btn.addEventListener('click', () => {
      const open = !cards.every((c) => c.open);
      cards.forEach((c) => { c.open = open; });
      sync();
    });
    cards.forEach((c) => c.addEventListener('toggle', sync));
  });
</script>

<style>
  .plan { --rail: 4px; --dot: 46px; }

  /* ---- the file at a glance ---- */
  .glance {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-5);
    padding: var(--space-5) var(--space-6); border-radius: 20px;
    background: var(--c-surface); border: 1px solid color-mix(in oklab, var(--st-brass) 40%, var(--c-line));
    box-shadow: 0 18px 40px -26px color-mix(in oklab, var(--st-night) 70%, transparent);
  }
  .glance__count {
    display: grid; place-items: center; align-content: center; inline-size: 7.5rem; aspect-ratio: 1; border-radius: 50%;
    background: var(--st-night-grad); color: var(--st-enamel-ink);
    box-shadow: inset 0 0 0 4px var(--st-night), inset 0 0 0 6px var(--st-brass), 0 12px 24px -12px color-mix(in oklab, var(--st-night) 80%, transparent);
    text-align: center; line-height: 1.1;
  }
  .glance__count b { font-family: var(--font-display); font-size: 2.6rem; color: var(--st-brass-hi); }
  .glance__count span { font-weight: 700; font-size: var(--step--1); }
  .glance__label { font-weight: 800; color: var(--c-accent); margin-block-end: var(--space-2); }
  .glance__parts { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .glance__parts a {
    display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 44px; padding: 0.3em 0.9em 0.3em 0.5em;
    border-radius: 999px; background: color-mix(in oklab, var(--st-brass-hi) 30%, var(--c-surface)); color: var(--c-ink);
    font-weight: 700; font-size: var(--step--1); text-decoration: none; border: 1px solid color-mix(in oklab, var(--st-brass) 45%, transparent);
  }
  :global([dir='rtl']) .glance__parts a { padding: 0.3em 0.5em 0.3em 0.9em; }
  .glance__parts a:hover { background: color-mix(in oklab, var(--st-brass-hi) 50%, var(--c-surface)); }
  .glance__parts small { font-weight: 800; color: var(--st-brass-lo); }
  .glance__no { display: grid; place-items: center; inline-size: 1.8em; block-size: 1.8em; border-radius: 50%; background: var(--st-night); color: var(--st-brass-hi); font-size: 0.85em; }
  .glance__titles { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); margin: 0; padding: 0; list-style: none; color: var(--c-muted); font-size: var(--step--1); font-weight: 600; }
  .glance__titles li::before { content: '◆'; margin-inline-end: 0.45em; color: var(--st-brass); font-size: 0.7em; vertical-align: 0.15em; }
  .glance__all { white-space: nowrap; }

  /* ---- a part: title, intro, vision ---- */
  .part { margin-block-start: var(--space-8); scroll-margin-block-start: 120px; }
  .part__head { display: grid; justify-items: center; gap: var(--space-3); text-align: center; max-inline-size: 52rem; margin: 0 auto var(--space-6); }
  .part__title { display: inline-flex; align-items: center; gap: var(--space-3); font-size: var(--step-2); color: var(--c-accent); text-wrap: balance; }
  .part__no { flex: none; display: grid; place-items: center; inline-size: 2.2em; block-size: 2.2em; border-radius: 50%; font-size: 0.7em; background: var(--st-gold); color: var(--st-night); box-shadow: 0 6px 14px -8px color-mix(in oklab, var(--c-ink) 70%, transparent); }
  .part__title::after { content: none; }
  .part__intro { color: var(--c-muted); font-size: var(--step-0); line-height: 1.9; max-inline-size: 60ch; }
  .vision {
    position: relative; margin: var(--space-2) 0 0; inline-size: 100%; padding: var(--space-6) var(--space-6) var(--space-5);
    border-radius: 20px; background: var(--st-night-grad); color: var(--st-enamel-ink); text-align: start;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--st-brass) 50%, transparent), 0 20px 40px -24px color-mix(in oklab, var(--st-night) 80%, transparent);
    overflow: hidden;
  }
  .vision::before {
    content: '”'; position: absolute; inset-block-start: -0.18em; inset-inline-end: 0.12em; font-family: Georgia, 'Times New Roman', serif;
    font-size: 9rem; line-height: 1; color: color-mix(in oklab, var(--st-brass) 55%, transparent); pointer-events: none;
  }
  .vision figcaption {
    display: inline-block; margin-block-end: var(--space-3); padding: 0.15em 0.9em; border-radius: 999px;
    background: var(--st-gold); color: var(--st-night); font-weight: 800; font-size: var(--step--1);
  }
  .vision blockquote { margin: 0; display: grid; gap: var(--space-3); font-size: var(--step-1); line-height: 1.85; }

  /* ---- the line of initiatives ---- */
  .line { position: relative; display: grid; gap: var(--space-4); margin: 0 auto; padding: 0; list-style: none; max-inline-size: 72rem; }
  .line::before {
    content: ''; position: absolute; inset-block: calc(var(--dot) / 2) calc(var(--dot) / 2); inset-inline-start: calc(var(--dot) / 2 - var(--rail) / 2);
    inline-size: var(--rail); border-radius: var(--rail);
    background: linear-gradient(to bottom, var(--st-brass-hi), var(--st-brass) 50%, var(--st-brass-lo));
  }
  .stop { position: relative; padding-inline-start: calc(var(--dot) + var(--space-3)); min-inline-size: 0; }
  .num {
    position: absolute; inset-inline-start: 0; inset-block-start: 10px; z-index: 1;
    display: grid; place-items: center; inline-size: var(--dot); block-size: var(--dot); border-radius: 50%;
    background: var(--st-night); color: var(--st-brass-hi); font-family: var(--font-display); font-size: 1.15rem; font-weight: 800;
    box-shadow: 0 0 0 3px var(--c-bg), 0 0 0 6px var(--st-brass), 0 8px 16px -8px color-mix(in oklab, var(--c-ink) 70%, transparent);
  }

  .card {
    border-radius: 16px; background: var(--c-surface); overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--st-brass) 32%, var(--c-line));
    box-shadow: 0 1px 0 color-mix(in oklab, var(--c-ink) 5%, transparent), 0 14px 30px -22px color-mix(in oklab, var(--st-night) 70%, transparent);
    transition: box-shadow var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .card:hover { border-color: color-mix(in oklab, var(--st-brass) 65%, var(--c-line)); }
  .card[open] { border-color: var(--st-brass); box-shadow: inset 0 3px 0 var(--st-brass), 0 22px 40px -24px color-mix(in oklab, var(--st-night) 75%, transparent); }
  summary { display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-4) var(--space-5); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 3px solid var(--st-brass); outline-offset: -3px; border-radius: 16px; }
  .card__head { flex: 1; min-inline-size: 0; }
  .card__title { font-family: var(--font-body); font-weight: 800; font-size: 1.12rem; line-height: 1.5; color: var(--c-accent); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-block-start: var(--space-2); }
  .tag {
    padding: 0.15em 0.75em; border-radius: 999px; font-size: 0.82rem; font-weight: 700; line-height: 1.6;
    background: color-mix(in oklab, var(--st-brass-hi) 32%, var(--c-surface)); color: color-mix(in oklab, var(--st-brass-lo) 55%, var(--c-ink));
  }
  .card__more { flex: none; display: inline-flex; align-items: center; gap: 2px; margin-block-start: 0.2em; font-size: 0.85rem; font-weight: 700; color: var(--st-brass-lo); }
  .card__more svg { transition: rotate var(--dur-fast) var(--ease-out); }
  .card[open] .card__more svg { rotate: 180deg; }
  .card__body {
    display: grid; gap: var(--space-3); padding: var(--space-4) var(--space-5) var(--space-5);
    border-block-start: 1px dashed color-mix(in oklab, var(--st-brass) 40%, var(--c-line));
    font-size: var(--step-0); line-height: 1.95; color: var(--c-ink);
  }
  .card[open] .card__body { animation: plan-in 0.28s var(--ease-out); }
  .card__lead { font-weight: 700; color: var(--c-accent); }
  .card__tail { color: var(--c-muted); }
  .checks { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .checks li { position: relative; padding-inline-start: 2rem; }
  .checks li::before {
    content: ''; position: absolute; inset-inline-start: 0; inset-block-start: 0.45em; inline-size: 1.25rem; block-size: 1.25rem; border-radius: 50%;
    background: var(--st-gold) ;
    -webkit-mask: radial-gradient(circle, #000 68%, transparent 70%); mask: radial-gradient(circle, #000 68%, transparent 70%);
  }
  .checks li::after {
    content: ''; position: absolute; inset-inline-start: 0.42rem; inset-block-start: calc(0.45em + 0.3rem); inline-size: 0.42rem; block-size: 0.62rem;
    border: solid var(--st-night); border-width: 0 2.5px 2.5px 0; rotate: 45deg;
  }
  @keyframes plan-in { from { opacity: 0; transform: translateY(-4px); } }

  /* ---- labelled sections inside an initiative (strategy projects) ---- */
  .sec { display: grid; gap: var(--space-2); }
  .sec__label {
    display: flex; align-items: center; gap: var(--space-2); font-family: var(--font-body); font-size: 0.95rem; font-weight: 800; color: var(--c-accent);
  }
  .sec__label svg { flex: none; inline-size: 1.6rem; block-size: 1.6rem; padding: 0.25rem; border-radius: 50%; color: var(--st-night); background: var(--st-gold); }
  .sec--fund { padding: var(--space-3) var(--space-4); border-radius: 12px; background: color-mix(in oklab, var(--st-brass-hi) 24%, var(--c-surface)); border: 1px solid color-mix(in oklab, var(--st-brass) 50%, transparent); }
  .sec--note { padding: var(--space-3) var(--space-4); border-radius: 12px; background: color-mix(in oklab, var(--c-accent-soft) 70%, var(--c-surface)); border-inline-start: 4px solid var(--st-brass); color: var(--c-ink); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .chips li {
    padding: 0.3em 0.9em; border-radius: 999px; font-size: 0.92rem; font-weight: 700; line-height: 1.6;
    background: color-mix(in oklab, var(--st-night) 6%, var(--c-surface)); color: var(--c-accent);
    border: 1px solid color-mix(in oklab, var(--st-brass) 45%, var(--c-line));
  }
  .nums { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .nums--grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr)); }
  .nums li { display: flex; align-items: flex-start; gap: var(--space-2); line-height: 1.7; }
  .nums__n {
    flex: none; display: grid; place-items: center; inline-size: 1.7rem; block-size: 1.7rem; margin-block-start: 0.1rem; border-radius: 50%;
    background: var(--st-night); color: var(--st-brass-hi); font-size: 0.85rem; font-weight: 800;
  }
  .card__link {
    justify-self: start; display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 44px; padding-inline: var(--space-4);
    border-radius: 999px; background: var(--st-night); color: var(--st-enamel-ink); font-weight: 800; text-decoration: none;
  }
  .card__link svg { color: var(--st-brass-hi); }

  /* A part's closing line (its motto or an execution note), centred under the line. */
  .closing {
    max-inline-size: 48rem; margin: var(--space-6) auto 0; padding: var(--space-4) var(--space-5);
    border-radius: 16px; text-align: center; font-weight: 700; line-height: 1.85; color: var(--c-accent);
    background: color-mix(in oklab, var(--st-brass-hi) 22%, var(--c-surface));
    border: 1px solid color-mix(in oklab, var(--st-brass) 55%, transparent);
  }

  /* Computers: the line runs down the middle and the stops zig-zag either side of it. */
  @media (min-width: 901px) {
    .plan { --dot: 52px; --gap: 104px; }
    .line { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap); row-gap: var(--space-5); }
    .line::before { inset-inline-start: auto; left: calc(50% - var(--rail) / 2); }
    .stop { padding: 0; }
    .stop:nth-child(odd) { grid-column: 1; }
    .stop:nth-child(even) { grid-column: 2; margin-block-start: var(--space-8); }
    .stop:nth-child(odd) .num { inset-inline-start: auto; inset-inline-end: calc(-1 * (var(--gap) / 2 + var(--dot) / 2)); }
    .stop:nth-child(even) .num { inset-inline-start: calc(-1 * (var(--gap) / 2 + var(--dot) / 2)); }
    /* a short gold link from each card to its stop */
    .stop::after { content: ''; position: absolute; inset-block-start: calc(10px + var(--dot) / 2 - 1px); block-size: 2px; inline-size: calc(var(--gap) / 2 - var(--dot) / 2); background: var(--st-brass); }
    .stop:nth-child(odd)::after { inset-inline-end: calc(-1 * (var(--gap) / 2 - var(--dot) / 2)); }
    .stop:nth-child(even)::after { inset-inline-start: calc(-1 * (var(--gap) / 2 - var(--dot) / 2)); }
    .card__title { font-size: var(--step-1); }
  }
  /* Phones: the count and the label side by side, then the parts (or titles) full width, then
     the button; a part's number sits above its title. */
  @media (max-width: 900px) {
    .glance { grid-template-columns: auto minmax(0, 1fr); padding: var(--space-4); gap: var(--space-3) var(--space-4); }
    .glance__mid { display: contents; }
    .glance__label { align-self: center; margin: 0; font-size: var(--step-1); }
    .glance__parts, .glance__titles { grid-column: 1 / -1; }
    .glance__parts { display: grid; gap: var(--space-2); }
    .glance__parts a { border-radius: 14px; }
    .glance__parts small { margin-inline-start: auto; }
    .glance__count { inline-size: 5.4rem; }
