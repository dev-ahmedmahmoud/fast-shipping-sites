---
// An inner page's title band (h1), in the home hero's style (the client's agent's design,
// Nov 2026): gold ribbons above and below, the navy gradient with the whole club gate pale on
// the left, and the two spotlights; the club's crest, the page's name over a gold rule, then
// the kicker link, lead, leads and one action. (No roof arcs here: Ahmed, 22 Nov.)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
import GoldWave from './GoldWave.astro';
interface Lead { name: string; seat: string; href: string; photo: ImageMetadata }
interface Props {
  ctx: PageContext;
  title: string;
  lead?: string;
  kicker?: Action | null;
  action?: Action | null;
  crest: ImageMetadata | null;
  backdrop?: ImageMetadata | null;
  /** The people who lead this page's subject (a program file's leads), with their label. */
  leads?: Lead[];
  leadLabel?: { one: string; two: string; many?: string };
}
const { title, lead, kicker, action, crest, backdrop, leads = [], leadLabel } = Astro.props;
---
<section class="band st-glass" data-st-ambient>
  {backdrop && <Image class="st-backdrop st-backdrop--whole" src={backdrop} alt="" widths={[640, 1000, 1600]} sizes="(max-width: 900px) 90vw, 44vw" loading="eager" />}
  <span class="st-beam st-beam--l" aria-hidden="true"></span>
  <span class="st-beam st-beam--r" aria-hidden="true"></span>
  <GoldWave edge="top" />
  <div class="container inner">
    {crest && <Image class="crest" src={crest} alt="" height={96} loading="eager" />}
    {kicker && (
      <p class="kicker">
        <a href={kicker.href}><svg class="flip-rtl" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>{kicker.label}</a>
      </p>
    )}
    <h1 data-split-words>{title}</h1>
    <span class="rule" aria-hidden="true"></span>
    {lead && <p class="lead">{lead}</p>}
    {leads.length > 0 && leadLabel && (
      <div class="leads">
        <p class="leads__label">{leads.length > 2 ? (leadLabel.many ?? leadLabel.two) : leads.length > 1 ? leadLabel.two : leadLabel.one}</p>
        <ul class="leads__list" role="list">
          {leads.map((l) => (
            <li>
              <a class="who" href={l.href}>
                <Image class="who__face" src={l.photo} alt="" width={128} height={128} fit="cover" position="top" loading="eager" />
                <span class="who__txt"><b>{l.name}</b><small>{l.seat}</small></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {action && <p><a class="btn btn--brass" href={action.href}>{action.label}</a></p>}
  </div>
  <GoldWave edge="bottom" />
</section>

<style>
  .band {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: calc(var(--st-wave-h) + var(--space-5)) calc(var(--st-wave-h) + var(--space-6));
    background-color: var(--st-night); color: var(--st-enamel-ink);
    background-image:
      radial-gradient(ellipse 70% 70% at 50% 0%, color-mix(in oklab, var(--st-brass-hi) 12%, transparent), transparent 70%),
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--st-enamel-ink) 4%, transparent) 0 1px, transparent 1px 96px),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--st-enamel-ink) 3.5%, transparent) 0 1px, transparent 1px 64px),
      var(--st-night-grad);
  }
  .band :global(.st-beam) { --dx: 22vw; --y: 380px; }
  /* The gate, in the top corner under the ribbon on every screen: on phones across the top;
     on computers sized by height so its whole height (the sign on top too) fits the band. */
  .band :global(.st-backdrop) { --bd-left: -12%; --bd-top: calc(var(--st-wave-h) * 0.85); --bd-w: 88%; --bd-o: 0.38; }
  .inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center; }
  .inner :global(.crest) { block-size: 76px; inline-size: auto; filter: drop-shadow(0 6px 12px color-mix(in oklab, var(--c-ink) 60%, transparent)); }
  .kicker a { display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 48px; color: var(--st-brass-hi); font-family: var(--font-body); font-weight: 700; text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  h1 { font-size: var(--step-5); line-height: 1.25; text-wrap: balance; text-shadow: 0 2px 14px color-mix(in oklab, var(--c-ink) 50%, transparent); }
  /* A gold rule with a small diamond under the name. */
  .rule { position: relative; display: block; inline-size: min(12rem, 60%); block-size: 2px; background: linear-gradient(90deg, transparent, var(--st-brass) 30%, var(--st-brass-hi) 50%, var(--st-brass) 70%, transparent); }
  .rule::after { content: ''; position: absolute; inset-inline-start: 50%; inset-block-start: 50%; inline-size: 9px; block-size: 9px; translate: -50% -50%; rotate: 45deg; background: var(--st-brass-hi); }
  :global([dir='rtl']) .rule::after { translate: 50% -50%; }
  .lead { font-size: var(--step-1); max-inline-size: 48ch; color: color-mix(in oklab, var(--st-enamel-ink) 90%, var(--st-night)); }
  /* A file's leads: a gold label, then each person as a chip (photo in a gold ring, name, seat)
     linking to their profile. */
  .leads { display: grid; justify-items: center; gap: var(--space-2); margin-block-start: var(--space-2); }
  .leads__label { padding: 0.1em 1em; border-radius: 999px; background: var(--st-gold); color: var(--st-night); font-weight: 800; font-size: var(--step--1); }
  .leads__list { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  .who {
    display: flex; align-items: center; gap: var(--space-3); padding-block: 6px; padding-inline: 6px var(--space-5); border-radius: 999px;
    background: color-mix(in oklab, var(--st-night) 55%, transparent); color: var(--st-enamel-ink); text-decoration: none;
    border: 1px solid color-mix(in oklab, var(--st-brass) 65%, transparent);
    box-shadow: 0 12px 26px -16px color-mix(in oklab, var(--c-ink) 80%, transparent);
    backdrop-filter: blur(4px); transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .who:hover { transform: translateY(-2px); border-color: var(--st-brass-hi); }
  .who :global(.who__face) {
    flex: none; inline-size: 58px; block-size: 58px; border-radius: 50%; object-fit: cover; object-position: top;
    background: radial-gradient(circle at 50% 30%, var(--st-brass-hi), var(--st-brass) 70%);
    box-shadow: 0 0 0 3px var(--st-brass-hi);
  }
  .who__txt { display: grid; text-align: start; line-height: 1.4; }
  .who__txt b { font-size: var(--step-0); font-weight: 800; }
  .who__txt small { font-size: 0.8rem; color: color-mix(in oklab, var(--st-enamel-ink) 80%, var(--st-brass-hi)); }
  @media (max-width: 700px) {
    /* stacked chips, all the same width */
    .leads__list { display: grid; inline-size: min(100%, 22rem); }
    .leads__list .who { inline-size: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .who { transition: none; } }

  @media (min-width: 901px) {
    .band :global(.st-beam) { --w: 16%; --dx: 12vw; --y: 360px; }
    .band :global(.st-backdrop) {
      --bd-left: -2%; --bd-top: calc(var(--st-wave-h) * 0.85); --bd-w: auto; --bd-o: 0.42;
      block-size: min(calc(100% - var(--st-wave-h) * 1.6), 24vw);
    }
  }
</style>
