---
// The gold ribbon that edges the page heroes (from the client's agent's design, Nov 2026).
// edge="top": the page colour above a rising curve, then a tapering gold ribbon (thick on the
// left). edge="bottom": a gold ribbon (thick on the right) with the page's cream below it,
// drawn over the bottom of the hero so photos standing in it are cut by the wave.
// Place it inside a positioned hero; it sizes itself to the hero's width.
interface Props { edge: 'top' | 'bottom' }
const { edge } = Astro.props;
const id = `gw${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['st-wave', `st-wave--${edge}`]} viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" class="st-wave__lo" />
      <stop offset="0.3" class="st-wave__hi" />
      <stop offset="0.55" class="st-wave__mid" />
      <stop offset="0.8" class="st-wave__hi" />
      <stop offset="1" class="st-wave__lo" />
    </linearGradient>
  </defs>
  {edge === 'top' ? (
    <>
      <path class="st-wave__cover" d="M0 0H1440V10C900 18 420 66 0 66Z" />
      <path fill={`url(#${id})`} d="M0 66C420 66 900 18 1440 10L1440 15C900 26 420 84 0 86Z" />
      <path class="st-wave__hair" d="M0 94C420 92 900 34 1440 24" />
    </>
  ) : (
    <>
      <path class="st-wave__hair" d="M0 22C460 18 1000 62 1440 30" />
      <path fill={`url(#${id})`} d="M0 32C460 28 1000 74 1440 40L1440 70C1000 98 460 38 0 38Z" />
      <path class="st-wave__cover" d="M0 38C460 38 1000 98 1440 70V100H0Z" />
    </>
  )}
</svg>
