---
// The station's grand seal: the facade's arches against the sky with the club's crest standing in
// the clock tower, a brass rail, then everything centred on the night band under a pool of lamp
// light: the name, the motto, the pages as enamel station signs, the social buttons, contact,
// and the legal line with the builder's credit as a small glass badge.
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const links = [...ctx.nav.filter((n) => !n.external), ...ctx.footerNav];
const external = ctx.nav.filter((n) => n.external);
const c = ctx.contact;
const hasContact = !!(c.address || c.phones.length || c.emails.length || c.hours || c.mapUrl);
const credit = ctx.legal.credit;
// The facade is drawn 3000 units wide (wider than any screen) at a fixed height, so a screen
// trims it at the sides, never at the top: arched bays every 140 units on both sides of the
// clock tower in the middle (x = 1500).
const bays = Array.from({ length: 10 }, (_, i) => i + 1).flatMap((k) => [1500 - k * 140, 1500 + k * 140]);
// Social networks as round brass buttons with their mark (24px grid; fill marks start with F:,
// the rest are stroked). A network without a mark here shows its name instead.
const marks: Record<string, string> = {
  facebook: 'F:M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H7.8v3h2.6V21z',
  instagram: 'M7.5 3.5h9a4 4 0 0 1 4 4v9a4 4 0 0 1-4 4h-9a4 4 0 0 1-4-4v-9a4 4 0 0 1 4-4ZM12 8.3a3.7 3.7 0 1 0 0 7.4 3.7 3.7 0 0 0 0-7.4ZM17.2 6.8v.01',
  x: 'M4 4h4.6L20 20h-4.6ZM19.6 4l-6.4 7M4.4 20l6.4-7',
  youtube: 'M3.5 8.2c.2-1.7 1.4-2.8 3.1-2.9 3.6-.3 7.2-.3 10.8 0 1.7.1 2.9 1.2 3.1 2.9.3 2.5.3 5.1 0 7.6-.2 1.7-1.4 2.8-3.1 2.9-3.6.3-7.2.3-10.8 0-1.7-.1-2.9-1.2-3.1-2.9-.3-2.5-.3-5.1 0-7.6ZM10.3 9.3v5.4l4.6-2.7Z',
  tiktok: 'M14.5 3.5v11.2a3.8 3.8 0 1 1-3.8-3.8M14.5 3.5c.4 2.4 2 4 4.5 4.3',
  linkedin: 'M6.5 10v8.5M6.5 6v.01M10.5 18.5V10M10.5 13.6c0-2.2 1.5-3.6 3.4-3.6s3.1 1.3 3.1 3.6v4.9',
  whatsapp: 'M4.2 19.8l1.1-4A8 8 0 1 1 8.4 18.7ZM9.2 8.2c-.4 1.9 1.6 5.8 5.4 6.7l1.2-1.3-1.8-1-.9.8c-1-.4-2.2-1.6-2.6-2.6l.8-.9-1-1.8Z',
};
---
<footer class="footer">
  <div class="sky">
    <svg class="facade" viewBox="0 0 3000 120" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
      <g class="ink">
        <path d="M0 120 V90 H3000 V120 Z" />
        {bays.map((x) => <path d={`M${x - 52} 90 V60 A52 44 0 0 1 ${x + 52} 60 V90 Z`} />)}
        <path d="M1440 90 V36 H1458 V18 L1500 2 L1542 18 V36 H1560 V90 Z" />
      </g>
      <g class="lit">
        {bays.map((x) => <path d={`M${x - 40} 90 V64 A40 34 0 0 1 ${x + 40} 64 V90`} />)}
      </g>
    </svg>
    {ctx.site.logo && <Image class="crest" src={ctx.site.logo} alt="" height={120} densities={[1, 2]} loading="lazy" />}
  </div>
  <div class="rail" aria-hidden="true"></div>

  <div class="container seal">
    <p class="name">{ctx.site.name}</p>
    {ctx.site.motto && <p class="motto"><span>{ctx.site.motto}</span></p>}

    <nav aria-label={ctx.ui.links}>
      <ul role="list" class="signs">
        {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
        {external.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> {ctx.ui.newTab}</span></a></li>)}
      </ul>
    </nav>

    {ctx.social.length > 0 && (
      <div class="follow">
        <h2 class="follow-label">{ctx.ui.follow}</h2>
        <ul role="list" class="social">
          {ctx.social.map((s) => {
            const mark = marks[s.network];
            return (
              <li>
                <a class:list={[mark && 'icon']} href={s.href} target="_blank" rel="noopener" lang="en" title={mark ? s.label : undefined}>
                  {mark
                    ? <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
                        {mark.startsWith('F:')
                          ? <path d={mark.slice(2)} fill="currentColor" />
                          : <path d={mark} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />}
                      </svg>
                    : null}
                  <span class:list={[mark && 'sr-only']}>{s.label}</span><span class="sr-only"> {ctx.ui.newTab}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {hasContact && (
      <ul role="list" class="contact" aria-label={ctx.ui.contact}>
        {c.address && <li>{c.address}</li>}
        {c.phones.map((p) => (
          <li>{p.label && <>{p.label}: </>}<a href={`tel:${p.number.replace(/\s+/g, '')}`} dir="ltr">{p.number}</a></li>
        ))}
        {c.emails.map((e) => <li>{e.label}: <a href={`mailto:${e.address}`} dir="ltr">{e.address}</a></li>)}
        {c.hours && <li>{c.hours}</li>}
        {c.mapUrl && <li><a href={c.mapUrl} target="_blank" rel="noopener">{ctx.ui.map}</a></li>}
      </ul>
    )}
  </div>

  <div class="container legal">
    <p>{ctx.legal.copyright ?? `© ${ctx.year} ${ctx.site.name}. ${ctx.ui.rights}.`}</p>
    {credit && (credit.href
      ? (
        <a class:list={['credit', credit.logo && 'has-logo']} href={credit.href} target="_blank" rel="noopener" data-st-credit>
          <span class="credit-text">{credit.text}</span>
          {credit.logo && <Image class="credit-logo" src={credit.logo} alt={credit.name ?? ''} height={26} densities={[1, 2]} loading="lazy" />}
          <span class="sr-only"> {ctx.ui.newTab}</span>
        </a>
      )
      : <p>{credit.text}</p>)}
  </div>
</footer>

<script>
  // The badge sits at the very bottom of the page, below where scroll-reveal triggers fire, so it
  // watches for itself: the glint crosses it once when it is fully on screen.
  const badge = document.querySelector<HTMLElement>('[data-st-credit]');
  if (badge && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { badge.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.9 });
    io.observe(badge);
  }
</script>

<style>
  .footer {
    position: relative; isolation: isolate; overflow: hidden; margin-block-start: var(--space-8);
    background: var(--st-night); color: var(--st-enamel-ink);
    padding-block-end: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
  }
  /* A pool of lamp light under the crest. */
  .footer::before {
    content: ''; position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 42% 46% at 50% 18%, color-mix(in oklab, var(--st-brass-hi) 20%, transparent), transparent 70%);
  }

  /* ---- the facade with the crest in its clock tower ---- */
  .sky { position: relative; background: var(--c-bg); }
  .facade { display: block; inline-size: 100%; block-size: clamp(84px, 9vw, 120px); }
  .facade .ink { fill: var(--st-night); }
  .facade .lit { fill: none; stroke: var(--st-brass); stroke-width: 2; opacity: 0.85; }
  .sky :global(.crest) {
    position: absolute; inset-block-start: 6%; inset-inline-start: 50%; translate: 50% 0;
    block-size: 82%; inline-size: auto;
    filter: drop-shadow(0 10px 16px color-mix(in oklab, var(--c-ink) 55%, transparent));
  }
  :global([dir='ltr']) .sky :global(.crest) { translate: -50% 0; }
  .rail { block-size: 6px; background: linear-gradient(90deg, var(--st-brass-lo), var(--st-brass-hi), var(--st-brass-lo)); }

  /* ---- the seal: everything centred ---- */
  .seal { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); text-align: center; padding-block: var(--space-7) var(--space-6); }
  .name { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--step-4); line-height: 1.25; text-wrap: balance; }
  .motto { color: var(--st-brass-hi); font-size: var(--step-1); }
  .motto span { display: inline-block; padding-block-end: 6px; border-block-end: 2px solid var(--st-brass); }

  .signs { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-block-start: var(--space-3); padding: 0; list-style: none; }
  .signs a {
    display: inline-flex; align-items: center; justify-content: center; min-block-size: 50px; padding: 4px var(--space-5);
    border-radius: var(--radius-m); text-decoration: none; font-weight: 700;
    background: var(--st-enamel); color: var(--st-enamel-ink);
    box-shadow: inset 0 0 0 3px var(--st-enamel), inset 0 0 0 4px color-mix(in oklab, var(--st-enamel-ink) 70%, transparent), 0 0 0 2px var(--st-brass), 0 8px 18px -8px color-mix(in oklab, var(--c-ink) 70%, transparent);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .signs a:hover { transform: translateY(-2px); background: color-mix(in oklab, var(--st-enamel) 85%, var(--st-enamel-ink)); }
  .signs a[aria-current='page'] { background: var(--st-brass-hi); color: var(--c-ink); box-shadow: inset 0 0 0 3px var(--st-brass-hi), 0 0 0 2px var(--st-brass), 0 8px 18px -8px color-mix(in oklab, var(--c-ink) 70%, transparent); }

  .follow { display: flex; align-items: center; gap: var(--space-3); margin-block-start: var(--space-2); }
  .follow-label { font-family: var(--font-body); font-size: var(--step-0); font-weight: 700; color: var(--st-brass-hi); }
  .social { display: flex; flex-wrap: wrap; gap: var(--space-3); padding: 0; margin: 0; list-style: none; }
  .social a { color: var(--st-enamel-ink); }
  .social a.icon {
    display: grid; place-items: center; inline-size: var(--st-tap); block-size: var(--st-tap); border-radius: 50%;
    color: var(--c-ink); text-decoration: none;
    background: radial-gradient(circle at 35% 30%, var(--st-brass-hi), var(--st-brass) 62%, var(--st-brass-lo));
    box-shadow: 0 3px 0 var(--st-brass-lo);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .social a.icon:hover { transform: translateY(-2px); }

  .contact { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-5); padding: 0; margin: 0; list-style: none; color: color-mix(in oklab, var(--st-enamel-ink) 85%, var(--st-night)); }
  .contact a { color: inherit; }

  /* ---- legal line and the builder's badge ---- */
  .legal {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3) var(--space-5);
    padding-block-start: var(--space-4); border-block-start: 1px solid color-mix(in oklab, var(--st-brass) 35%, transparent);
    color: color-mix(in oklab, var(--st-enamel-ink) 80%, var(--st-night)); font-size: var(--step--1);
  }
  .legal a { color: inherit; }
  /* A glass pill with a fine brand-gradient edge (Syncology orange to blue); a glint crosses it
     once as it comes into view, and it lifts and glows on hover. */
  .credit {
    --c1: #FC5418; --c2: #0078CC;
    position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: var(--space-3);
    min-block-size: 48px; padding: 6px var(--space-4) 6px var(--space-5); border-radius: 999px; border: 1.5px solid transparent;
    background:
      linear-gradient(color-mix(in oklab, var(--st-night) 82%, #fff), color-mix(in oklab, var(--st-night) 92%, #000)) padding-box,
      linear-gradient(90deg, var(--c1), var(--c2)) border-box;
    color: var(--st-enamel-ink); text-decoration: none; font-weight: 700;
    box-shadow: 0 8px 22px -12px color-mix(in oklab, var(--c2) 80%, transparent);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .credit-text { color: color-mix(in oklab, var(--st-enamel-ink) 85%, transparent); font-weight: 600; }
  .credit :global(.credit-logo) { block-size: 26px; inline-size: auto; }
  .credit::after {
    content: ''; position: absolute; inset: -40% -30%; pointer-events: none; opacity: 0;
    background: linear-gradient(105deg, transparent 40%, rgb(255 255 255 / 0.45) 50%, transparent 60%);
    transform: translateX(-70%);
  }
  .credit.is-in::after, .credit:hover::after { animation: st-credit-glint 1.6s cubic-bezier(0.3, 0.6, 0.3, 1) 0.3s both; }
  @keyframes st-credit-glint { 0% { opacity: 1; transform: translateX(-70%); } 100% { opacity: 1; transform: translateX(70%); } }
  .credit:hover { transform: translateY(-2px); box-shadow: 0 0 0 3px color-mix(in oklab, var(--c2) 22%, transparent), 0 12px 28px -10px color-mix(in oklab, var(--c1) 70%, transparent); }
  .credit:focus-visible { outline: 3px solid var(--st-brass-hi); outline-offset: 3px; }

  @media (max-width: 700px) {
    .name { font-size: var(--step-3); }
    .signs { display: grid; grid-template-columns: 1fr 1fr; inline-size: 100%; }
    .signs li { display: grid; }
    .signs a { padding-inline: var(--space-2); font-size: var(--step--1); }
    .legal { justify-content: center; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .credit::after { animation: none !important; }
  }
</style>
