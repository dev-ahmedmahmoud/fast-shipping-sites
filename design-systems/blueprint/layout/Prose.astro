---
// Every inner page is a drawing sheet. The cover is a title block: the page title
// large on one side, sheet, scale and date in ruled cells on the other. The body
// sits on a white sheet with crop marks and a ruler along its start edge. When
// several blocks share a page (news items, headingLevel 2), each is a smaller
// sheet with its date in the mono strip.
import type { PageContext } from '@engine/context';
import Drawing from './Drawing.astro';
import { no, scale, words } from './sheet';
interface Props {
  ctx: PageContext;
  title: string;
  lead?: string;
  todo?: string[];
  /** 1 for a page's own title (default); 2 when several Prose blocks share a page, e.g. news items. */
  headingLevel?: 1 | 2;
  /** Anchor id, so other pages can link to this block. */
  id?: string;
}
const { ctx, title, lead, todo = [], headingLevel = 1, id } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const w = words(ctx);
---
<article class:list={['section', 'block', headingLevel === 1 ? 'page' : 'item']} id={id}>
  <div class="container narrow">
    {headingLevel === 1 ? (
      <header class="cover band crop">
        <Drawing name="protractor" class="cover-art" plotNow />
        <div class="cover-title">
          {lead && <p class="label lead">{lead}</p>}
          <Heading data-split-words>{title}</Heading>
        </div>
        <dl class="tblock">
          <div><dt class="label">{w.sheet}</dt><dd>{no(ctx, 1)}</dd></div>
          <div><dt class="label">{w.scale}</dt><dd>{scale(ctx)}</dd></div>
          <div><dt class="label">{w.date}</dt><dd>{ctx.year}</dd></div>
        </dl>
      </header>
    ) : (
      <header class="item-head">
        {lead && <p class="label stamp">{lead}</p>}
        <Heading>{title}</Heading>
      </header>
    )}
    {todo.length > 0 && (
      <aside class="todo-note">
        <strong>{ctx.ui.pending}</strong>
        <ul lang="en" dir="ltr">{todo.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}
    <div class="sheet crop">
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</article>

<style>
  .narrow { max-inline-size: calc(54rem + 2 * var(--gutter)); display: flex; flex-direction: column; gap: var(--space-5); }
  .page { padding-block-start: var(--space-6); }

  /* ---- Cover: title block on blueprint ---- */
  .cover {
    --crop-color: var(--c-accent);
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-5);
    padding: var(--space-7) clamp(var(--space-4), 4vw, var(--space-7)) var(--space-5);
  }
  .cover :global(.cover-art) { position: absolute; inline-size: 220px; inset-block-start: -40px; inset-inline-end: -30px; color: var(--band-ink); opacity: 0.35; }
  .cover-title { position: relative; display: flex; flex-direction: column; gap: var(--space-3); min-inline-size: 0; }
  .lead { color: var(--band-muted); }
  h1 { font-size: var(--step-4); }
  .tblock { position: relative; display: grid; grid-template-columns: repeat(3, auto); margin: 0; border: var(--hair) solid var(--band-line-strong); background: var(--band); }
  .tblock > div { padding: var(--space-2) var(--space-3); border-inline-end: var(--hair) solid var(--band-line-strong); }
  .tblock > div:last-child { border-inline-end: 0; }
  .tblock dt { color: var(--band-muted); font-size: 0.7rem; }
  .tblock dd { margin: 0; font-family: var(--font-mono); font-weight: 500; font-variant-numeric: tabular-nums; }

  /* ---- News items and other blocks sharing a page ---- */
  .item { scroll-margin-block-start: 140px; padding-block: var(--space-6); }
  .item-head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .item h2 { font-size: var(--step-3); }
  .stamp { padding: 0.1em var(--space-2); border: var(--hair) solid var(--c-accent); color: var(--c-accent); font-variant-numeric: tabular-nums; }

  /* ---- The sheet: white paper, crop marks, a ruler along the start edge ---- */
  .sheet {
    --crop-color: var(--c-accent);
    padding: clamp(var(--space-4), 4vw, var(--space-7));
    padding-inline-start: calc(clamp(var(--space-4), 4vw, var(--space-7)) + 14px);
    background:
      repeating-linear-gradient(to bottom, var(--c-line) 0 1px, transparent 1px 12px) 0 0 / 6px 100% no-repeat,
      repeating-linear-gradient(to bottom, var(--c-accent) 0 1px, transparent 1px 60px) 0 0 / 12px 100% no-repeat,
      var(--c-surface);
    border: var(--hair) solid var(--c-line);
    min-inline-size: 0;
  }
  :global(:root[dir="rtl"]) .sheet {
    background:
      repeating-linear-gradient(to bottom, var(--c-line) 0 1px, transparent 1px 12px) 100% 0 / 6px 100% no-repeat,
      repeating-linear-gradient(to bottom, var(--c-accent) 0 1px, transparent 1px 60px) 100% 0 / 12px 100% no-repeat,
      var(--c-surface);
  }
  .sheet:has(.prose:empty) { display: none; }
  .prose { max-inline-size: 70ch; min-inline-size: 0; }
  .prose :global(> * + *) { margin-block-start: var(--space-4); }
  .prose :global(> :first-child) { margin-block-start: 0; }

  /* Headings: a crosshair target and a dimension rule running to the edge. */
  .prose :global(h2) {
    display: flex; align-items: center; gap: var(--space-3);
    margin-block-start: var(--space-7); font-size: var(--step-2);
  }
  .prose :global(h2::before) {
    content: ""; flex: none; inline-size: 14px; block-size: 14px; border-radius: 50%;
    border: var(--rule) solid var(--c-accent);
    background: linear-gradient(var(--c-accent), var(--c-accent)) 50% 50% / 100% 1px no-repeat, linear-gradient(var(--c-accent), var(--c-accent)) 50% 50% / 1px 100% no-repeat;
  }
  .prose :global(h2::after) { content: ""; flex: 1; min-inline-size: 2rem; block-size: 1px; background: var(--c-line); }
  .prose :global(> h2:first-child) { margin-block-start: 0; }
  .prose :global(h3) { font-size: var(--step-1); margin-block-start: var(--space-6); color: var(--c-accent); }
  .prose :global(h4) { font-size: var(--step-0); margin-block-start: var(--space-5); }
  .prose :global(ul), .prose :global(ol) { padding-inline-start: var(--space-5); }
  .prose :global(li + li) { margin-block-start: var(--space-2); }
  .prose :global(ul > li::marker) { content: "▪  "; color: var(--c-accent); }
  .prose :global(ol > li::marker) { color: var(--c-accent); font-family: var(--font-mono); }
  .prose :global(hr) { border: 0; border-block-start: var(--hair) dashed var(--c-line); }
  .prose :global(img) { border: var(--hair) solid var(--c-line); background: var(--c-sunk); }
  .prose :global(video) { inline-size: 100%; border: var(--rule) solid var(--c-ink); background: var(--c-ink); }
  .prose :global(.embed) { inline-size: 100%; aspect-ratio: 16 / 9; border: var(--rule) solid var(--c-ink); background: var(--c-sunk); }
  .prose :global(.embed--map) { aspect-ratio: 4 / 3; }
  .prose :global(blockquote) { margin-inline: 0; padding: var(--space-3) var(--space-5); border-inline-start: 3px solid var(--c-accent); background: var(--c-accent-soft); }

  /* Tables: a parts list with a blue header row. */
  .prose :global(table) {
    display: block; inline-size: max-content; max-inline-size: 100%; overflow-x: auto;
    border-collapse: collapse; border: var(--rule) solid var(--c-ink);
  }
  .prose :global(th), .prose :global(td) { border: var(--hair) solid var(--c-line); padding: var(--space-2) var(--space-3); text-align: start; }
  .prose :global(th) { background: var(--c-accent); color: var(--c-accent-ink); font-weight: var(--weight-strong); }
  .prose :global(tr:nth-child(even) td) { background: var(--c-sunk); }

  .prose :global(.actions) { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* Downloads: a drawing register, one ruled row per file. */
  .prose :global(.downloads) { list-style: none; padding: 0; border: var(--hair) solid var(--c-line); }
  .prose :global(.downloads li) {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4);
    margin: 0; padding: var(--space-2) var(--space-4); border-block-end: var(--hair) solid var(--c-line);
  }
  .prose :global(.downloads li:last-child) { border-block-end: 0; }
  .prose :global(.downloads li:nth-child(even)) { background: var(--c-sunk); }
  .prose :global(.downloads a) {
    font-family: var(--font-mono); font-size: var(--step--1); font-weight: 500; text-transform: uppercase; letter-spacing: var(--label-tracking);
    overflow-wrap: anywhere; text-decoration: none; padding: 0.2em 0.6em; border: var(--hair) solid var(--c-accent);
  }
  :global(:lang(ar)) .prose :global(.downloads a) { font-family: var(--font-body); text-transform: none; }
  .prose :global(.downloads a:hover) { background: var(--c-accent); color: var(--c-accent-ink); }

  /* Galleries: mounted views in a grid, each with crop corners. */
  .prose :global(.gallery) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr)); gap: var(--space-4); }
  .prose :global(.gallery > *) { margin: 0; }
  .prose :global(.gallery img) {
    inline-size: 100%; block-size: auto; aspect-ratio: 4 / 3; object-fit: cover;
    padding: 4px; background: var(--c-surface); border-color: var(--c-line);
    transition: border-color var(--dur-fast) linear, translate var(--dur-base) var(--ease-out);
  }
  .prose :global(.gallery img:hover) { border-color: var(--c-accent); translate: 0 -2px; }

  /* Student photos: name plates under each portrait. */
  .prose :global(.students) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr)); gap: var(--space-5) var(--space-4); }
  .prose :global(.students figure) { margin: 0; display: flex; flex-direction: column; border: var(--hair) solid var(--c-line); background: var(--c-surface); }
  .prose :global(.students img) { inline-size: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 0; border-block-end: var(--hair) solid var(--c-line); }
  .prose :global(.students figcaption) { padding: var(--space-2); font-size: var(--step--1); font-weight: var(--weight-strong); line-height: 1.3; text-align: center; }
  .prose :global(.students + h2), .prose :global(h2 + .students) { margin-block-start: var(--space-5); }

  .prose :global(.note) { padding: var(--space-3) var(--space-5); border: var(--hair) dashed var(--c-accent); background: var(--c-accent-soft); }

  /* Old-site forms, shown as they were; sending is not wired up yet. Drafting-form fields. */
  .prose :global(.form) { display: grid; gap: var(--space-3); padding: var(--space-5); background: var(--c-bg); border: var(--hair) solid var(--c-line); }
  .prose :global(.form label) { font-weight: var(--weight-strong); }
  .prose :global(.form input), .prose :global(.form select), .prose :global(.form textarea) {
    inline-size: 100%; min-block-size: 46px; padding: var(--space-2) var(--space-3);
    border: var(--hair) solid var(--c-line); border-block-end: var(--rule) solid var(--c-ink); border-radius: 0; background: var(--c-surface);
  }
  .prose :global(.form input:focus-visible), .prose :global(.form select:focus-visible), .prose :global(.form textarea:focus-visible) { border-block-end-color: var(--c-accent); background: var(--c-accent-soft); }
  .prose :global(.form textarea) { min-block-size: 6rem; resize: vertical; }
  .prose :global(.form button[disabled]) { opacity: 0.6; cursor: not-allowed; justify-self: start; }

  @media (max-width: 640px) {
    .cover { grid-template-columns: minmax(0, 1fr); }
    .tblock { justify-self: start; }
    .sheet { padding: var(--space-4); padding-inline-start: calc(var(--space-4) + 14px); }
    .prose :global(.students) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
