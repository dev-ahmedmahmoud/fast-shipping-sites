---
// News as a drawing's revision log: each item is a card with "REV. 03" and its date
// in a mono strip, the title, and a short excerpt. Revisions count down, newest
// first, like the revision table in a drawing's corner.
import type { PageContext } from '@engine/context';
import SheetHead from './SheetHead.astro';
import { no, words } from './sheet';
interface NewsItem { title: string; href: string; date?: string; excerpt?: string }
interface Props { ctx: PageContext; title?: string; items: NewsItem[]; more?: { label: string; href: string } | null; headingLevel?: 1 | 2 }
const { ctx, title, items, more, headingLevel = 2 } = Astro.props;
const w = words(ctx);
---
<section class:list={['section', { top: headingLevel === 1 }]}>
  <div class="container stack">
    <SheetHead ctx={ctx} title={title} sheet={headingLevel === 1 ? 1 : 4} level={headingLevel} split={headingLevel === 1}>
      {more && items.length > 0 && <a class="btn btn--ghost more" href={more.href}>{more.label}</a>}
    </SheetHead>
    {items.length === 0 ? (
      <p class="empty">{ctx.ui.noNews}</p>
    ) : (
      <ul class="log" role="list">
        {items.map((n, i) => (
          <li data-reveal>
            <a class="item" href={n.href}>
              <span class="strip label">
                <span>{w.rev} {no(ctx, items.length - i)}</span>
                {n.date && <time>{n.date}</time>}
              </span>
              <h3>{n.title}</h3>
              {n.excerpt && <p>{n.excerpt}</p>}
              <span class="arrow" aria-hidden="true"><svg class="flip-rtl" viewBox="0 0 24 24" width="20" height="20"><path d="M4 12h15M13 6l6 6-6 6" /></svg></span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .top { padding-block-start: var(--space-7); }
  .stack { display: flex; flex-direction: column; gap: var(--space-6); }
  .more { min-block-size: 44px; }
  .empty { padding: var(--space-5); background: var(--c-surface); border: var(--hair) dashed var(--c-line); color: var(--c-muted); }
  .log { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--space-5); }
  .log > li { display: flex; min-inline-size: 0; }
  .item {
    position: relative; flex: 1; display: flex; flex-direction: column; gap: var(--space-3);
    padding: 0 var(--space-5) var(--space-5);
    background: var(--c-surface); color: var(--c-ink); text-decoration: none;
    border: var(--hair) solid var(--c-line);
    transition: border-color var(--dur-fast) linear, transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .strip {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2);
    margin-inline: calc(-1 * var(--space-5)); padding: var(--space-2) var(--space-5);
    border-block-end: var(--hair) solid var(--c-line); background: var(--c-sunk);
    color: var(--c-accent); font-variant-numeric: tabular-nums;
  }
  .strip time { color: var(--c-muted); }
  h3 { font-size: var(--step-1); line-height: 1.3; }
  p { color: var(--c-muted); }
  .arrow { margin-block-start: auto; align-self: flex-end; color: var(--c-accent); }
  .arrow svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: square; transition: translate var(--dur-base) var(--ease-out); }
  .item:hover { border-color: var(--c-accent); transform: translate(calc(var(--dir) * -3px), -3px); box-shadow: calc(var(--dir) * 6px) 6px 0 var(--c-accent-soft); }
  .item:hover h3 { color: var(--c-accent); }
  .item:hover .arrow svg { translate: calc(var(--dir) * 4px) 0; }
</style>
