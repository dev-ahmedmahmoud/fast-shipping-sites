---
import type { PageContext } from '@engine/context';
import Doodle from './Doodle.astro';
interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const links = [...ctx.nav.filter((n) => !n.external), ...ctx.footerNav];
const external = ctx.nav.filter((n) => n.external);
// The name label on a school notebook cover.
const labelWords = ctx.locale === 'ar' ? { name: 'الاسم', motto: 'الشعار' } : { name: 'Name', motto: 'Motto' };
---
<footer class="footer">
  <div class="container top">
    <div class="label-sticker">
      <span class="tape" aria-hidden="true"></span>
      <p class="row"><span class="key">{labelWords.name}:</span> <span class="val">{ctx.site.name}</span></p>
      {ctx.site.motto && <p class="row"><span class="key">{labelWords.motto}:</span> <span class="val">{ctx.site.motto}</span></p>}
    </div>
    <Doodle name="star" tone={4} filled class="f-star" loop="twinkle" />
    <Doodle name="plane" tone={1} flip class="f-plane" />
  </div>

  <div class="container grid">
    <nav class="col" aria-label={ctx.ui.links}>
      <h2 class="label">{ctx.ui.links}</h2>
      <ul role="list" class="two">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        {external.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> {ctx.ui.newTab}</span></a></li>)}
      </ul>
    </nav>

    <div class="col">
      <h2 class="label">{ctx.ui.contact}</h2>
      <ul role="list">
        {ctx.contact.address && <li>{ctx.contact.address}</li>}
        {ctx.contact.phones.map((p) => (
          <li>{p.label && <>{p.label}: </>}<a href={`tel:${p.number.replace(/\s+/g, '')}`} dir="ltr">{p.number}</a></li>
        ))}
        {ctx.contact.emails.map((e) => <li>{e.label}: <a href={`mailto:${e.address}`} dir="ltr">{e.address}</a></li>)}
        {ctx.contact.hours && <li>{ctx.contact.hours}</li>}
        {ctx.contact.mapUrl && <li><a href={ctx.contact.mapUrl} target="_blank" rel="noopener">{ctx.ui.map}</a></li>}
      </ul>
    </div>

    {ctx.social.length > 0 && (
      <div class="col">
        <h2 class="label">{ctx.ui.follow}</h2>
        <ul role="list" class="social">
          {ctx.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" lang="en">{s.label}</a></li>)}
        </ul>
      </div>
    )}
  </div>
  <div class="container legal">
    <p>{ctx.legal.copyright ?? `© ${ctx.year} ${ctx.site.name}. ${ctx.ui.rights}.`}</p>
    {ctx.legal.credit && (
      <p>{ctx.legal.credit.href ? <a href={ctx.legal.credit.href} target="_blank" rel="noopener">{ctx.legal.credit.text}</a> : ctx.legal.credit.text}</p>
    )}
  </div>
</footer>

<style>
  /* The kraft-paper back cover of the notebook, with the spiral binding along its top. */
  .footer {
    position: relative; margin-block-start: var(--space-8);
    background-color: var(--c-sunk);
    background-image: radial-gradient(color-mix(in srgb, var(--c-ink) 7%, transparent) 1px, transparent 1.4px);
    background-size: 7px 7px;
    padding-block: var(--space-8) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    font-size: var(--step--1);
  }
  .footer::before {
    content: ""; position: absolute; inset-inline: 0; inset-block-start: -9px; block-size: 18px;
    background: radial-gradient(circle at 50% 50%, transparent 5px, var(--c-muted) 5.5px 7.5px, transparent 8px) 0 0 / 26px 18px repeat-x;
    opacity: 0.55;
  }
  .top { position: relative; display: flex; justify-content: center; margin-block-end: var(--space-7); }
  .label-sticker {
    position: relative; display: flex; flex-direction: column; gap: var(--space-1);
    inline-size: min(100%, 34rem); padding: var(--space-5) var(--space-5) var(--space-4);
    background: var(--c-surface); border: 2px solid var(--c-ink); border-radius: var(--radius-l);
    box-shadow: inset 0 0 0 5px var(--c-surface), inset 0 0 0 7px var(--crayon-1);
    rotate: -1.2deg;
  }
  .label-sticker .tape { --tape: var(--crayon-2); }
  .row {
    display: flex; flex-wrap: wrap; gap: 0 var(--space-2); align-items: baseline;
    padding-block-end: var(--space-1); border-block-end: 2px dotted var(--c-line);
    font-size: var(--step-0);
  }
  .key { font-weight: 600; color: var(--c-muted); }
  .val { font-family: var(--font-display); font-weight: 600; color: var(--c-accent); min-inline-size: 0; }
  .top :global(.f-star) { position: absolute; inset-block-start: -1.4rem; inset-inline-start: calc(50% - 19rem); inline-size: 3rem; block-size: 3rem; --doodle-w: 4.5; }
  .top :global(.f-plane) { position: absolute; inset-block-end: -1rem; inset-inline-end: calc(50% - 20rem); inline-size: 3.6rem; block-size: 3.6rem; --doodle-w: 4; }

  .grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--space-6); }
  .col { display: flex; flex-direction: column; gap: var(--space-3); min-inline-size: 0; }
  .col ul { display: flex; flex-direction: column; gap: var(--space-2); }
  .col ul.two { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr)); gap: var(--space-2) var(--space-4); }
  .col li { overflow-wrap: anywhere; }
  .col a { color: var(--c-ink); text-decoration: none; }
  .col a:hover { color: var(--c-accent); text-decoration: underline wavy; }
  .label { color: var(--c-ink); font-family: var(--font-display); font-size: var(--step-0); }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3);
    margin-block-start: var(--space-7); padding-block-start: var(--space-4);
    border-block-start: 2px dashed color-mix(in srgb, var(--c-ink) 25%, transparent); color: var(--c-muted);
  }
  .legal a { color: inherit; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .top :global(.f-star), .top :global(.f-plane) { display: none; }
  }
</style>
