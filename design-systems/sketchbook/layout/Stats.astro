---
import type { PageContext } from '@engine/context';
import Doodle from './Doodle.astro';
interface Props { ctx: PageContext; title?: string; items: { value: string; label: string }[] }
const { title, items } = Astro.props;
---
<section class="section">
  <div class="container">
    {title && <h2 data-reveal>{title}</h2>}
    <dl class="stats">
      {items.map((s, i) => (
        <div class="stat" data-reveal="pop" style={`--tilt:${i % 2 ? '3deg' : '-3deg'}`}>
          <dt>{s.label}</dt>
          <dd>
            <span class="value">{s.value}</span>
            <Doodle name="circle" tone={(i % 3) + 2 as 2 | 3 | 4} class="ring" />
            <Doodle name="star" tone={4} filled class="star" loop="twinkle" />
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  h2 { font-size: var(--step-3); margin-block-end: var(--space-5); }
  .stats { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-7) var(--space-8); padding-block: var(--space-4); }
  .stat { display: flex; flex-direction: column-reverse; align-items: center; gap: var(--space-2); rotate: var(--tilt); text-align: center; }
  dd { position: relative; margin: 0; padding: var(--space-4) var(--space-6); }
  .value {
    position: relative; z-index: 1; font-family: var(--font-display); font-size: var(--step-5); font-weight: 700;
    font-variant-numeric: tabular-nums; line-height: 1.1; color: var(--c-ink);
  }
  dd :global(.ring) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; --doodle-w: 3.2; }
  dd :global(.star) { position: absolute; inset-block-start: -0.6rem; inset-inline-end: -0.8rem; inline-size: 2.6rem; block-size: 2.6rem; --doodle-w: 4.5; }
  dt { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; color: var(--c-muted); }
</style>
