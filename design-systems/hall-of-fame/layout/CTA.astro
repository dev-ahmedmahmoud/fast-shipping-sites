---
// An invitation: an engraved card on the velvet wall, double-ruled in gold, one clear action.
import type { PageContext } from '@engine/context';
import type { Action } from '@engine/content';
interface Props { ctx: PageContext; title: string; text?: string; action: Action | null }
const { title, text, action } = Astro.props;
---
<section class="section hof-wall cta-wall">
  <div class="container">
    <div class="invite" data-hof-reveal>
      <span class="corner c1" aria-hidden="true"></span><span class="corner c2" aria-hidden="true"></span>
      <span class="corner c3" aria-hidden="true"></span><span class="corner c4" aria-hidden="true"></span>
      <h2>{title}</h2>
      <span class="hof-orn" aria-hidden="true"><i></i></span>
      {text && <p>{text}</p>}
      {action && (
        <a class="btn btn--primary" href={action.href} target={action.external ? '_blank' : undefined} rel={action.external ? 'noopener' : undefined}>{action.label}</a>
      )}
    </div>
  </div>
</section>

<style>
  .invite {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-4);
    inline-size: min(100%, 46rem); margin-inline: auto; padding: var(--space-8) var(--space-6);
    background: linear-gradient(160deg, var(--c-surface), color-mix(in oklab, var(--c-surface) 82%, var(--c-sunk)));
    color: var(--c-ink); text-align: center; border-radius: 2px;
    box-shadow: inset 0 0 0 10px var(--c-surface), inset 0 0 0 11px var(--hof-gold), inset 0 0 0 15px var(--c-surface), inset 0 0 0 16px color-mix(in oklab, var(--hof-gold) 60%, transparent), var(--hof-shadow);
  }
  .corner { position: absolute; inline-size: 26px; block-size: 26px; border: 2px solid var(--hof-gold); }
  .c1 { inset-block-start: 22px; inset-inline-start: 22px; border-inline-end: 0; border-block-end: 0; }
  .c2 { inset-block-start: 22px; inset-inline-end: 22px; border-inline-start: 0; border-block-end: 0; }
  .c3 { inset-block-end: 22px; inset-inline-start: 22px; border-inline-end: 0; border-block-start: 0; }
  .c4 { inset-block-end: 22px; inset-inline-end: 22px; border-inline-start: 0; border-block-start: 0; }
  h2 { font-size: var(--step-4); color: var(--c-accent); }
  .invite p { color: var(--c-muted); font-size: var(--step-1); max-inline-size: 40ch; }
  .invite .btn--primary { background: var(--c-accent); color: var(--c-accent-ink); }
</style>
