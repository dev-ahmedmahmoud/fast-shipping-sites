---
// The reading room: the title in Amiri under a gold ornament, then the page body on a
// stone-white leaf with a brass top rule. Long text stays near 65 characters, 18px and up.
import type { PageContext } from '@engine/context';
interface Props {
  ctx: PageContext;
  title: string;
  lead?: string;
  todo?: string[];
  /** 1 for a page's own title (default); 2 when several Prose blocks share a page, e.g. news items. */
  headingLevel?: 1 | 2;
  /** Anchor id, so other pages can link to this block. */
  id?: string;
}
const { ctx, title, lead, todo = [], headingLevel = 1, id } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---
<article class:list={['section', 'reading', { item: headingLevel === 2 }]} id={id}>
  <div class="container narrow">
    <header class="head">
      <Heading data-split-words>{title}</Heading>
      <span class="hof-orn" aria-hidden="true"><i></i></span>
      {lead && <p class="lead">{lead}</p>}
    </header>
    {todo.length > 0 && (
      <aside class="todo-note">
        <strong>{ctx.ui.pending}</strong>
        <ul lang="en" dir="ltr">{todo.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}
    <div class="leaf">
      <div class="prose"><slot /></div>
    </div>
  </div>
</article>

<style>
  .narrow { max-inline-size: calc(52rem + 2 * var(--gutter)); display: flex; flex-direction: column; gap: var(--space-6); }
  .head { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center; padding-block-start: var(--space-4); }
  h1 { font-size: var(--step-5); color: var(--c-accent); }
  .item h2 { font-size: var(--step-3); color: var(--c-accent); }
  .item { scroll-margin-block-start: 140px; }
  .lead { font-size: var(--step-1); color: var(--c-muted); max-inline-size: 48ch; }
  .item .lead { font-size: var(--step-0); }
  .leaf {
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-s);
    border-block-start: 3px solid var(--hof-gold);
    box-shadow: 0 24px 50px -40px var(--c-ink);
  }
  .prose { max-inline-size: 68ch; margin-inline: auto; min-inline-size: 0; }
  .prose :global(> * + *) { margin-block-start: var(--space-4); }
  .prose :global(h2) { font-size: var(--step-3); color: var(--c-accent); margin-block-start: var(--space-7); }
  .prose :global(h3) { font-size: var(--step-2); margin-block-start: var(--space-6); }
  .prose :global(h4) { font-size: var(--step-1); margin-block-start: var(--space-5); }
  .prose :global(h2:first-child), .prose :global(h3:first-child) { margin-block-start: 0; }
  .prose :global(ul), .prose :global(ol) { padding-inline-start: var(--space-5); }
  .prose :global(li + li) { margin-block-start: var(--space-2); }
  .prose :global(li::marker) { color: var(--hof-bronze); }
  .prose :global(strong) { color: var(--c-ink); }
  .prose :global(img) { border-radius: var(--radius-s); }
  .prose :global(video) { inline-size: 100%; border-radius: var(--radius-s); background: var(--c-sunk); }
  .prose :global(.embed) { inline-size: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--radius-s); background: var(--c-sunk); }
  .prose :global(.embed--map) { aspect-ratio: 4 / 3; }
  .prose :global(blockquote) { margin-inline: 0; padding: var(--space-3) var(--space-5); border-inline-start: 3px solid var(--hof-gold); background: var(--c-bg); color: var(--c-ink); font-family: var(--font-display); font-size: var(--step-1); }
  .prose :global(table) { border-collapse: collapse; inline-size: 100%; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--c-line); padding: var(--space-2) var(--space-3); text-align: start; }
  .prose :global(th) { background: var(--c-bg); }
  .prose :global(.actions) { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .prose :global(.downloads) { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .prose :global(.downloads li) {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4);
    min-block-size: 56px; padding: var(--space-2) var(--space-4); border: 1px solid var(--c-line); border-radius: var(--radius-s); background: var(--c-bg);
  }
  .prose :global(.downloads li + li) { margin-block-start: 0; }
  .prose :global(.downloads a) { font-weight: var(--weight-strong); }
  .prose :global(.gallery) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr)); gap: var(--space-4); }
  .prose :global(.gallery img) {
    inline-size: 100%; block-size: auto; padding: 6px; background: var(--hof-gilt); border-radius: 0;
    box-shadow: 0 10px 20px -14px var(--c-ink);
  }
  .prose :global(.students) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr)); gap: var(--space-5); }
  .prose :global(.students figure) { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); text-align: center; }
  .prose :global(.students img) { inline-size: 100%; aspect-ratio: 3 / 4; object-fit: cover; padding: 5px; background: var(--hof-gilt); border-radius: 0; }
  .prose :global(.students figcaption) { font-size: var(--step--1); font-weight: var(--weight-strong); }
  .prose :global(.note) { padding: var(--space-4) var(--space-5); border-radius: var(--radius-s); background: var(--c-accent-soft); border-inline-start: 3px solid var(--c-accent); }

  /* Old-site forms, shown as they were; sending is not wired up yet. */
  .prose :global(.form) { display: grid; gap: var(--space-3); padding: var(--space-5); border: 1px solid var(--c-line); border-radius: var(--radius-s); background: var(--c-bg); }
  .prose :global(.form input), .prose :global(.form select), .prose :global(.form textarea) {
    inline-size: 100%; min-block-size: 52px; padding: var(--space-2) var(--space-3);
    border: 1px solid color-mix(in oklab, var(--c-ink) 30%, transparent); border-radius: var(--radius-s); background: var(--c-surface);
  }
  .prose :global(.form textarea) { min-block-size: 7rem; resize: vertical; }
  .prose :global(.form button[disabled]) { opacity: 0.6; cursor: not-allowed; justify-self: start; }
</style>
