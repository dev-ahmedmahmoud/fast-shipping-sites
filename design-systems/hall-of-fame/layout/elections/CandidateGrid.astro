---
// The gallery wall: each candidate a portrait in a gilt frame hung on brass cords, lit by
// its own spotlight as it comes into view, the ballot number struck on a gold medal pinned
// to the frame, and the name engraved on a brass plate below.
// variant "strip": one gallery corridor that scrolls sideways (home, "the rest of the team");
// "groups": one wall per ballot group under its heading (the team page).
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { CandidateCard } from '@elections/data';
interface Props {
  ctx: PageContext;
  variant: 'strip' | 'groups';
  title?: string;
  lead?: string;
  groups: { label: string; candidates: CandidateCard[] }[];
  more?: { label: string; href: string } | null;
  /** Label of the card's profile link ("عرض الملف الشخصي"). */
  cardMore: string;
  /** "رقم", read before the number by screen readers. */
  numberLabel: string;
}
const { variant, title, lead, groups, more, cardMore, numberLabel } = Astro.props;
---
<section class:list={['section', 'gallery', variant]}>
  <div class="container wrap">
    {(title || lead) && (
      <header class="hof-head" data-hof-reveal>
        {title && <h2>{title}</h2>}
        <span class="hof-orn" aria-hidden="true"><i></i></span>
        {lead && <p class="hof-lead">{lead}</p>}
      </header>
    )}
    {groups.map((g) => (
      <div class="group">
        {g.label && (
          <div class="group-head" data-hof-reveal>
            <h2 class="group-title">{g.label}</h2>
            <span class="hof-orn" aria-hidden="true"><i></i></span>
          </div>
        )}
        <ul class="wall" role="list" tabindex={variant === 'strip' ? 0 : undefined} aria-label={variant === 'strip' ? (title ?? g.label) : undefined}>
          {g.candidates.map((c) => (
            <li>
              <a class="portrait" href={c.href} data-hof-lit>
                <span class="hang" aria-hidden="true"></span>
                <span class="hof-frame">
                  <span class="hof-frame__mat">
                    <Image class="photo" src={c.card} alt="" widths={[240, 400, 640]} sizes="(max-width: 600px) 64vw, 17rem" />
                    <span class="spot" aria-hidden="true"></span>
                  </span>
                  <span class="hof-medal" data-hof-medal><span class="sr-only">{numberLabel} </span><span>{c.number}</span></span>
                </span>
                <div class="hof-plate plate">
                  <h3>{c.name}</h3>
                  <span class="seat">{c.seat}</span>
                </div>
                <span class="more">{cardMore}<svg class="flip-rtl" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {more && <p class="all"><a class="btn btn--primary" href={more.href}>{more.label}</a></p>}
  </div>
</section>

<style>
  .wrap { display: flex; flex-direction: column; gap: var(--space-7); }
  /* A picture rail runs along the wall above the frames. */
  .gallery { background: linear-gradient(180deg, transparent 0, transparent calc(var(--space-8) + 3.5rem), color-mix(in oklab, var(--c-sunk) 60%, transparent) 100%); }
  .group { display: flex; flex-direction: column; gap: var(--space-5); }
  .group-head { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); }
  .group-title { font-size: var(--step-3); color: var(--c-accent); text-align: center; }

  .wall {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: var(--space-8) var(--space-6); padding-block-start: var(--space-6);
    border-block-start: 2px solid color-mix(in oklab, var(--hof-gold) 55%, transparent);
  }
  .strip .wall {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: var(--space-6);
    padding-block: var(--space-6) var(--space-5); padding-inline: var(--space-5); scrollbar-width: thin; scrollbar-color: var(--hof-gold) transparent;
    scroll-padding-inline: var(--space-5);
  }
  .strip .wall > li { flex: 0 0 min(16.5rem, 74%); scroll-snap-align: start; }
  .wall:focus-visible { outline-offset: 6px; }

  .portrait {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-4);
    color: var(--c-ink); text-decoration: none; block-size: 100%;
  }
  /* Two brass cords meeting at a hook above the frame. */
  .hang {
    position: absolute; inset-block-start: calc(-1 * var(--space-6) - 2px); inset-inline: 0; margin-inline: auto;
    inline-size: 52%; block-size: calc(var(--space-6) + 4px); pointer-events: none;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), var(--hof-gold-deep) calc(50% - 1px), var(--hof-gold-deep) calc(50% + 1px), transparent calc(50% + 1px)) 0 0 / 50% 100% no-repeat,
      linear-gradient(to top left, transparent calc(50% - 1px), var(--hof-gold-deep) calc(50% - 1px), var(--hof-gold-deep) calc(50% + 1px), transparent calc(50% + 1px)) 100% 0 / 50% 100% no-repeat;
  }
  .hang::before { content: ''; position: absolute; inset-block-start: -4px; inset-inline: 0; margin-inline: auto; inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--hof-brass); box-shadow: 0 1px 2px var(--c-ink); }
  .hof-frame { inline-size: 100%; transition: translate var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .hof-frame__mat { aspect-ratio: 4 / 5; }
  .portrait :global(.photo) {
    inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 8%;
    transition: filter 1.4s var(--ease-out), scale var(--dur-slow) var(--ease-out);
  }
  .spot {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(70% 55% at 50% 0%, color-mix(in oklab, var(--hof-gold-light) 34%, transparent), transparent 70%);
    mix-blend-mode: soft-light; opacity: 1; transition: opacity 1.4s var(--ease-out);
  }
  /* Below the fold the motion island dims each portrait, then lights it as it arrives. */
  :global(.hof-motion) .portrait:global(.is-dim) :global(.photo) { filter: brightness(0.55) saturate(0.7); }
  :global(.hof-motion) .portrait:global(.is-dim) .spot { opacity: 0; }
  .hof-medal { position: absolute; inset-block-start: -1.1rem; inset-inline-start: -1.1rem; --size: 4rem; z-index: 2; }
  .plate { inline-size: 92%; gap: 0.15rem; padding-block: var(--space-3); }
  h3 { font-size: var(--step-1); line-height: 1.35; }
  .seat { font-size: var(--step--1); font-weight: var(--weight-strong); line-height: 1.45; }
  .more {
    display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: 44px; margin-block-start: auto;
    color: var(--c-accent); font-weight: var(--weight-strong); font-size: var(--step--1);
    border-block-end: 1px solid transparent; transition: border-color var(--dur-fast) var(--ease-out);
  }
  .portrait:hover .hof-frame, .portrait:focus-visible .hof-frame { translate: 0 -4px; }
  .portrait:hover :global(.photo) { scale: 1.03; }
  .portrait:hover .more { border-block-end-color: currentColor; }
  .all { text-align: center; }
</style>
