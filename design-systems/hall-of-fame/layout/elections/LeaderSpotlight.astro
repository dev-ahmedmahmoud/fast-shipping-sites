---
// The grand portrait: the list's leader in a large gilt frame behind a velvet rope, lit
// by a stage light that comes up as the section arrives. The leader's word (a video) hangs in a
// smaller frame under the text.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
import type { VideoData } from '@elections/data';
import Video from '@elections/Video.astro';
interface Props {
  ctx: PageContext;
  kicker: string;
  name: string;
  text: string;
  more: { label: string; href: string };
  video: VideoData | null;
  photo: ImageMetadata;
}
const { kicker, name, text, more, video, photo } = Astro.props;
---
<section class="section hof-wall leader" id="leader" aria-labelledby="el-leader-title" data-hof-lit>
  <span class="stagelight" aria-hidden="true"></span>
  <div class="container grid">
    <div class="portrait">
      <figure class="hof-frame grand">
        <span class="hof-frame__mat">
          <Image src={photo} alt="" widths={[360, 560, 800]} sizes="(max-width: 900px) 78vw, 30rem" loading="lazy" />
        </span>
      </figure>
      <svg class="rope" viewBox="0 0 400 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="cord" d="M30 18 C 120 70, 280 70, 370 18" />
        <rect class="post" x="20" y="10" width="20" height="60" rx="3" />
        <rect class="post" x="360" y="10" width="20" height="60" rx="3" />
        <circle class="cap" cx="30" cy="10" r="11" /><circle class="cap" cx="370" cy="10" r="11" />
      </svg>
    </div>
    <div class="copy">
      <p class="hof-kicker">{kicker}</p>
      <h2 id="el-leader-title" data-split-words>{name}</h2>
      <span class="hof-orn" aria-hidden="true"><i></i></span>
      <p class="text">{text}</p>
      <a class="btn btn--primary" href={more.href}>{more.label}</a>
      {video && (
        <div class="word hof-frame" data-hof-reveal>
          <span class="hof-frame__mat"><Video video={video} showCaption sizes="(max-width: 900px) 92vw, 34rem" /></span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .leader { overflow: hidden; }
  .stagelight {
    position: absolute; inset-block-start: -40px; inset-inline-start: 4%; z-index: -1; inline-size: 48%; block-size: 120%;
    background: conic-gradient(from 180deg at 50% 0%, transparent 0deg 158deg, color-mix(in oklab, var(--hof-gold-light) 30%, transparent) 170deg 190deg, transparent 202deg 360deg);
    filter: blur(8px); opacity: 1; transition: opacity 1.6s var(--ease-out);
  }
  :global(.hof-motion) .leader:global(.is-dim) .stagelight { opacity: 0.15; }
  .grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: var(--space-8); align-items: center; }
  .portrait { position: relative; min-inline-size: 0; padding-block-end: var(--space-5); }
  .grand { inline-size: min(100%, 30rem); margin-inline: auto; }
  .grand .hof-frame__mat { aspect-ratio: 4 / 5; }
  .grand :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 12%; transition: filter 1.6s var(--ease-out); }
  :global(.hof-motion) .leader:global(.is-dim) .grand :global(img) { filter: brightness(0.62) saturate(0.85); }
  .rope { position: absolute; inset-inline: 2%; inset-block-end: 0; inline-size: 96%; block-size: 70px; overflow: visible; }
  .cord { fill: none; stroke: var(--c-accent); stroke-width: 9; stroke-linecap: round; filter: drop-shadow(0 4px 4px color-mix(in oklab, var(--c-ink) 60%, transparent)); }
  .post { fill: var(--hof-gold-deep); }
  .cap { fill: var(--hof-gold); stroke: var(--hof-gold-light); stroke-width: 2; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); min-inline-size: 0; }
  .copy .hof-orn { margin-inline: 0; inline-size: 10rem; }
  h2 { font-size: var(--step-5); color: var(--hof-on-wall); }
  .text { font-size: var(--step-1); line-height: 1.8; color: var(--hof-on-wall-muted); max-inline-size: 42ch; }
  .word { inline-size: 100%; margin-block-start: var(--space-4); padding: clamp(6px, 0.9vw, 10px); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .copy { align-items: center; text-align: center; }
    .copy .hof-orn { margin-inline: auto; }
  }
</style>
