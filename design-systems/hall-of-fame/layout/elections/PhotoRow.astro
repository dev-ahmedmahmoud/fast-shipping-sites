---
// A short corridor of framed portraits that scrolls sideways.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageContext } from '@engine/context';
interface Props { ctx: PageContext; photos: ImageMetadata[]; alt: string; label: string; hint?: string }
const { photos, alt, label, hint } = Astro.props;
---
<section class="section" aria-label={label}>
  <div class="container">
    <div class="row" tabindex="0" role="group" aria-label={hint ?? label}>
      {photos.map((p) => (
        <figure class="hof-frame" data-hof-lit>
          <span class="hof-frame__mat"><Image src={p} alt={alt} widths={[320, 560]} sizes="(max-width: 600px) 66vw, 19rem" /></span>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .row { display: flex; gap: var(--space-6); overflow-x: auto; scroll-snap-type: x mandatory; padding: var(--space-3) var(--space-2) var(--space-5); scrollbar-width: thin; scrollbar-color: var(--hof-gold) transparent; }
  .row:focus-visible { outline-offset: 4px; }
  figure { margin: 0; flex: 0 0 min(19rem, 66%); scroll-snap-align: start; }
  /* Centred while the row fits; once it overflows, auto margins collapse and it scrolls from the start. */
  figure:first-child { margin-inline-start: auto; }
  figure:last-child { margin-inline-end: auto; }
  .hof-frame__mat { aspect-ratio: 3 / 4; }
  figure :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 10%; transition: filter 1.4s var(--ease-out); }
  :global(.hof-motion) figure:global(.is-dim) :global(img) { filter: brightness(0.6) saturate(0.8); }
</style>
