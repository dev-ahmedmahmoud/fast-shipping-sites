---
// Short clips in slim gilt frames: on a programme file's page every speaker on that file
// (with a profile link); on a candidate's page their clips grouped by file (the group
// title links to the file).
import type { PageContext } from '@engine/context';
import type { Clip } from '@elections/data';
import Video from '@elections/Video.astro';
interface Props {
  ctx: PageContext;
  id?: string;
  title?: string;
  groups: { title?: string; href?: string; clips: Clip[] }[];
}
const { id, title, groups } = Astro.props;
// One clip per file (a candidate's page): the files themselves sit side by side.
const compact = groups.length > 1 && groups.every((g) => g.clips.length === 1);
---
<section class="section" id={id}>
  <div class:list={['container', 'wrap', { compact }]}>
    {title && (
      <header class="hof-head" data-hof-reveal>
        <h2>{title}</h2>
        <span class="hof-orn" aria-hidden="true"><i></i></span>
      </header>
    )}
    <div class="groups">
    {groups.map((g) => (
      <div class="group">
        {g.title && <h3 class="file">{g.href ? <a href={g.href}>{g.title}</a> : g.title}</h3>}
        <div class="grid">
          {g.clips.map((clip) => (
            <figure data-hof-reveal>
              <div class="hof-frame slim"><span class="hof-frame__mat"><Video video={clip.video} sizes="(max-width: 700px) 100vw, 33vw" widths={[384, 768, 1024]} /></span></div>
              <figcaption>
                {clip.name && <strong>{clip.name}</strong>}
                <span>{clip.title}</span>
                {clip.profile && <a href={clip.profile.href} aria-label={`${clip.profile.label}: ${clip.name}`}>{clip.profile.label}</a>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
    </div>
  </div>
</section>

<style>
  .wrap { display: flex; flex-direction: column; gap: var(--space-6); }
  .groups { display: flex; flex-direction: column; gap: var(--space-7); }
  .compact .groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--space-7) var(--space-6); }
  .compact .grid { grid-template-columns: minmax(0, 1fr); }
  .group { display: flex; flex-direction: column; gap: var(--space-4); }
  .file { font-size: var(--step-2); padding-block-end: var(--space-2); border-block-end: 1px solid color-mix(in oklab, var(--hof-gold) 50%, transparent); }
  .file a { color: var(--c-accent); text-decoration: none; }
  .file a:hover { text-decoration: underline; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: var(--space-6) var(--space-5); }
  figure { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .slim { padding: 6px; }
  figcaption { display: flex; flex-direction: column; gap: var(--space-1); line-height: 1.55; }
  figcaption strong { font-size: var(--step-1); font-family: var(--font-display); }
  figcaption a { display: inline-flex; align-items: center; min-block-size: 44px; align-self: flex-start; font-weight: var(--weight-strong); font-size: var(--step--1); }
</style>
